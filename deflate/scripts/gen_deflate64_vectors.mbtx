----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.6/crypto",
}
----

// From the repository root:
//   moon run deflate/scripts/gen_deflate64_vectors.mbtx [--check]
// Regenerates raw ZIP method 9 streams from single-member archives made by
// 7z, initially 26.04. ZIP timestamps/headers are excluded from the pins.
// --check regenerates and compares, skipping cleanly when 7z is unavailable.

///|
fn input(kind : String) -> Bytes {
  let text = b"Deflate64 extends the window for ZIP method 9.\n"
  match kind {
    "text" => Bytes::makei(12000, i => text[i % text.length()])
    "runs" => Bytes::make(140000, b'\x00')
    "far" => {
      let mut state = 9U
      let block = Bytes::makei(40000, _ => {
        state = state * 1664525U + 1013904223U
        (state >> 24).to_byte()
      })
      block + block + block
    }
    _ => {
      let mut state = 19U
      Bytes::makei(150000, i => {
        state = state * 1664525U + 1013904223U
        if i % 10000 < 1000 {
          (state >> 24).to_byte()
        } else {
          text[(i + i / 31) % text.length()]
        }
      })
    }
  }
}

///|
fn sha256(bytes : Bytes) -> String {
  @hex.encode(Bytes::from_array(@crypto.sha256(bytes)))
}

///|
fn le16(b : Bytes, p : Int32) -> Int32 {
  b[p].to_int() | (b[p + 1].to_int() << 8)
}

///|
fn le32(b : Bytes, p : Int32) -> Int32 {
  le16(b, p) | (le16(b, p + 2) << 16)
}

///|
// Sizes come from the central directory, so data-descriptor members work too.
// Only small, unencrypted, one-member archives created above are accepted.
fn raw_member(zip : Bytes, size : Int32) -> Bytes {
  let eocd = for p = zip.length() - 22; p >= 0; p = p - 1 {
    if le32(zip, p) == 0x06054b50 && p + 22 + le16(zip, p + 20) == zip.length() {
      break p
    }
  } nobreak {
    abort("7z ZIP has no end-of-central-directory record")
  }
  guard le16(zip, eocd + 10) == 1 else { abort("expected one ZIP member") }
  let cd = le32(zip, eocd + 16)
  guard le32(zip, cd) == 0x02014b50 &&
    le16(zip, cd + 10) == 9 &&
    (le16(zip, cd + 8) & 1) == 0 &&
    le32(zip, cd + 24) == size else {
    abort(
      "7z did not create an unencrypted Deflate64 member of the expected size",
    )
  }
  let local_pos = le32(zip, cd + 42)
  guard le32(zip, local_pos) == 0x04034b50 else {
    abort("invalid ZIP local header")
  }
  let start = local_pos +
    30 +
    le16(zip, local_pos + 26) +
    le16(zip, local_pos + 28)
  let compressed_size = le32(zip, cd + 20)
  guard compressed_size >= 0 && start >= 0 && compressed_size <= cd - start else {
    abort("ZIP member exceeds its archive")
  }
  zip.exact_view(start~, end=start + compressed_size).to_owned()
}

///|
async fn main {
  let available = @shell.Cmd("7z", []).output() catch {
    _ => {
      println("Deflate64 vectors: skipped (7z is not installed)")
      return
    }
  }
  available.check()
  let work = @fs.tmpdir(prefix="codecs-deflate64.")
  defer @fs.remove(work, recursive=true)
  let check = @env.args().contains("--check")
  let target = "deflate/src/deflate64/vectors_wbtest.mbt"
  let out = StringBuilder()
  out.write_string(
    "// Generated by deflate/scripts/gen_deflate64_vectors.mbtx, DON'T EDIT IT.\n// Raw ZIP method 9 members from 7z; first generated with 7-Zip 26.04.\n\n///|\nlet vectors : Array[Deflate64Vector] = [\n",
  )
  for kind in ["text", "runs", "far", "mixed"] {
    let bytes = input(kind)
    @fs.write_binary("\{work}/input.bin", bytes)
    let archive = "\{work}/output.zip"
    let result = @shell.Cmd(
      "7z",
      [
        "a", "-tzip", "-mm=Deflate64", "-mx=9", "-mmt=1", "-mtc=off", "-mta=off",
        "-mtm=off", archive, "input.bin",
      ],
      cwd=work,
    ).output()
    result.check()
    let raw = raw_member(@fs.read_binary(archive), bytes.length())
    // Validate the input with 7z too; a bad archive extraction fails here.
    let back = @shell.Cmd("7z", ["x", "-so", archive, "input.bin"]).output(
      max_output_bytes=1 << 20,
    )
    back.check()
    guard back.stdout_bytes() == bytes else { abort("7z round-trip failed") }
    @fs.remove(archive)
    let encoded = @base64.encode(raw)
    out.write_string(
      "  { name: \"\{kind}\", size: \{bytes.length()}, sha256: \"\{sha256(bytes)}\", stream_sha256: \"\{sha256(raw)}\", compressed: (\n",
    )
    for at = 0; at < encoded.length(); at = at + 76 {
      out.write_string("    #|\{encoded[at:(at + 76).min(encoded.length())]}\n")
    }
    out.write_string("  ) },\n")
  }
  out.write_string("]\n")
  let formatted = @shell.Cmd("moonfmt", ["-"], stdin=Text(out.to_string())).output()
  formatted.check()
  if check {
    guard @fs.exists(target) &&
      @fs.read_text(target) == formatted.stdout() else {
      abort(
        "\{target} is stale: run moon run deflate/scripts/gen_deflate64_vectors.mbtx",
      )
    }
    println(
      "Deflate64 vectors: four raw streams and SHA-256 pins agree with 7z",
    )
  } else {
    @fs.write_text(target, formatted.stdout())
    println("wrote \{target}: four 7z Deflate64 streams")
  }
}

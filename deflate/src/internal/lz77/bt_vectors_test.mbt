test "BtMatchfinder: exact match lists from libdeflate 1.24" {
  {
    let data = bt_oracle_input("text", 4096)
    assert_eq(bt_input_digest(data), 5520901375109455669UL)
    assert_eq(
      bt_match_digest(data, 1, 5, "all"),
      7559052429521220756UL,
      msg="text/1/5/all",
    )
    assert_eq(
      bt_match_digest(data, 1, 5, "level10"),
      10705643778450990422UL,
      msg="text/1/5/level10",
    )
    assert_eq(
      bt_match_digest(data, 35, 75, "all"),
      7559052429521220756UL,
      msg="text/35/75/all",
    )
    assert_eq(
      bt_match_digest(data, 35, 75, "level10"),
      10705643778450990422UL,
      msg="text/35/75/level10",
    )
    assert_eq(
      bt_match_digest(data, 100, 150, "all"),
      7559052429521220756UL,
      msg="text/100/150/all",
    )
    assert_eq(
      bt_match_digest(data, 100, 150, "level10"),
      10705643778450990422UL,
      msg="text/100/150/level10",
    )
    assert_eq(
      bt_match_digest(data, 300, 258, "all"),
      7559052429521220756UL,
      msg="text/300/258/all",
    )
    assert_eq(
      bt_match_digest(data, 300, 258, "level10"),
      10705643778450990422UL,
      msg="text/300/258/level10",
    )
  }
  {
    let data = bt_oracle_input("binary", 8192)

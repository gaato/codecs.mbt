    assert_eq(
      bt_match_digest(data, 100, 150, "all"),
      18200199783361181235UL,
      msg="binary/100/150/all",
    )
    assert_eq(
      bt_match_digest(data, 100, 150, "level10"),
      12207902515057212565UL,
      msg="binary/100/150/level10",
    )
    assert_eq(
      bt_match_digest(data, 300, 258, "all"),
      18200199783361181235UL,
      msg="binary/300/258/all",
    )
    assert_eq(
      bt_match_digest(data, 300, 258, "level10"),
      12207902515057212565UL,
      msg="binary/300/258/level10",
    )
  }
  {
    let data = bt_oracle_input("runs", 100000)
    assert_eq(bt_input_digest(data), 9280209351254558095UL)
    assert_eq(
      bt_match_digest(data, 1, 5, "all"),

// The arithmetic the bridges of shifts.mbt stand for.

// 2^k for 0 <= k <= 30, as a closed table: solvers see concrete values, where
// a recursive definition stays opaque and goals needing pow2(3) == 8 time
// out. Nested `else { if }` because the `.mbtp` parser rejects `else if`.
pub fn pow2(k : Int) -> Int {
  if k == 0 { 1 } else { if k == 1 { 2 } else { if k == 2 { 4 } else { if k == 3 { 8 } else { if k == 4 { 16 } else { if k == 5 { 32 } else { if k == 6 { 64 } else { if k == 7 { 128 } else { if k == 8 { 256 } else { if k == 9 { 512 } else { if k == 10 { 1024 } else { if k == 11 { 2048 } else { if k == 12 { 4096 } else { if k == 13 { 8192 } else { if k == 14 { 16384 } else { if k == 15 { 32768 } else { if k == 16 { 65536 } else { if k == 17 { 131072 } else { if k == 18 { 262144 } else { if k == 19 { 524288 } else { if k == 20 { 1048576 } else { if k == 21 { 2097152 } else { if k == 22 { 4194304 } else { if k == 23 { 8388608 } else { if k == 24 { 16777216 } else { if k == 25 { 33554432 } else { if k == 26 { 67108864 } else { if k == 27 { 134217728 } else { if k == 28 { 268435456 } else { if k == 29 { 536870912 } else { 1073741824 } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }
}

// The shift amounts the bridges take.
pub predicate shift_ok(k : Int) {
  0 <= k && k <= 30
}

pub predicate is_byte(b : Int) {
  0 <= b && b <= 255
}

// The table is the powers of two: each entry doubles the one before. `moon
// prove` checks these, so a wrong entry cannot make a bridge's contract claim
// more than the bridge computes.
lemma pow2_zero() where {
  proof_ensure: pow2(0) == 1,
} {
}

lemma pow2_step(k : Int) where {
  proof_require: 0 <= k,
  proof_require: k < 30,
  proof_ensure: pow2(k + 1) == 2 * pow2(k),
} {
}

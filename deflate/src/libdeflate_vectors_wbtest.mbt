test "raw output is byte-identical to the pinned libdeflate at levels 0 to 12" {
  {
    let input = @fixtures.sample(1951, 100000)
    assert_eq(
      @fixtures.sha256(input),
      "63d0adf7101c5775a1352817533550e929b1c4e86dca837b7d74e28d3266b2d5",
    )

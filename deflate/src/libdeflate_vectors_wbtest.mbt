      "82b3e3323e47c1da471b461587b3f33cd269c52cc3f4377be6b839129d2ecd9d", "daf292f98eec7855c1aa6929cfe0d2e2f8161add6f0c44dcf6289193f953086d",
      "8ee2c2ae9bfc0421c9ce16b1a4e70b87425ae748d1fdeb076dc2d7ce366f9a8f",
    ]
    for level in 0..<=12 {
      assert_eq(
        @fixtures.sha256(compress(input, level~)),
        expected[level],
        msg="sample/level \{level}",
      )
    }
  }
  {

// RFC 1952 section 2.3.1: a member starts with ID1 = 31 and ID2 = 139, CM = 8
// (DEFLATE), then FLG, whose bits 5 to 7 are reserved and must be zero.

predicate start_pre(id1 : Int, id2 : Int, cm : Int, flg : Int) {
  @proof_bits.is_byte(id1) &&
  @proof_bits.is_byte(id2) &&
  @proof_bits.is_byte(cm) &&
  @proof_bits.is_byte(flg)
}

// The checks in zlib's order: 0 when all pass.
fn spec_start_refusal(id1 : Int, id2 : Int, cm : Int, flg : Int) -> Int {
  if id1 != 31 || id2 != 139 { 1 } else { if cm != 8 { 2 } else { if flg >= 32 { 3 } else { 0 } } }
}

// Bit `k` of `flags`.
fn flag_bit(flags : Int, k : Int) -> Int {
  flags / @proof_bits.pow2(k) % 2
}

predicate next_field_pre(flags : Int, from : Int) {
  @proof_bits.is_byte(flags) && 0 <= from && from <= 4
}

// RFC 1952 section 2.3: after the fixed part come, each when its flag is
// set and in this order, FEXTRA (bit 2), FNAME (bit 3), FCOMMENT (bit 4)
// and FHCRC (bit 1); the first of them from `from` on, or 4 for the data.
fn spec_next_field(flags : Int, from : Int) -> Int {
  if from <= 0 && flag_bit(flags, 2) == 1 { 0 } else { if from <= 1 && flag_bit(flags, 3) == 1 { 1 } else { if from <= 2 && flag_bit(flags, 4) == 1 { 2 } else { if from <= 3 && flag_bit(flags, 1) == 1 { 3 } else { 4 } } } }
}

// Decodes broken PNG files with gaato/png and with typst's decode_png, and
// prints what each makes of them, for png/docs/robustness.md. Not a
// benchmark of the suite: its inputs are the caller's files.

import {
  "gaato/codec",
  "gaato/png",
  "gaato/codec_bench/png_corpus/damage",
  "moonbitlang/typst/codecs",
  "moonbitlang/core/debug",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
}

pkgtype(kind: "executable")

supported_targets = "native"

// Decodes one compressed file with one decoder and prints how much came out,
// how much of it came out before the last half of the input went in, and how
// long it took: an executable of its own, so that its peak memory can be
// measured without the build that `moon run` also counts
// (scripts/compare_codecs.mbtx stream and memory).

import {
  "gaato/codec_bench/compare",
  "gaato/codec_bench/compare_async",
  "moonbitlang/core/async",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/x/fs",
}

pkgtype(kind: "executable")

// `async fn main` here needs moonbitlang/core/async imported, because main
// awaits compare_async, which imports only core/async/io. MoonBit 0.10.22
// still reports the import as unused (0.10.21 did not).

warnings = "-unused_package"

supported_targets = "native"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)

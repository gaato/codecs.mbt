// Runs one decoder over the cases scripts/compare_codecs.mbtx writes, and
// says for each whether the decoder agrees with the reference: an executable
// of its own, so that a decoder that aborts or hangs costs one case, not the
// run (the script resumes after it).

import {
  "gaato/codec_bench/compare",
  "gaato/codec_bench/compare_async",
  "gaato/codec_harness",
  "moonbitlang/core/async",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/x/fs",
}

pkgtype(kind: "executable")

// `async fn main` here needs moonbitlang/core/async imported, because main
// awaits compare_async, which imports only core/async/io. MoonBit 0.10.22
// still reports the import as unused (0.10.21 did not).

warnings = "-unused_package"

supported_targets = "native"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)

// DO NOT EDIT: generated by brotli/scripts/reference/gen_hq_vectors.mbtx.
// SHA-256 of google/brotli 1.2.1 CLI outputs with explicit window and size hint modes.
// Large byte oracles run once in native conformance; the codec keeps small
// pins and boundary tests for every target and its coverage ledger.

///|
using @brotli {type Encoder, type EncodeAction, compress, decompress}

///|
fn ref_quality_sample(kind : Int32, size : Int32) -> Bytes {
  if kind == 3 {
    let words = [
      b"The ", b"compression ", b"dictionary ", b"representation ", b"the ", b"a ",
      b"window ", b"\n", b"{\"key\": [1, 2]} ", b"\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e ",
      b"\xc3\xa9\xc3\xa0\xc3\xa8 ",
    ]
    let out = Buffer()
    let mut rng = 1951U
    while out.length() < size {
      rng = rng * 1664525U + 1013904223U
      out.write_bytes(words[(rng >> 8).reinterpret_as_int() % words.length()])
    }
    return out.to_bytes()[:size].to_owned()
  }
  let text = b"hello hello hello, reference Brotli static dictionary compression\n"
  let mut state = 1951U
  let data = FixedArray::make(size, b'\x00')
  for i in 0..<size {
    state = state * 1664525U + 1013904223U
    data[i] = if kind == 0 {
      text[i % text.length()]
    } else if kind == 1 {
      (state >> 24).to_byte()
    } else if kind == 4 {
      (((state >> 24) & 31U).reinterpret_as_int() + 32 * ((i / 1024) & 7)).to_byte()
    } else if i % 10000 < 6000 {
      text[i % text.length()]
    } else if i >= 4096 && i % 10000 < 8000 {
      data[i - 4096]
    } else {
      (state >> 24).to_byte()
    }
  }
  Bytes::from_array(data)
}

///|
fn encode_drive(
  encoder : Encoder,
  input : BytesView,
  next_in~ : () -> Int32,
  next_out~ : () -> Int32,
  flush~ : (Int32) -> Bool = _ => false,
  fixed~ : Bool = true,
  check~ : (Encoder, Int32) -> Unit raise = (_, _) => (),
  on_flush~ : (Int32, Bytes) -> Unit raise = (_, _) => (),
) -> Bytes raise {
  let out = Buffer()
  let mut pos = 0
  let mut buffer = FixedArray::make(0, b'\x00')
  for ;; {
    let end = (pos + next_in()).min(input.length())
    let action : EncodeAction = if end == input.length() {
      Finish
    } else if flush(end) {
      Flush
    } else {
      Continue
    }
    let mut rest = input[pos:end]
    for ;; {
      let room = next_out()
      if buffer.length() != room {
        buffer = FixedArray::make(room, b'\x00')
      }
      let status = if fixed {
        encoder.step_into(rest, buffer, action~)
      } else {
        encoder.step(rest, buffer.mut_view(), action~)
      }
      check(encoder, room)
      assert_true(encoder.last_produced() <= room)
      rest = rest[encoder.last_consumed():]
      out.write_bytesview(
        Bytes::from_array(buffer[:encoder.last_produced()])[:],
      )
      match status {
        Done => {
          assert_eq(rest.length(), 0)
          assert_true(encoder.is_finished())
          return out.to_bytes()
        }
        NeedMoreInput => {
          assert_eq(rest.length(), 0)
          break
        }
        NeedMoreOutput =>
          if encoder.last_consumed() == 0 && encoder.last_produced() == 0 {
            fail("no progress")
          }
      }
    }
    if action is Flush {
      on_flush(end, out.to_bytes())
    }
    pos = end
  }
}

///|
#cfg(target="native")
test "HQ CLI bytes: kind0/size70000/w10" {
  let input = ref_quality_sample(0, 70000)
  assert_eq(
    @checksum.sha256(input),
    "5ac62499557efc9fba8944fe9173f4bf7d7bd436ab47869ceb4e858bf92e6502",
  )
  let expected = [
    (
      "a3b9a841e9f8c06ec91a69ff13c42d0bdc72237bd78880d59413f56630fe6568", "a3b9a841e9f8c06ec91a69ff13c42d0bdc72237bd78880d59413f56630fe6568",
    ),
    (
      "a3b9a841e9f8c06ec91a69ff13c42d0bdc72237bd78880d59413f56630fe6568", "a3b9a841e9f8c06ec91a69ff13c42d0bdc72237bd78880d59413f56630fe6568",
    ),
  ]
  for quality in 10..<=11 {
    let (named, stdin) = expected[quality - 10]
    let encoded = compress(input, quality~, window_bits=10)
    assert_eq(
      @checksum.sha256(encoded),
      named,
      msg="kind0/size70000/w10/named/q\{quality}",
    )
    assert_eq(decompress(encoded), input)
    let unknown = encode_drive(
      @brotli.Encoder(quality~, window_bits=10),
      input,
      next_in=() => 7919,
      next_out=() => 4096,
    )
    assert_eq(
      @checksum.sha256(unknown),
      stdin,
      msg="kind0/size70000/w10/stdin/q\{quality}",
    )
  }
}


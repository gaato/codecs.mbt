----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.6/crypto",
}
----

// Generates lzw/src/vectors_wbtest.mbt: what weezl (scripts/reference,
// image-rs's LZW, pinned by its Cargo.lock) writes for the inputs of
// src/internal/crosscheck as GIF of minimum code sizes 2, 4 and 8, TIFF and
// PDF's EarlyChange 0, and what compress (ncompress 5.0) writes as .Z of 16,
// 12 and 10 bits, each with the length and SHA-256 of its input, for the
// decoder's tests to decode on every target. The large and the random
// inputs come only in the sets they are there for (the table filling and
// clearing, stored codes), to keep the file small; .Z without block mode
// has no writer to take it from, and is checked by the crosscheck alone.
//
// Usage, from the repository root (needs cargo, compress, and moonfmt,
// which comes with moon):
//   moon run lzw/scripts/gen_vectors.mbtx [--check]
// --check asks the references again and fails unless the file holds
// exactly what this script writes.

///|
let target : String = "lzw/src/vectors_wbtest.mbt"

///|
/// Whether input `name` comes in set `set`.
fn wanted(name : String, set : String) -> Bool {
  match name {
    "random_70000" => set == "z16" || set == "tiff"
    "text_300000" => set == "z10" || set == "gif-8"
    _ => set != "znb"
  }
}

///|
fn[T] setup_failure(message : String) -> T {
  eprintln(message)
  @env.exit(2)
}

///|
fn sha256_hex(data : Bytes) -> String {
  @hex.encode(Bytes::from_array(@crypto.sha256(data)))
}

///|
async fn main {
  let check = @env.args().contains("--check")
  let env = if @env.get_env_var("MOON_CC") is None {
    { "MOON_CC": "cc" }
  } else {
    {}
  }
  let run = @shell.Cmd(
    "moon",
    ["run", "--release", "--target", "native", "src/internal/crosscheck"],
    cwd="lzw",
    env~,
  ).output(max_output_bytes=1 << 30)
  if run.exit_code() != 0 {
    setup_failure(run.stderr())
  }
  let names = []
  let sets = []
  let inputs : Array[Bytes] = []
  for line in run.stdout().split("\n") {
    guard line.split("\t").collect() is [name, set, input, _] else {
      continue
    }
    guard wanted(name.to_string(), set.to_string()) else { continue }
    names.push(name.to_string())
    sets.push(set.to_string())
    inputs.push(@base64.decode(input))
  }
  // weezl's streams in one run of the reference; compress's one at a time.
  let lines = StringBuilder()
  let weezl_index : Map[Int, Int] = Map([])
  for i, set in sets {
    if !set.has_prefix("z") {
      weezl_index[i] = weezl_index.length()
      lines.write_string("lzw-encode:\{set}\t\{@base64.encode(inputs[i])}\n")
    }
  }
  let reference = @shell.Cmd(
    "cargo",
    [
      "run", "--quiet", "--release", "--locked", "--manifest-path", "scripts/reference/Cargo.toml",
    ],
    stdin=Text(lines.to_string()),
  ).output(max_output_bytes=1 << 30)
  if reference.exit_code() != 0 {
    setup_failure("scripts/reference: \{reference.stderr()}")
  }
  let weezl = reference.stdout().split("\n").collect()
  let answers = []
  for i, set in sets {
    if weezl_index.get(i) is Some(k) {
      answers.push(weezl[k].to_string())
      continue
    }
    let bits = match set {
      "z12" => "12"
      "z10" => "10"
      _ => "16"
    }
    // -f: write it even when it does not save anything.
    let z = @shell.Cmd("compress", ["-c", "-f", "-b", bits], stdin=Binary(inputs[i])).output(
      max_output_bytes=1 << 30,
    )
    if z.exit_code() != 0 {
      setup_failure("compress: \{z.stderr()}")
    }
    answers.push(@base64.encode(z.stdout_bytes()))
  }
  let out = StringBuilder()
  out.write_string(
    (
      $|// Generated by lzw/scripts/gen_vectors.mbtx, DON'T EDIT IT.
      $|// What weezl and compress write for src/internal/crosscheck's inputs.
      $|
      $|///|
      $|let vectors : Array[Vector] = [
      $|
    ),
  )
  for i, name in names {
    // The base64 in lines of 76: MoonBit refuses a longer text segment.
    out.write_string(
      "  {\n    name: \"\{name}\",\n    set: \"\{sets[i]}\",\n    size: \{inputs[i].length()},\n    sha256: \"\{sha256_hex(inputs[i])}\",\n    stream: (\n",
    )
    let b64 = answers[i]
    for at = 0; at < b64.length().max(1); at = at + 76 {
      let line = b64.clamped_view(start=at, end=(at + 76).min(b64.length()))
      out.write_string("      #|\{line}\n")
    }
    out.write_string("    ),\n  },\n")
  }
  out.write_string("]\n")
  let fmt = @shell.Cmd("moonfmt", ["-"], stdin=Text(out.to_string())).output(
    max_output_bytes=1 << 28,
  )
  fmt.check()
  let text = fmt.stdout()
  if check {
    guard @fs.exists(target) && @fs.read_text(target) == text else {
      setup_failure(
        "\{target} is stale: run moon run lzw/scripts/gen_vectors.mbtx",
      )
    }
    println("\{target}: \{names.length()} streams, as weezl and compress write them")
  } else {
    @fs.write_text(target, text)
    println("wrote \{target}: \{names.length()} streams")
  }
}

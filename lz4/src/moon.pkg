import {
  "gaato/codec",
  "gaato/codec_bytes",
  "gaato/lz4/internal/blit",
  "gaato/lz4/internal/copy16",
  "moonbitlang/core/debug",
  "gaato/lz4/internal/whole",
}

import {
  "gaato/lz4/internal/checksum",
  "moonbitlang/core/encoding/base64",
} for "wbtest"

supported_targets = "js + native + wasm + wasm-gc"

options(
  targets: {
    "xxh32_bulk.mbt": [ "native", "wasm", "wasm-gc" ],
    "xxh32_js.mbt": [ "js" ],
  },
)

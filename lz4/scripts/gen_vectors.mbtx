----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.6/crypto",
}
----

// Generates lz4/src/vectors_wbtest.mbt: what lz4 1.10.0's C library (the
// one `lz4` is built on, vendored by the lz4-sys crate in scripts/reference
// and pinned by its Cargo.lock, so that the vectors do not depend on the
// lz4 command a machine has) writes for the inputs of src/internal/
// crosscheck, in each of its sets: frames of independent and of linked
// blocks, of 64 KiB, 256 KiB and 4 MiB, with block checksums and the content
// size, in a fast mode, with a dictionary; blocks on their own, with and
// without one; and legacy frames. Each comes with the length and SHA-256 of
// its input, for the decoder's tests to decode on every target, and for the
// encoder's to match where its options are lz4's.
//
// Usage, from the repository root (needs cargo, a C compiler for lz4-sys,
// and moonfmt, which comes with moon):
//   moon run lz4/scripts/gen_vectors.mbtx [--check]
// --check asks lz4 again and fails unless the file holds exactly what this
// script writes.

///|
let target : String = "lz4/src/vectors_wbtest.mbt"

///|
/// The reference's format for each set: lz4's options, the same as the
/// set's in src/internal/crosscheck, and whether the dictionary goes with
/// it.
fn reference_format(set : String) -> (String, Bool) {
  let frame = (options : String) => "lz4f-encode:\{options},bc=0,level=1"
  match set {
    "b4i" => (frame("bs=4,indep=1,cc=1,cs=0,dictid=0"), false)
    "b4d" => (frame("bs=4,indep=0,cc=1,cs=0,dictid=0"), false)
    "b7i" => (frame("bs=7,indep=1,cc=1,cs=0,dictid=0"), false)
    "b5ix" => ("lz4f-encode:bs=5,indep=1,cc=1,bc=1,cs=1,level=1,dictid=0", false)
    "fast9" => ("lz4f-encode:bs=4,indep=1,cc=0,bc=0,cs=0,level=-8,dictid=0", false)
    "b4i_dict" => (frame("bs=4,indep=1,cc=1,cs=0,dictid=7"), true)
    "b4d_dict" => (frame("bs=4,indep=0,cc=1,cs=0,dictid=0"), true)
    "block" => ("lz4-block-encode:1", false)
    "block_dict" => ("lz4-block-encode:1", true)
    "legacy" => ("lz4-legacy-encode", false)
    _ => setup_failure("unknown set \{set}")
  }
}

///|
fn[T] setup_failure(message : String) -> T {
  eprintln(message)
  @env.exit(2)
}

///|
fn sha256_hex(data : Bytes) -> String {
  @hex.encode(Bytes::from_array(@crypto.sha256(data)))
}

///|
async fn main {
  let check = @env.args().contains("--check")
  let env = if @env.get_env_var("MOON_CC") is None {
    { "MOON_CC": "cc" }
  } else {
    {}
  }
  let run = @shell.Cmd(
    "moon",
    ["run", "--release", "--target", "native", "src/internal/crosscheck"],
    cwd="lz4",
    env~,
  ).output(max_output_bytes=1 << 30)
  if run.exit_code() != 0 {
    setup_failure(run.stderr())
  }
  let names = []
  let sets = []
  let inputs : Array[Bytes] = []
  let lines = StringBuilder()
  let mut dict = ""
  for line in run.stdout().split("\n") {
    guard line.split("\t").collect() is [name, set, input, _] else {
      continue
    }
    if name == "dictionary" {
      dict = input.to_string()
      continue
    }
    guard set != "flushed" else { continue }
    names.push(name.to_string())
    sets.push(set.to_string())
    inputs.push(@base64.decode(input))
    let (format, with_dict) = reference_format(set.to_string())
    if with_dict {
      lines.write_string("\{format}\t\{input}\t\{dict}\n")
    } else {
      lines.write_string("\{format}\t\{input}\n")
    }
  }
  let reference = @shell.Cmd(
    "cargo",
    [
      "run", "--quiet", "--release", "--locked", "--manifest-path", "scripts/reference/Cargo.toml",
    ],
    stdin=Text(lines.to_string()),
  ).output(max_output_bytes=1 << 30)
  if reference.exit_code() != 0 {
    setup_failure("scripts/reference: \{reference.stderr()}")
  }
  let answers = reference.stdout().split("\n").collect()
  let out = StringBuilder()
  let dict_digest = sha256_hex(@base64.decode(dict))
  out.write_string(
    (
      $|// Generated by lz4/scripts/gen_vectors.mbtx, DON'T EDIT IT.
      $|// What lz4 1.10.0's library writes for src/internal/crosscheck's
      $|// inputs, in each set.
      $|
      $|///|
      $|/// The SHA-256 of the dictionary of the dictionary sets.
      $|let dictionary_sha256 : String = "\{dict_digest}"
      $|
      $|///|
      $|let vectors : Array[Vector] = [
      $|
    ),
  )
  for i, name in names {
    // The base64 in lines of 76: MoonBit refuses a longer text segment.
    out.write_string(
      "  {\n    name: \"\{name}\",\n    set: \"\{sets[i]}\",\n    size: \{inputs[i].length()},\n    sha256: \"\{sha256_hex(inputs[i])}\",\n    stream: (\n",
    )
    let b64 = answers[i]
    for at = 0; at < b64.length().max(1); at = at + 76 {
      let line = b64.clamped_view(start=at, end=(at + 76).min(b64.length()))
      out.write_string("      #|\{line}\n")
    }
    out.write_string("    ),\n  },\n")
  }
  out.write_string("]\n")
  let fmt = @shell.Cmd("moonfmt", ["-"], stdin=Text(out.to_string())).output(
    max_output_bytes=1 << 28,
  )
  fmt.check()
  let text = fmt.stdout()
  if check {
    guard @fs.exists(target) && @fs.read_text(target) == text else {
      setup_failure(
        "\{target} is stale: run moon run lz4/scripts/gen_vectors.mbtx",
      )
    }
    println("\{target}: \{names.length()} streams, as lz4 writes them")
  } else {
    @fs.write_text(target, text)
    println("wrote \{target}: \{names.length()} streams")
  }
}

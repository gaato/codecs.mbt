----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.6/crypto",
}
----

// Generates snappy/src/vectors_wbtest.mbt: what the reference, the snap
// crate (scripts/reference, versions pinned by its Cargo.lock), writes for
// the inputs of src/internal/crosscheck, in the raw and the framing format,
// each with the length and SHA-256 of its input, for the decoder's tests to
// decode on every target.
//
// Usage, from the repository root (needs cargo and moonfmt, which comes with
// moon):
//   moon run snappy/scripts/gen_vectors.mbtx [--check]
// --check asks snap again and fails unless the file holds exactly what this
// script writes.

///|
let target : String = "snappy/src/vectors_wbtest.mbt"

///|
fn[T] setup_failure(message : String) -> T {
  eprintln(message)
  @env.exit(2)
}

///|
async fn main {
  let check = @env.args().contains("--check")
  let env = if @env.get_env_var("MOON_CC") is None {
    { "MOON_CC": "cc" }
  } else {
    {}
  }
  let run = @shell.Cmd(
    "moon",
    ["run", "--release", "--target", "native", "src/internal/crosscheck"],
    cwd="snappy",
    env~,
  ).output(max_output_bytes=1 << 30)
  if run.exit_code() != 0 {
    setup_failure(run.stderr())
  }
  let names = []
  let formats = []
  let inputs : Array[Bytes] = []
  let lines = StringBuilder()
  for line in run.stdout().split("\n") {
    guard line.split("\t").collect() is [name, format, input, _] else {
      continue
    }
    guard !name.has_suffix("_flushed") else { continue }
    names.push(name.to_string())
    formats.push(format.to_string())
    inputs.push(@base64.decode(input))
    lines.write_string("\{format}-encode\t\{input}\n")
  }
  let reference = @shell.Cmd(
    "cargo",
    [
      "run", "--quiet", "--release", "--locked", "--manifest-path", "scripts/reference/Cargo.toml",
    ],
    stdin=Text(lines.to_string()),
  ).output(max_output_bytes=1 << 30)
  if reference.exit_code() != 0 {
    setup_failure("scripts/reference: \{reference.stderr()}")
  }
  let answers = reference.stdout().split("\n").collect()
  let out = StringBuilder()
  out.write_string(
    (
      $|// Generated by snappy/scripts/gen_vectors.mbtx, DON'T EDIT IT.
      $|// What snap writes for src/internal/crosscheck's inputs.
      $|
      $|///|
      $|let vectors : Array[Vector] = [
      $|
    ),
  )
  for i, name in names {
    let digest = @hex.encode(Bytes::from_array(@crypto.sha256(inputs[i])))
    // The base64 in lines of 76: MoonBit refuses a longer text segment.
    out.write_string(
      "  {\n    name: \"\{name}\",\n    format: \"\{formats[i]}\",\n    size: \{inputs[i].length()},\n    sha256: \"\{digest}\",\n    stream: (\n",
    )
    let b64 = answers[i]
    for at = 0; at < b64.length().max(1); at = at + 76 {
      let line = b64.clamped_view(start=at, end=(at + 76).min(b64.length()))
      out.write_string("      #|\{line}\n")
    }
    out.write_string("    ),\n  },\n")
  }
  out.write_string("]\n")
  let fmt = @shell.Cmd("moonfmt", ["-"], stdin=Text(out.to_string())).output(
    max_output_bytes=1 << 28,
  )
  fmt.check()
  let text = fmt.stdout()
  if check {
    guard @fs.exists(target) && @fs.read_text(target) == text else {
      setup_failure("\{target} is stale: run moon run snappy/scripts/gen_vectors.mbtx")
    }
    println("\{target}: \{names.length()} streams, as snap writes them")
  } else {
    @fs.write_text(target, text)
    println("wrote \{target}: \{names.length()} streams")
  }
}

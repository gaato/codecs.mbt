// lengths of at most 11 bits, the tree description, and literal streams.

import {
  "gaato/zstd/internal/bits",
  "gaato/zstd/internal/fse",
  "gaato/zstd/internal/huffman_code",
}

supported_targets = "js + native + wasm + wasm-gc"

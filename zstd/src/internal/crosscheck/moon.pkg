// Prints frames made by the encoder, for scripts/crosscheck.mbtx to decode
// with the reference decoders. Not part of the library.

import {
  "gaato/zstd/internal/seqcases",
  "gaato/zstd",
  "gaato/zstd/internal/checksum",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/env",
}

pkgtype(kind: "executable")

supported_targets = "js + native + wasm + wasm-gc"

// The Literals_Section_Header as RFC 8878 section 3.1.1.3.1.1 describes it
// (with erratum 7297), read from the bytes as one little-endian number with
// integer arithmetic only. The implementation in literals_header.mbt reads
// the fields byte by byte with bit operations; its contract says it agrees
// with these definitions.

predicate lit_header_pre(b0 : Int, b1 : Int, b2 : Int, b3 : Int, b4 : Int) {
  @proof_bits.is_byte(b0) &&
  @proof_bits.is_byte(b1) &&
  @proof_bits.is_byte(b2) &&
  @proof_bits.is_byte(b3) &&
  @proof_bits.is_byte(b4)
}

// Literals_Block_Type and Size_Format, the low four bits of the first byte.
fn lit_type(b0 : Int) -> Int {
  b0 % 4
}

fn lit_format(b0 : Int) -> Int {
  b0 / 4 % 4
}

// The header's length in bytes, from Literals_Block_Type and Size_Format.
fn lit_header_len(b0 : Int) -> Int {
  if lit_type(b0) < 2 { if lit_format(b0) == 1 { 2 } else { if lit_format(b0) == 3 { 3 } else { 1 } } } else { if lit_format(b0) == 2 { 4 } else { if lit_format(b0) == 3 { 5 } else { 3 } } }
}

// The width in bits of Regenerated_Size (and of Compressed_Size, for
// compressed and treeless literals).
fn lit_width(b0 : Int) -> Int {
  if lit_type(b0) < 2 { if lit_format(b0) == 1 { 12 } else { if lit_format(b0) == 3 { 20 } else { 5 } } } else { if lit_format(b0) == 2 { 14 } else { if lit_format(b0) == 3 { 18 } else { 10 } } }
}

// The header bytes as one little-endian number. Bytes past the header are
// included, but never reach a field.
fn lit_le(b0 : Int, b1 : Int, b2 : Int, b3 : Int, b4 : Int) -> Int {
  b0 + 256 * b1 + 65536 * b2 + 16777216 * b3 + 65536 * 65536 * b4
}

// 2^(bits before Regenerated_Size): 3 for Size_Format 0 and 2 of raw and RLE
// literals, else 4.
fn lit_regen_shift(b0 : Int) -> Int {
  if lit_type(b0) < 2 && lit_format(b0) % 2 == 0 {
    8
  } else {
    16
  }
}

fn lit_regenerated(b0 : Int, b1 : Int, b2 : Int, b3 : Int, b4 : Int) -> Int {
  lit_le(b0, b1, b2, b3, b4) / lit_regen_shift(b0) % @proof_bits.pow2(lit_width(b0))
}

// Compressed_Size follows Regenerated_Size.
fn lit_compressed_field(b0 : Int, b1 : Int, b2 : Int, b3 : Int, b4 : Int) -> Int {
  lit_le(b0, b1, b2, b3, b4) / (16 * @proof_bits.pow2(lit_width(b0))) % @proof_bits.pow2(lit_width(b0))
}

// The bytes the section takes after its header: Regenerated_Size for raw
// literals, 1 for RLE, Compressed_Size for compressed and treeless.
fn lit_payload(b0 : Int, b1 : Int, b2 : Int, b3 : Int, b4 : Int) -> Int {
  if lit_type(b0) == 0 { lit_regenerated(b0, b1, b2, b3, b4) } else { if lit_type(b0) == 1 { 1 } else { lit_compressed_field(b0, b1, b2, b3, b4) } }
}

// Whether the section has four Huffman streams.
predicate lit_four_streams(b0 : Int) {
  lit_type(b0) >= 2 && lit_format(b0) != 0
}

// The decoder's checks, in its order: the header fits the block; no more
// literals than the block limit; four streams have at least 6 literals
// (erratum 7297); the section fits the block. 0 when all pass.
fn lit_refusal(
  b0 : Int,
  b1 : Int,
  b2 : Int,
  b3 : Int,
  b4 : Int,
  avail : Int,
  block_max : Int,
) -> Int {
  if avail < lit_header_len(b0) { 1 } else { if lit_regenerated(b0, b1, b2, b3, b4) > block_max { 2 } else { if lit_four_streams(b0) && lit_regenerated(b0, b1, b2, b3, b4) < 6 { 3 } else { if lit_header_len(b0) + lit_payload(b0, b1, b2, b3, b4) > avail { 4 } else { 0 } } } }
}

predicate lit_type_is(t : LiteralsType, code : Int) {
  match t {
    RawLiterals => code == 0
    RleLiterals => code == 1
    CompressedLiterals => code == 2
    TreelessLiterals => code == 3
  }
}

// Erratum 7297: with four streams, each of the first three regenerates
// ceil(Regenerated_Size / 4) literals, and the last what remains, which is
// then not negative.
predicate lit_streams_fit(h : LiteralsHeader) {
  lit_type_four(h) → h.regenerated - 3 * ((h.regenerated + 3) / 4) >= 0
}

predicate lit_type_four(h : LiteralsHeader) {
  match h.block_type {
    RawLiterals => false
    RleLiterals => false
    CompressedLiterals => h.size_format != 0
    TreelessLiterals => h.size_format != 0
  }
}

// The ranges of an accepted header.
predicate lit_header_shape(h : LiteralsHeader, avail : Int, block_max : Int) {
  0 <= h.size_format && h.size_format <= 3 &&
  1 <= h.header_len && h.header_len <= 5 &&
  0 <= h.regenerated && h.regenerated <= block_max &&
  h.regenerated < 1048576 &&
  0 <= h.compressed && h.compressed < 1048576 &&
  h.header_len + h.compressed <= avail &&
  lit_streams_fit(h)
}

predicate lit_header_post(
  b0 : Int,
  b1 : Int,
  b2 : Int,
  b3 : Int,
  b4 : Int,
  avail : Int,
  block_max : Int,
  r : LiteralsParse,
) {
  match r {
    Refused(code) =>
      code == lit_refusal(b0, b1, b2, b3, b4, avail, block_max) && code != 0
    Parsed(h) =>
      lit_refusal(b0, b1, b2, b3, b4, avail, block_max) == 0 &&
      lit_type_is(h.block_type, lit_type(b0)) &&
      h.size_format == lit_format(b0) &&
      h.header_len == lit_header_len(b0) &&
      h.regenerated == lit_regenerated(b0, b1, b2, b3, b4) &&
      h.compressed == lit_payload(b0, b1, b2, b3, b4) &&
      lit_header_shape(h, avail, block_max)
  }
}

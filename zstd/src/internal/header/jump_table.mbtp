// RFC 8878 section 3.1.1.3.1.6: a 6-byte jump table of three 2-byte stream
// sizes, the fourth stream taking the rest; each stream holds at least one
// byte, so the jump table and the streams take at least 10 bytes.
predicate jump_table_pre(total : Int, size1 : Int, size2 : Int, size3 : Int) {
  0 <= total &&
  0 <= size1 && size1 <= 65535 &&
  0 <= size2 && size2 <= 65535 &&
  0 <= size3 && size3 <= 65535
}

predicate jump_table_post(
  total : Int,
  size1 : Int,
  size2 : Int,
  size3 : Int,
  r : Option[Int],
) {
  match r {
    None => total < 10 || total - 6 - size1 - size2 - size3 < 1
    Some(size4) =>
      10 <= total &&
      1 <= size4 &&
      6 + size1 + size2 + size3 + size4 == total
  }
}

----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

// Runs the repository validation suite.
//
// Usage, from the repository root:
//   moon run scripts/gates.mbtx -- [--only PART] [--no-js] [--no-wasm] [--no-prove] [--second-solver] [--full]
//
// PART is checks, test-native, test-js, test-wasm, test-wasm-gc, coverage,
// crosscheck, prove or fmt. CI runs these independently to keep wall time
// bounded by the longest part. Without --only the local sequence is unchanged.
//
// The complete sequence checks the coverage ledgers (scripts/coverage_report.mbtx):
// a gap a test should close fails here as it fails in CI. --full also runs
// the crosschecks of the encoders against the reference decoders (zstd,
// brotli, deflate, snappy, lz4 and lzw's scripts/crosscheck.mbtx), as CI's crosscheck part does;
// they take some minutes, so a quick local run leaves them out. Selecting
// --only crosscheck requests them directly, without also needing --full.
//
// --no-prove skips `moon prove` (for a machine without Z3 4.16.0); the proof
// ledgers are still checked against the code. --second-solver proves again
// with CVC5 1.4.2 after Z3 (see scripts/prove.mbtx).
//
// Each step is echoed as "+ <command>" and streams its output as it runs; the
// first failing step ends the suite with that step's exit status.

///|
/// Prints `message` on stderr and exits with `code`.
fn[T] die(code : Int32, message : String) -> T {
  eprintln(message)
  @env.exit(code)
}

///|
/// Echoes and runs `program args`, exiting with its status if it fails.
async fn run(
  program : String,
  args : Array[String],
  env~ : Map[String, String] = Map([]),
) -> Unit {
  println("+ \{[program, ..args].join(" ")}")
  let code = @shell.Cmd(program, args, env~).status()
  if code != 0 {
    @env.exit(code)
  }
}

///|
/// The ledgered modules of scripts/modules.json.
async fn ledgered() -> Array[String] {
  let path = "scripts/modules.json"
  guard @fs.exists(path) else {
    die(2, "no \{path}: run from the repository root")
  }
  let config = @json.parse(@fs.read_text(path))
  guard config is { "ledgered": Array(list), .. } else {
    die(2, "\{path} has no \"ledgered\" list")
  }
  list.filter_map(m => if m is String(m) { Some(m) } else { None })
}

///|
/// Selects a part, or the complete legacy sequence when no part was requested.
fn selected(only : String?, part : String) -> Bool {
  only is None || only == Some(part)
}

///|
/// Checks source scripts, excluding dependency, build and VCS directories,
/// so copied scripts cannot reintroduce the unstable registry async API.
async fn check_script_imports() -> Unit {
  let skipped = [
    "_build", "target", ".mooncakes", ".moonagent", ".repos", ".venv",
    "__pycache__", "node_modules", ".git", ".jj",
  ]
  let paths : Array[String] = []
  @fs.walk(
    ".",
    (dir, entries) => {
      for entry in entries {
        if entry.has_suffix(".mbtx") {
          paths.push("\{dir}/\{entry}")
        }
      }
    },
    exclude=path => skipped.iter().any(name => path.has_suffix("/\{name}")),
    max_concurrency=1,
  )
  paths.sort()
  for path in paths {
    let text = @fs.read_text(path)
    // Frontmatter can contain several import blocks. Inspect all of it,
    // stopping before program text that may quote an import as test data.
    // Delimiters are three or more hyphens; comments do not import.
    let imports = StringBuilder()
    let mut in_frontmatter = false
    for line in text.split("\n") {
      let trimmed = line.trim()
      if trimmed.length() >= 3 && trimmed.iter().all(c => c == '-') {
        if in_frontmatter { break }
        in_frontmatter = true
      } else if in_frontmatter {
        let code = match line.find("//") {
          Some(i) => line[:i]
          None => line
        }
        imports.write_view(code)
        imports.write_char('\n')
      }
    }
    let imports = imports.to_string()
    let registry = "\"moonbitlang/" + "async"
    if imports.contains(registry + "@") ||
      imports.contains(registry + "\"") ||
      imports.contains(registry + "/") {
      die(1, "\{path}: use moonbitlang/core/async instead of registry async; the registry API is unstable and being replaced")
    }
  }
}

///|
async fn main {
  let targets = ["native"]
  let mut skip_js = false
  let mut skip_wasm = false
  let mut skip_prove = false
  let mut second_solver = false
  let mut full = false
  let mut only : String? = None
  let mut expect_part = false
  for arg in @env.args()[1:] {
    if expect_part {
      match arg {
        "checks"
        | "test-native"
        | "test-js"
        | "test-wasm"
        | "test-wasm-gc"
        | "coverage"
        | "crosscheck"
        | "prove"
        | "fmt" => only = Some(arg)
        _ => die(2, "unknown gates part: \{arg}")
      }
      expect_part = false
      continue
    }
    match arg {
      "--only" => {
        if only is Some(_) {
          die(2, "--only accepts one part")
        }
        expect_part = true
      }
      "--full" => full = true
      "--no-js" => skip_js = true
      "--no-wasm" => skip_wasm = true
      "--no-prove" => skip_prove = true
      "--second-solver" => second_solver = true
      _ => die(2, "unknown option: \{arg}")
    }
  }
  if expect_part {
    die(2, "--only needs a part")
  }
  if !skip_js {
    targets.push("js")
  }
  if !skip_wasm {
    targets.append(["wasm", "wasm-gc"])
  }
  if selected(only, "checks") {
    check_script_imports()
    // Every module's CHANGELOG opens with [Unreleased] and has a heading for its version.
    run("moon", ["run", "scripts/release.mbtx", "--", "check"])
    // The module READMEs, links and doc comments keep the documentation rules
    // shared by every gaato MoonBit repository (scripts/docs_audit.mbtx).
    run("moon", ["run", "scripts/docs_audit.mbtx", "--self-test"])
    for dir in ledgered() {
      // Every enforced limit in RESOURCE_BOUNDS.md names tests that exist.
      run("moon", ["run", "scripts/bounds_check.mbtx", "--", dir])
    }
    // The registry index, for the workspace and the scripts' imports.
    run("moon", ["update"])
    // The modules' copies of parts/ are what parts/ holds.
    run("moon", ["run", "scripts/gen_parts.mbtx", "--", "--check"])
    // The proof that reversing a code twice gives it back is what its generator
    // writes.
    run("moon", ["run", "scripts/gen_proof_reverse.mbtx", "--", "--check"])
    // Every proof ledger (PROOFS.md) agrees with the code: the proved functions
    // have contracts, every trusted bridge is listed with tests that exist.
    for dir in ledgered() {
      if @fs.exists("\{dir}/PROOFS.md") {
        run("moon", ["run", "scripts/proof_check.mbtx", "--", dir])
      }
    }
    // Generated inputs are current: zstd's vectors and the benchmarks' (the zstd
    // and brotli commands decompress them to what the generators produce),
    // DEFLATE's, zlib's and gzip's (Node's zlib and the gzip command decompress
    // them, and zlib still answers what they record for the crafted streams and
    // the corruptions), and the conformance suite's vectors (an extract of each
    // format's vectors).
    run("moon", ["run", "zstd/scripts/gen_vectors.mbtx", "--", "--check"])
    run("moon", ["run", "zstd/scripts/gen_dict_vectors.mbtx", "--", "--check"])
    run("moon", ["run", "brotli/scripts/gen_vectors.mbtx", "--", "--check"])
    run("moon", ["run", "brotli/scripts/gen_dict_vectors.mbtx", "--", "--check"])
    run("moon", ["run", "scripts/gen_deflate_vectors.mbtx", "--", "--check"])
    run("moon", [
      "run", "scripts/reference/libdeflate/gen_vectors.mbtx", "--", "--check",
    ])
    run("moon", [
      "run", "deflate/scripts/gen_deflate64_vectors.mbtx", "--", "--check",
    ])
    // The streams the snap crate writes, which the decoder is held to and the
    // encoder matches.
    run("moon", ["run", "snappy/scripts/gen_vectors.mbtx", "--", "--check"])
    // What lz4 1.10.0's library writes, which the decoder is held to and the
    // encoder matches to the byte.
    run("moon", ["run", "lz4/scripts/gen_vectors.mbtx", "--", "--check"])
    // What weezl and compress write, which the decoder is held to and the
    // encoder matches where they agree.
    run("moon", ["run", "lzw/scripts/gen_vectors.mbtx", "--", "--check"])
    // Seeded corruptions of the zstd and brotli vectors, with the zstd and
    // brotli commands' verdicts, which the decoders are held to.
    run("moon", ["run", "scripts/gen_oracle_vectors.mbtx", "--", "--check"])
    run("moon", ["run", "scripts/gen_conformance_vectors.mbtx", "--", "--check"])
    run("moon", ["run", "scripts/gen_bench_data.mbtx", "--", "--check"])
    // PngSuite's images, with pypng's answer for each.
    run("moon", ["run", "scripts/gen_png_vectors.mbtx", "--", "--check"])
    // Animated PNGs, with the png crate's frames for each.
    run("moon", ["run", "scripts/gen_apng_vectors.mbtx", "--", "--check"])
  }
  // From the workspace root, check and test cover every member.
  let cc = match @env.get_env_var("MOON_CC") {
    Some(cc) if cc != "" => cc
    _ => "cc"
  }
  for t in targets {
    if selected(only, "test-\{t}") {
      run("moon", ["check", "--deny-warn", "--target", t])
      run("timeout", ["600", "moon", "test", "--target", t], env={
        "MOON_CC": cc,
      })
    }
  }
  // Every uncovered line of every ledgered module is in its TEST_COVERAGE.md
  // ledger, within budget.
  if selected(only, "coverage") {
    run("moon", ["run", "scripts/coverage_report.mbtx"], env={ "MOON_CC": cc })
  }
  // The encoders' streams decode with the reference decoders.
  if selected(only, "crosscheck") && (full || only == Some("crosscheck")) {
    for dir in ["zstd", "brotli", "deflate", "snappy", "lz4", "lzw"] {
      run("moon", ["run", "\{dir}/scripts/crosscheck.mbtx"], env={
        "MOON_CC": cc,
      })
    }
  }
  // The proofs, with Z3, then (on request) CVC5.
  if selected(only, "prove") && !skip_prove {
    run("moon", ["run", "scripts/prove.mbtx"])
    if second_solver {
      run("moon", ["run", "scripts/prove.mbtx", "--", "--solver", "cvc5"])
    }
  }
  if selected(only, "fmt") {
    run("moon", ["fmt", "--check"])
    run("moon", ["info"])
    // Only meaningful in CI: in a jj working copy `git diff` compares against the parent change,
    // so uncommitted edits would look stale. Set CHECK_MBTI=1 to enforce locally.
    if @env.get_env_var("CI") == Some("true") ||
      @env.get_env_var("CHECK_MBTI") == Some("1") {
      let code = @shell.Cmd("git", ["diff", "--exit-code", "--", "*.mbti"]).status()
      if code != 0 {
        die(1, "pkg.generated.mbti is stale: run 'moon info' and commit")
      }
    }
  }
  match only {
    None => println("gates: OK")
    Some(part) => println("gates (\{part}): OK")
  }
}

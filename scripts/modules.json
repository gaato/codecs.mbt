{
  "$comment": [
    "The workspace's modules, read by the scripts in this directory.",
    "modules: the published modules, bottom-up: a module comes after everything it imports.",
    "ledgered: the modules that hold stream-sized state, with the ledgers that bound it (RESOURCE_BOUNDS.md, TEST_COVERAGE.md). The contract modules define types only.",
    "coverage_scope: the directories, module-relative, whose .mbt files each module's coverage ledger measures: the library and the internal packages it ships, not test-only packages.",
    "copies: for each module, the packages of parts/ it takes and which of their files, for scripts/gen_parts.mbtx to copy into <module>/src/internal/<package>. Files, not whole packages, so that a module carries (and its coverage ledger covers) only what it uses."
  ],
  "modules": ["codec", "codec_bytes", "codec_image", "zstd", "brotli", "deflate", "png"],
  "ledgered": ["zstd", "brotli", "deflate", "png"],
  "coverage_scope": {
    "zstd": [
      "src",
      "src/internal/frame",
      "src/internal/header",
      "src/internal/huffman",
      "src/internal/proof_bits",
      "src/internal/proof_codes",
      "src/internal/proof_fields",
      "src/internal/xxhash"
    ],
    "brotli": [
      "src",
      "src/internal/bits",
      "src/internal/huffman",
      "src/internal/lz77",
      "src/internal/proof_bits",
      "src/internal/proof_codes",
      "src/internal/rules",
      "src/internal/transform"
    ],
    "deflate": [
      "src",
      "src/zlib",
      "src/zlib/internal/adler32",
      "src/zlib/internal/header",
      "src/gzip",
      "src/gzip/internal/header",
      "src/internal/crc32",
      "src/internal/huffman",
      "src/internal/inflate",
      "src/internal/lz77",
      "src/internal/deflate",
      "src/internal/proof_bits",
      "src/internal/proof_codes"
    ],
    "png": ["src", "src/internal/crc32"]
  },
  "copies": {
    "brotli": {
      "bits": ["bit_packer.mbt", "bit_packer_test.mbt"],
      "huffman": [
        "huffman.mbt",
        "huffman.mbtp",
        "huffman_test.mbt",
        "huffman_spec_test.mbt",
        "decode_table.mbt",
        "decode_table_spec_test.mbt"
      ],
      "lz77": ["hash.mbt", "hash_test.mbt", "matcher.mbt", "matcher_test.mbt"],
      "proof_bits": ["shifts.mbt", "shifts.mbtp", "shifts_test.mbt"],
      "proof_codes": ["codes.mbt", "codes.mbtp", "codes_test.mbt"]
    },
    "deflate": {
      "crc32": [
        "crc32.mbt",
        "crc32_test.mbt"
      ],
      "huffman": [
        "huffman.mbt",
        "huffman.mbtp",
        "huffman_test.mbt",
        "huffman_spec_test.mbt",
        "decode_table.mbt",
        "decode_table_spec_test.mbt",
        "enough.mbt",
        "enough_test.mbt",
        "code_maker.mbt",
        "code_maker_test.mbt"
      ],
      "lz77": [
        "hash.mbt",
        "hash_test.mbt",
        "matchfinder.mbt",
        "hc_matchfinder.mbt",
        "hc_matchfinder_test.mbt",
        "ht_matchfinder.mbt",
        "ht_matchfinder_test.mbt"
      ],
      "proof_bits": ["shifts.mbt", "shifts.mbtp", "shifts_test.mbt"],
      "proof_codes": ["codes.mbt", "codes.mbtp", "codes_test.mbt"]
    },
    "zstd": {
      "proof_bits": ["shifts.mbt", "shifts.mbtp", "shifts_test.mbt"],
      "proof_codes": ["codes.mbt", "codes.mbtp", "codes_test.mbt"],
      "proof_fields": ["fields.mbt", "fields.mbtp"]
    },
    "png": {
      "crc32": ["crc32.mbt", "crc32_test.mbt"]
    }
  },
  "proved": {
    "parts": {
      "proof_bits": { "prelude": "unbounded", "solvers": ["z3", "cvc5"] },
      "proof_fields": { "prelude": "unbounded", "solvers": ["z3", "cvc5"] },
      "proof_codes": { "prelude": "unbounded", "solvers": ["z3", "cvc5"] },
      "proof_reverse": { "prelude": "unbounded", "solvers": ["z3", "cvc5"] },
      "proof_canonical": { "prelude": "unbounded", "solvers": ["z3", "cvc5"] },
      "huffman": { "prelude": "unbounded", "solvers": ["z3", "cvc5"] }
    },
    "zstd": {
      "src/internal/header": { "prelude": "unbounded", "solvers": ["z3", "cvc5"] },
      "src/internal/frame": { "prelude": "machine-int", "solvers": ["z3", "cvc5"] },
      "src/internal/huffman": {
        "prelude": "unbounded",
        "solvers": ["z3", "cvc5"],
        "z3_only": ["build_table", "fill", "place_apart"]
      }
    },
    "brotli": {
      "src/internal/rules": {
        "prelude": "unbounded",
        "solvers": ["z3", "cvc5"],
        "z3_only": ["long_distance"]
      },
      "src/internal/transform": { "prelude": "unbounded", "solvers": ["z3", "cvc5"] }
    },
    "deflate": {
      "src/zlib/internal/header": { "prelude": "unbounded", "solvers": ["z3", "cvc5"] },
      "src/gzip/internal/header": { "prelude": "unbounded", "solvers": ["z3", "cvc5"] },
      "src/zlib/internal/adler32": { "prelude": "machine-int", "solvers": ["z3"] },
      "src/internal/inflate": { "prelude": "unbounded", "solvers": ["z3", "cvc5"] }
    }
  },
  "proof_controls": {
    "parts/proof_controls/unbounded": "unbounded",
    "parts/proof_controls/codes": "unbounded",
    "parts/proof_controls/machine_int": "machine-int"
  }
}

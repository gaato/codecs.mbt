----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/env",
}
----

// Generates conformance/src/apng_vectors_test.mbt: animated PNGs and the
// frames the reference decoder reads in each.
//
// The images are in conformance/apng/: the support images of the Web
// Platform Tests' png/apng (Philip Taylor's APNG tests, ported), Wuffs'
// animated-red-blue.apng and muybridge.apng, and image-png's
// tests/animated/basic_f20.png. The reference is the png crate (image-rs),
// version pinned in conformance/apng/reference/Cargo.lock, reading every
// frame raw: for each image, its size and acTL, then each frame's fcTL as
// stored and the digest of its samples (see conformance/apng/reference). The
// file names the crate's version, so that --check notices another one.
//
// Usage, from the repository root (needs cargo, and moonfmt, which comes with
// moon; cargo fetches the crate and its dependencies the first time):
//   moon run scripts/gen_apng_vectors.mbtx [--check]
// --check regenerates the file in memory and fails unless it is what the
// file holds.

///|
let target : String = "conformance/src/apng_vectors_test.mbt"

///|
/// The directories of the images, in the order the file lists them.
let sources : Array[String] = [
  "conformance/apng/wpt", "conformance/apng/wuffs", "conformance/apng/image-png",
]

///|
let manifest : String = "conformance/apng/reference/Cargo.toml"

///|
/// The png crate's version in the reference's Cargo.lock.
async fn crate_version() -> String {
  let lock = @fs.read_file("conformance/apng/reference/Cargo.lock").text()
  let mut found = false
  for line in lock.split("\n") {
    if line == "name = \"png\"" {
      found = true
    } else if found && line.strip_prefix("version = \"") is Some(rest) {
      return rest.strip_suffix("\"").unwrap_or(rest).to_owned()
    }
  }
  fail("conformance/apng/reference/Cargo.lock names no png crate")
}

///|
/// `data` as the lines of a multiline string literal.
fn literal(data : Bytes) -> String {
  let b64 = @base64.encode(data)
  let out = StringBuilder()
  out.write_string("(\n")
  for i = 0; i < b64.length().max(1); i = i + 76 {
    let line = b64.view(start_offset=i, end_offset=(i + 76).min(b64.length()))
    out.write_string("      #|\{line}\n")
  }
  out.write_string("    )")
  out.to_string()
}

///|
/// `text` as `moon fmt` leaves it, so that formatting the workspace does not
/// make the file stale.
async fn formatted(text : String) -> String {
  let output = @shell.Cmd("moonfmt", ["-"], stdin=Text(text)).output(
    max_output_bytes=1 << 28,
  )
  output.check()
  output.stdout()
}

///|
async fn main {
  let check = @env.args().contains("--check")
  let files = []
  for dir in sources {
    for entry in @fs.readdir(dir, sort=true) {
      if entry.has_suffix(".png") || entry.has_suffix(".apng") {
        files.push("\{dir}/\{entry}")
      }
    }
  }
  let answer = @shell.Cmd("cargo", [
    "run", "--quiet", "--release", "--locked", "--manifest-path", manifest, "--",
    ..files,
  ]).output(max_output_bytes=1 << 22)
  if answer.exit_code() != 0 {
    fail("the reference: \{answer.stderr()}")
  }
  let lines = answer.stdout().trim_end(chars="\n").split("\n").to_array()
  if lines.length() != files.length() {
    fail("the reference answered for \{lines.length()} of \{files.length()} images")
  }
  let version = crate_version()
  let out = StringBuilder()
  out.write_string((
    $|// Generated by scripts/gen_apng_vectors.mbtx, DON'T EDIT IT. From
    $|// conformance/apng/.
    $|
    $|///|
    $|/// The reference decoder that `apng_vectors` record the answers of.
    $|let apng_reference : String = "png \{version}"
    $|
    $|///|
    $|/// Animated PNGs, and the frames the reference reads in each.
    $|let apng_vectors : Array[PngVector] = [
    $|
  ))
  for i, line in lines {
    let file = files[i]
    let data = @fs.read_file(file).binary()
    let slash = file.rev_find("/").unwrap()
    let name = file.view(start_offset=slash + 1)
    let reference = line.view(start_offset=name.length() + 1)
    out.write_string((
      $|  {
      $|    name: "\{file.view(start_offset="conformance/apng/".length())}",
      $|    data: \{literal(data)},
      $|    reference: "\{reference}",
      $|  },
      $|
    ))
  }
  out.write_string("]\n")
  let text = formatted(out.to_string())
  if check {
    guard @fs.exists(target) else { fail("\{target} is missing") }
    if @fs.read_file(target).text() != text {
      fail(
        "\{target} is stale (or the reference is png \{version}): run moon run scripts/gen_apng_vectors.mbtx",
      )
    }
  } else {
    @fs.write_file(target, text)
    println("wrote \{target}")
  }
}

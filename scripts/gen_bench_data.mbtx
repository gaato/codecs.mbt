// Generates bench/src/data_test.mbt: the inputs of the benchmarks.
//
// A deterministic text of 512 KiB (words drawn by a seeded generator, with
// punctuation and line breaks) and a deterministic binary-like stream of
// 128 KiB, each compressed by the reference implementations: `zstd -3`,
// `brotli -q 9 -w 22` and `gzip -6 -n` (zlib's level 6, in a gzip member with
// a 10-byte header). The benchmarks decode these, so the decoders meet what
// common encoders produce, and encode what the decoders give back.
//
// Usage, from the repository root (needs the zstd, brotli and gzip commands):
//   moon run scripts/gen_bench_data.mbtx [--check]
// --check regenerates the inputs and fails unless the file holds them: the
// compressed data in the file must decompress, with the reference decoders, to
// the regenerated inputs. It does not compress again, because another version
// of an encoder may produce other, equally valid, bytes.

import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/env",
}

///|
let target : String = "bench/src/data_test.mbt"

///|
let words : Array[String] = [
  "the", "of", "and", "to", "in", "is", "that", "for", "it", "as", "with", "was",
  "on", "be", "by", "this", "are", "from", "at", "or", "an", "have", "not", "which",
  "but", "stream", "window", "block", "frame", "decoder", "encoder", "literal",
  "sequence", "offset", "match", "length", "table", "code", "symbol", "state",
  "bits", "compression", "data", "input", "output", "buffer", "memory", "limit",
  "header", "checksum",
]

///|
/// A seeded 32-bit LCG: the same numbers on every platform and version.
struct Rng {
  mut state : UInt
}

///|
fn Rng::below(self : Rng, bound : Int) -> Int {
  self.state = self.state * 1664525 + 1013904223
  (self.state >> 8).reinterpret_as_int() % bound
}

///|
/// Writes ASCII `s` byte by byte.
fn write_ascii(out : Buffer, s : String) -> Unit {
  for c in s {
    out.write_byte(c.to_int().to_byte())
  }
}

///|
fn text(n : Int) -> Bytes {
  let rng = { state: 8878 }
  let out = Buffer()
  while out.length() < n {
    let word = words[rng.below(words.length())]
    if rng.below(100) < 8 {
      // Capitalised: the first letter upper case.
      out.write_byte((word.code_unit_at(0).to_int() - 32).to_byte())
      write_ascii(out, word.view(start_offset=1).to_owned())
    } else {
      write_ascii(out, word)
    }
    let roll = rng.below(100)
    write_ascii(out, if roll < 80 {
      " "
    } else if roll < 88 {
      ", "
    } else if roll < 96 {
      ". "
    } else {
      "\n"
    })
  }
  out.to_bytes()[:n].to_owned()
}

///|
/// Records of a small header, a counter, and noise of varying length.
fn binary(n : Int) -> Bytes {
  let rng = { state: 7932 }
  let out = Buffer()
  while out.length() < n {
    out.write_byte(b'\x7f')
    out.write_byte(b'\x45')
    out.write_byte(rng.below(4).to_byte())
    out.write_byte(b'\x00')
    let at = out.length()
    for shift in [0, 8, 16, 24] {
      out.write_byte((at >> shift).to_byte())
    }
    for _ in 0..<(4 + rng.below(36)) {
      out.write_byte(rng.below(256).to_byte())
    }
  }
  out.to_bytes()[:n].to_owned()
}

///|
async fn compress(program : String, args : Array[String], input : Bytes) -> Bytes {
  let output = @shell.Cmd(program, args, stdin=Binary(input)).output()
  output.check()
  output.stdout_bytes()
}

///|
async fn decompress(program : String, input : Bytes) -> Bytes {
  let output = @shell.Cmd(program, ["-d", "-c"], stdin=Binary(input)).output()
  output.check()
  output.stdout_bytes()
}

///|
/// The data of `let <binding>` in the generated file, if it is there.
fn stored(file : String, binding : String) -> Bytes? raise {
  let b64 = StringBuilder()
  let mut inside = false
  for line in file.split("\n") {
    if line == "let \{binding} : String =" {
      inside = true
    } else if inside && line.has_prefix("  #|") {
      b64.write_view(line.view(start_offset=4))
    } else if inside {
      break
    }
  }
  if inside {
    Some(@base64.decode(b64.to_string()))
  } else {
    None
  }
}

///|
/// Renders the file; `pack(format, name, raw)` gives the compressed data.
async fn render(
  pack : async (String, String, Bytes) -> Bytes,
) -> String {
  let out = StringBuilder()
  out.write_string(
    "// Generated by scripts/gen_bench_data.mbtx, DON'T EDIT IT.\n\n",
  )
  for named in [("text", text(1 << 19)), ("binary", binary(1 << 17))] {
    let (name, raw) = named
    let packed = [
      ("zstd", pack("zstd", name, raw)),
      ("brotli", pack("brotli", name, raw)),
      ("gzip", pack("gzip", name, raw)),
    ]
    for p in packed {
      let (format, data) = p
      let b64 = @base64.encode(data)
      out.write_string(
        "///|\n/// \{name} (\{raw.length()} bytes) as \{format} produces it (\{data.length()} bytes).\n",
      )
      out.write_string("let \{format}_\{name} : String =\n")
      for i = 0; i < b64.length(); i = i + 76 {
        let line = b64.view(start_offset=i, end_offset=(i + 76).min(b64.length()))
        out.write_string("  #|\{line}\n")
      }
      out.write_string("\n")
    }
    out.write_string("///|\nlet \{name}_size : Int32 = \{raw.length()}\n\n")
  }
  // The formatter ends the file with one line break, not a blank line.
  let text = out.to_string()
  text.view(end_offset=text.length() - 1).to_owned()
}

///|
async fn main {
  let stale = "\{target} is stale: run moon run scripts/gen_bench_data.mbtx"
  if @env.args().contains("--check") {
    guard @fs.exists(target) else { fail(stale) }
    let file = @fs.read_file(target).text()
    let text = render(async fn(format, name, raw) {
      guard stored(file, "\{format}_\{name}") is Some(data) else { fail(stale) }
      if decompress(format, data) != raw {
        fail(stale)
      }
      data
    })
    if file != text {
      fail(stale)
    }
  } else {
    let text = render(async fn(format, _, raw) {
      match format {
        "zstd" => compress("zstd", ["-3", "-q", "-c", "--no-progress"], raw)
        "gzip" => compress("gzip", ["-6", "-n", "-c"], raw)
        _ => compress("brotli", ["-c", "-q", "9", "-w", "22"], raw)
      }
    })
    @fs.write_file(target, text)
    println("\{target}: \{text.length()} characters")
  }
}

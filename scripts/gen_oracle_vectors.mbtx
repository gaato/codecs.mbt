----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.6/crypto",
}
----

// Generates zstd/src/oracle_vectors_wbtest.mbt and
// brotli/src/oracle_vectors_wbtest.mbt: seeded corruptions of each format's
// vectors, each with what the reference decoder made of it, for the decoders'
// tests to agree with, as gaato/deflate's are held to zlib's verdicts.
//
// A corruption names a vector of the module's vectors_wbtest.mbt (of at most
// 40,000 bytes) and one edit, drawn from a seeded 64-bit LCG: a bit flipped,
// a byte replaced, a byte inserted, a byte deleted, or the stream cut. The
// reference decoder is the `zstd` or `brotli` command, given the edited
// stream on stdin: its verdict is "ok" with the length and SHA-256 of what it
// wrote, or "err" when it exits with a failure. The commands do not say which
// error, so the tests check only that the decoder refuses what the command
// refuses and decodes what it decodes to the same bytes.
//
// Usage, from the repository root (needs the zstd and brotli commands):
//   moon run scripts/gen_oracle_vectors.mbtx [--check]
// --check draws the same corruptions again, asks the commands again, and
// fails unless the files hold exactly what this script writes.

///|
/// Corruptions per format.
let count : Int = 600

///|
/// The largest vector a corruption is drawn from, compressed.
let max_source : Int = 40000

///|
/// A 64-bit LCG (Knuth's MMIX constants), the same on every platform.
struct Rng {
  mut state : UInt64
}

///|
fn Rng::below(self : Rng, bound : Int) -> Int {
  self.state = self.state * 6364136223846793005UL + 1442695040888963407UL
  (self.state >> 33).to_int() % bound
}

///|
/// The streams of a vectors file, by name, in file order.
fn streams(file : String) -> Array[(String, Bytes)] raise {
  let out = []
  let mut name = ""
  let b64 = StringBuilder()
  let mut in_stream = false
  for raw in file.split("\n") {
    let line = raw.trim()
    if line.strip_prefix("name: \"") is Some(rest) {
      name = rest.strip_suffix("\",").unwrap_or(rest).to_owned()
      b64.reset()
    } else if line.has_prefix("compressed: (") {
      in_stream = true
    } else if in_stream && line.strip_prefix("#|") is Some(rest) {
      b64.write_view(rest)
    } else if in_stream && line == ")," {
      out.push((name, @base64.decode(b64.to_string())))
      in_stream = false
    }
  }
  out
}

///|
/// One corruption: its source, the edit, where and with what.
struct Corruption {
  source : String
  op : Int
  at : Int
  value : Int
}

///|
/// The stream `corruption` makes of `input`, as the tests make it: bit
/// `value` of byte `at` flipped (0), the byte replaced by `value` (1),
/// `value` inserted before it (2), the byte deleted (3), the stream cut there
/// (4).
fn apply(c : Corruption, input : Bytes) -> Bytes {
  let bytes = input.to_array()
  match c.op {
    0 => bytes[c.at] = bytes[c.at] ^ (1 << c.value).to_byte()
    1 => bytes[c.at] = c.value.to_byte()
    2 => bytes.insert(c.at, c.value.to_byte())
    3 => bytes.remove(c.at) |> ignore
    _ => bytes.truncate(c.at)
  }
  Bytes::from_array(bytes)
}

///|
/// The corruptions of `sources`, drawn with `seed`.
fn draw(sources : Array[(String, Bytes)], seed : UInt64) -> Array[Corruption] {
  let rng = { state: seed }
  let out = []
  for _ in 0..<count {
    let (source, stream) = sources[rng.below(sources.length())]
    let op = rng.below(5)
    let at = rng.below(stream.length())
    let value = if op == 0 { rng.below(8) } else { rng.below(256) }
    out.push({ source, op, at, value })
  }
  out
}

///|
/// What `tool -d` makes of `input`: "ok <length> <sha256>" or "err".
async fn verdict(tool : String, input : Bytes) -> String {
  let output = @shell.Cmd(tool, ["-d", "-c"], stdin=Binary(input)).output(
    max_output_bytes=1 << 28,
  )
  if output.exit_code() != 0 {
    return "err"
  }
  let out = output.stdout_bytes()
  "ok \{out.length()} \{@crypto.bytes_to_hex_string(@crypto.sha256(out))}"
}

///|
/// The generated file for `format` (zstd or brotli).
async fn render(format : String, seed : UInt64) -> (String, String) {
  let target = "\{format}/src/oracle_vectors_wbtest.mbt"
  let all = streams(@fs.read_text("\{format}/src/vectors_wbtest.mbt"))
  let sources = all.filter(s => s.1.length() > 0 && s.1.length() <= max_source)
  let lookup = Map(sources)
  let version = @shell.Cmd(format, ["--version"]).output()
  version.check()
  let version = version.stdout().trim().split("\n").collect()[0].to_owned()
  let out = StringBuilder()
  out.write_string(
    (
      $|// Generated by scripts/gen_oracle_vectors.mbtx, DON'T EDIT IT.
      $|// Seeded corruptions of the vectors, with the verdicts of the reference
      $|// decoder, \{version}.
      $|
      $|///|
      $|let oracle : Array[OracleCase] = [
      $|
    ),
  )
  for c in draw(sources, seed) {
    let input = apply(c, lookup.get(c.source).unwrap())
    let v = verdict(format, input)
    // As `moon fmt` lays it out: on one line when that fits in 81 columns.
    let line = "  { source: \"\{c.source}\", op: \{c.op}, at: \{c.at}, value: \{c.value}, reference: \"\{v}\", },"
    if line.length() <= 81 {
      out.write_string(line + "\n")
    } else {
      out.write_string(
        (
          $|  {
          $|    source: "\{c.source}",
          $|    op: \{c.op},
          $|    at: \{c.at},
          $|    value: \{c.value},
          $|    reference: "\{v}",
          $|  },
          $|
        ),
      )
    }
  }
  out.write_string("]\n")
  (target, out.to_string())
}

///|
async fn main {
  let check = @env.args().contains("--check")
  for format in [("zstd", 8878UL), ("brotli", 7932UL)] {
    let (name, seed) = format
    let (target, text) = render(name, seed)
    if check {
      guard @fs.exists(target) && @fs.read_text(target) == text else {
        fail(
          "\{target} is stale: run moon run scripts/gen_oracle_vectors.mbtx",
        )
      }
    } else {
      @fs.write_text(target, text)
      println("\{target}: \{text.length()} characters")
    }
  }
}

// Generates conformance/src/<format>_vectors_test.mbt from each format's
// vectors.
//
// The conformance suite runs every format through the shared harness: splits,
// truncation, trailing bytes, reset and fuzzing, each over many runs per
// vector. It takes the smaller vectors of each module's vectors_wbtest.mbt
// (already generated from reference implementations and upstream test data),
// so that the suite covers every kind of stream without the run time of the
// large ones.
//
// Usage, from the repository root:
//   moon run scripts/gen_conformance_vectors.mbtx [--check]
// --check regenerates into memory and fails if a generated file differs.

import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
let formats : Array[String] = ["zstd", "brotli"]

///|
/// Decoded bytes.
let max_size : Int = 1 << 16

///|
/// Base64 characters.
let max_compressed : Int = 6000

///|
let max_vectors : Int = 48

///|
struct Entry {
  name : String
  base64 : String
  size : Int
  sha256 : String
  window_bits : Int?
}

///|
/// The entries of `let vectors` in a generated vectors_wbtest.mbt.
fn entries(text : String) -> Array[Entry] raise {
  let entries = []
  let mut inside = false
  let mut name = ""
  let mut base64 = StringBuilder()
  let mut size = 0
  let mut sha256 = ""
  let mut window_bits : Int? = None
  for raw in text.split("\n") {
    let line = raw.trim()
    if !inside {
      inside = line.has_prefix("let vectors")
      continue
    }
    if line == "]" {
      break
    }
    if line.strip_prefix("name: \"") is Some(rest) {
      name = rest.strip_suffix("\",").unwrap().to_owned()
      base64 = StringBuilder()
      window_bits = None
    } else if line.strip_prefix("#|") is Some(rest) {
      base64.write_view(rest)
    } else if line.strip_prefix("size: ") is Some(rest) {
      size = @string.parse_int(rest.strip_suffix(",").unwrap())
    } else if line.strip_prefix("sha256: \"") is Some(rest) {
      sha256 = rest.strip_suffix("\",").unwrap().to_owned()
    } else if line.strip_prefix("window_bits: ") is Some(rest) {
      window_bits = Some(@string.parse_int(rest.strip_suffix(",").unwrap()))
    } else if line == "}," {
      entries.push({ name, base64: base64.to_string(), size, sha256, window_bits })
    }
  }
  entries
}

///|
fn render(fmt : String, all : Array[Entry]) -> String {
  let chosen = all
    .filter(e => e.size <= max_size && e.base64.length() <= max_compressed)
  let chosen = chosen[:chosen.length().min(max_vectors)]
  let out = StringBuilder()
  out.write_string(
    (
      $|// Generated by scripts/gen_conformance_vectors.mbtx from
      $|// \{fmt}/src/vectors_wbtest.mbt, DON'T EDIT IT.
      $|
      $|///|
      $|let \{fmt}_vectors : Array[Vector] = [
      $|
    ),
  )
  for e in chosen {
    out.write_string("  {\n    name: \"\{e.name}\",\n    compressed: (\n")
    let b64 = e.base64
    for i = 0; i < b64.length().max(1); i = i + 76 {
      let line = b64.view(start_offset=i, end_offset=(i + 76).min(b64.length()))
      out.write_string("      #|\{line}\n")
    }
    let bits = e.window_bits.unwrap_or(24)
    out.write_string(
      "    ),\n    size: \{e.size},\n    sha256: \"\{e.sha256}\",\n    window_bits: \{bits},\n  },\n",
    )
  }
  out.write_string("]\n")
  out.to_string()
}

///|
async fn main {
  let check = @env.args().contains("--check")
  let stale = []
  for fmt in formats {
    let source = @fs.read_file("\{fmt}/src/vectors_wbtest.mbt").text()
    let text = render(fmt, entries(source))
    let target = "conformance/src/\{fmt}_vectors_test.mbt"
    if check {
      if !@fs.exists(target) || @fs.read_file(target).text() != text {
        stale.push(target)
      }
    } else {
      @fs.write_file(target, text)
      let count = text.split("    name: ").count() - 1
      println("\{target}: \{count} vectors")
    }
  }
  if !stale.is_empty() {
    fail(
      "stale: \{stale.join(", ")} (run moon run scripts/gen_conformance_vectors.mbtx)",
    )
  }
}

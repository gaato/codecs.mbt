----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
}
----

///|
// Generates parts/proof_reverse/involution.mbt: the proof that reversing the
// low `n` bits of a code twice gives the code back, for `n` from 1 to 15.
//
// The proof is one chain of small functions per `n`, each step spelled out
// with constant powers of two, because the solvers do not find these steps on
// their own and get lost when one function holds many of them. The chains
// differ only in `n`, so this script writes them instead of a person.
//
// Usage, from the repository root (needs moonfmt, which comes with moon):
//   moon run scripts/gen_proof_reverse.mbtx [--check]
// --check fails unless the file is what this script writes.

///|
let target : String = "parts/proof_reverse/involution.mbt"

///|
/// The largest code length of DEFLATE and brotli.
let max_bits : Int32 = 15

///|
let header : String =
  #|// Generated by scripts/gen_proof_reverse.mbtx; edit that instead.
  #|//
  #|// `@proof_codes.rev` is an involution: reversing the low `n` bits of a
  #|// number of `n` bits twice gives the number back, for `n` from 0 to 15.
  #|//
  #|// The functions compute nothing; their contracts are the theorem and the
  #|// steps to it, which `moon prove` proves, and nothing calls them. For each
  #|// `n`: a number of `n` bits is the sum of its bits (`bits_n`), so reversing
  #|// it gives the sum of its bits in reverse order; and reversing a sum of bits
  #|// gives the sum of the bits in reverse order (`of_bits_n`, from each bit of
  #|// the sum, `bit_n_j`). The solvers need every step spelled out with
  #|// constant powers of two, each in a function of its own so that the steps
  #|// before it do not crowd its context.
  #|

///|
/// `f(i)` for `i` in `from..<to`, joined by `sep`, or `empty` for none.
fn join(
  from : Int32,
  to : Int32,
  sep : String,
  f : (Int32) -> String,
  empty~ : String = "",
) -> String {
  if from >= to {
    return empty
  }
  let parts = []
  for i in from..<to {
    parts.push(f(i))
  }
  parts.join(sep)
}

///|
fn pow(j : Int32) -> Int32 {
  1 << j
}

///|
/// Bit `j` of `c`, as the proofs write it.
fn digit(j : Int32) -> String {
  "c / \{pow(j)} % 2"
}

///|
/// Every `b0`..`b(n-1)` is a bit.
fn bits_require(n : Int32) -> String {
  join(0, n, " && ", i => "0 <= b\{i} && b\{i} <= 1")
}

///|
fn bit_params(n : Int32) -> String {
  join(0, n, ", ", i => "b\{i} : Int32")
}

///|
/// `b0 + 2 * b1 + ...`: the number whose bits are `b0`..`b(n-1)`.
fn sum_of_bits(n : Int32) -> String {
  join(0, n, " + ", i => "\{pow(i)} * b\{i}")
}

///|
/// The dispatch from `n` to its chain.
fn involution() -> String {
  let cases = join(1, max_bits + 1, " else ", n => {
    "if n == \{n} {\n    involution_\{n}(c)\n  }"
  })
  (
    $|///|
    $|/// Reversing the low `n` bits of `c`, a number of `n` bits, twice gives `c`.
    $|pub fn involution(c : Int32, n : Int32) -> Unit where {
    $|  proof_require: 0 <= n && n <= \{max_bits} && 0 <= c && c < @proof_bits.pow2(n),
    $|  proof_ensure: @proof_codes.rev(@proof_codes.rev(c, n), n) == c,
    $|} {
    $|  \{cases}
    $|}
    $|
  )
}

///|
/// Halving `c / 2^j` leaves its low bit over.
fn halve(j : Int32) -> String {
  (
    $|///|
    $|fn halve_\{j}(c : Int32) -> Unit where {
    $|  proof_require: 0 <= c,
    $|  proof_ensure: c / \{pow(j)} == 2 * (c / \{pow(j + 1)}) + \{digit(j)},
    $|} {
    $|}
    $|
  )
}

///|
/// A number of `n` bits is the sum of its bits.
fn bits(n : Int32) -> String {
  let sum = join(0, n, " + ", j => "\{pow(j)} * (\{digit(j)})")
  let steps = join(0, n, "\n", j => "  halve_\{j}(c)")
  (
    $|///|
    $|fn bits_\{n}(c : Int32) -> Unit where {
    $|  proof_require: 0 <= c && c < \{pow(n)},
    $|  proof_ensure: c == \{sum},
    $|} {
    $|\{steps}
    $|  proof_assert c / \{pow(n)} == 0
    $|}
    $|
  )
}

///|
/// Bit `j` of a sum of `n` bits is `b{j}`: the sum splits into the bits above
/// `j`, bit `j` and the bits below it, which add up to less than `2^j`.
fn bit(n : Int32, j : Int32) -> String {
  let x = sum_of_bits(n)
  let above = join(j + 1, n, " + ", i => "\{pow(i - j - 1)} * b\{i}", empty="0")
  let below = join(0, j, " + ", i => "\{pow(i)} * b\{i}", empty="0")
  let below_fact = if j > 0 {
    "  proof_assert \{below} < \{pow(j)}\n"
  } else {
    ""
  }
  (
    $|///|
    $|fn bit_\{n}_\{j}(\{bit_params(n)}) -> Unit where {
    $|  proof_require: \{bits_require(n)},
    $|  proof_ensure: (\{x}) / \{pow(j)} % 2 == b\{j},
    $|} {
    $|  proof_assert \{x} == \{pow(j + 1)} * (\{above}) + \{pow(j)} * b\{j} + (\{below})
    $|\{below_fact}  proof_assert (\{x}) / \{pow(j)} == 2 * (\{above}) + b\{j}
    $|}
    $|
  )
}

///|
/// Reversing a sum of `n` bits gives the sum of the bits in reverse order.
fn of_bits(n : Int32) -> String {
  let reversed = join(0, n, " + ", j => "\{pow(n - 1 - j)} * b\{j}")
  let args = join(0, n, ", ", i => "b\{i}")
  let calls = join(0, n, "\n", j => "  bit_\{n}_\{j}(\{args})")
  let steps = join(0, n, "\n", j => bit(n, j))
  (
    $|\{steps}
    $|///|
    $|fn of_bits_\{n}(\{bit_params(n)}) -> Unit where {
    $|  proof_require: \{bits_require(n)},
    $|  proof_ensure: @proof_codes.rev(\{sum_of_bits(n)}, \{n}) == \{reversed},
    $|} {
    $|\{calls}
    $|}
    $|
  )
}

///|
/// The theorem for one `n`.
fn involution_n(n : Int32) -> String {
  let once = join(0, n, " + ", k => "\{pow(k)} * (\{digit(n - 1 - k)})")
  let args = join(0, n, ", ", k => digit(n - 1 - k))
  (
    $|///|
    $|fn involution_\{n}(c : Int32) -> Unit where {
    $|  proof_require: 0 <= c && c < \{pow(n)},
    $|  proof_ensure: @proof_codes.rev(@proof_codes.rev(c, \{n}), \{n}) == c,
    $|} {
    $|  bits_\{n}(c)
    $|  proof_assert @proof_codes.rev(c, \{n}) == \{once}
    $|  of_bits_\{n}(\{args})
    $|}
    $|
  )
}

///|
fn render() -> String {
  let out = StringBuilder()
  out.write_string(header)
  out.write_string("\n")
  out.write_string(involution())
  for j in 0..<max_bits {
    out.write_string("\n")
    out.write_string(halve(j))
  }
  for n in 1..<=max_bits {
    for part in [bits(n), of_bits(n), involution_n(n)] {
      out.write_string("\n")
      out.write_string(part)
    }
  }
  out.to_string()
}

///|
async fn formatted(text : String) -> String {
  let output = @shell.Cmd("moonfmt", ["-"], stdin=Text(text)).output(
    max_output_bytes=1 << 26,
  )
  output.check()
  output.stdout()
}

///|
async fn main {
  let text = formatted(render())
  if @env.args().contains("--check") {
    guard @fs.exists(target) else { fail("\{target} is missing") }
    if @fs.read_file(target).text() != text {
      fail("stale: \{target} (run moon run scripts/gen_proof_reverse.mbtx)")
    }
  } else {
    @fs.write_file(target, text)
    println("\{target}: n from 1 to \{max_bits}")
  }
}

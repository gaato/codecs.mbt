// Cyclic redundancy checks: any CRC of up to 64 bits from its parameters,
// the reveng catalogue's by name, combining the CRCs of two pieces, and the
// three that formats use most, eight bytes at a time.

name = "gaato/crc"

version = "0.1.1"

license = "Apache-2.0"

readme = "README.md"

repository = "https://github.com/gaato/codecs.mbt"

keywords = [ "crc", "checksum", "crc32", "crc32c", "crc64" ]

description = "CRCs of up to 64 bits from their parameters or by name, combined across pieces, with fast CRC-32, CRC-32C and CRC-64/XZ."

source = "src"

preferred_target = "native"

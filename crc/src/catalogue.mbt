// The CRC catalogue of Greg Cook's reveng (https://reveng.sourceforge.io/
// crc-catalogue/all.htm, as of 2026-11-16): every CRC of at most 64 bits.
// Their check values and residues, which the tests hold each to, are in
// catalogue_wbtest.mbt. CRC-82/DARC, the one wider, is left out.

///|
/// A CRC of the catalogue: its parameters, its name and its aliases.
priv struct Entry {
  name : String
  aliases : Array[String]
  width : Int32
  poly : UInt64
  init : UInt64
  reflect_in : Bool
  reflect_out : Bool
  xor_out : UInt64
}


///|
/// The CRC the reveng catalogue calls `name`, by its name or an alias, in
/// any case: "CRC-32" (an alias of CRC-32/ISO-HDLC), "CRC-16/ARC",
/// "CRC-64/XZ" and so on; None for a name it does not have.
pub fn Crc::named(name : String) -> Crc? {
  let wanted = name.to_upper()
  for e in catalogue {
    if e.name == wanted || e.aliases.contains(wanted) {
      return Some(
        Crc::new(
          width=e.width,
          poly=e.poly,
          init=e.init,
          reflect_in=e.reflect_in,
          reflect_out=e.reflect_out,
          xor_out=e.xor_out,
        ),
      )
    }
  }
  None
}

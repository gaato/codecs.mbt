----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.6/crypto",
}
----

// Generates brotli/src/dict_vectors_wbtest.mbt: streams that use an LZ77
// dictionary (RFC 9841 section 3.2), made with the `brotli` command's -D,
// for the decoder's tests.
//
// The dictionary is raw content made here, the same every run. The inputs
// share words with it, so that the streams reach into it: small records,
// where a dictionary matters most, and longer ones, at several qualities and
// windows, among them a 1 KiB window that a 4,000-byte input fills, after
// which distances into the dictionary start past the full window.
//
// Usage, from the repository root (needs the brotli command):
//   moon run brotli/scripts/gen_dict_vectors.mbtx [--check]
// --check regenerates the inputs and the dictionary and fails unless the
// file holds them: every stored stream must decompress, with `brotli -d -D`,
// to its regenerated input, and the rest of the file must be what this
// script writes for those streams. It does not compress again, because
// another version of brotli may produce other, equally valid, bytes.

///|
let target : String = "brotli/src/dict_vectors_wbtest.mbt"

///|
let words : Array[String] = [
  "the", "moonbit", "brotli", "stream", "block", "window", "dictionary", "record",
  "name", "version", "deps", "readme", "repository", "license", "keywords",
  "description", "source", "checksum", "created", "gaato", "codec", "context",
  "match", "distance", "literal", "command", "huffman", "prefix", "transform",
]

///|
/// A 64-bit LCG, the same on every platform and version.
struct Rng {
  mut state : UInt64
}

///|
fn Rng::below(self : Rng, bound : Int) -> Int {
  self.state = self.state * 6364136223846793005UL + 1442695040888963407UL
  (self.state >> 33).to_int() % bound
}

///|
/// A JSON-like record of about `n` bytes.
fn record(rng : Rng, n : Int) -> Bytes {
  let out = Buffer()
  out.write_string_utf8("{\"name\":\"gaato/")
  while out.length() < n {
    let key = words[rng.below(words.length())]
    let value = words[rng.below(words.length())]
    out.write_string_utf8("\",\"\{key}\":\"\{value}-\{rng.below(1000)}")
  }
  out.write_string_utf8("\"}\n")
  out.to_bytes()
}

///|
/// Records, one after another, to `n` bytes.
fn records(rng : Rng, n : Int) -> Bytes {
  let out = Buffer()
  while out.length() < n {
    out.write_bytes(record(rng, 80 + rng.below(600)))
  }
  out.to_bytes()[:n].to_owned()
}

///|
/// The dictionary: 50,000 bytes of records.
fn dictionary() -> Bytes {
  records({ state: 9842 }, 50000)
}

///|
fn inputs() -> Array[(String, Bytes)] {
  let rng = { state: 7932 }
  [
    ("empty", b""),
    ("record", record(rng, 300)),
    ("records_4k", records(rng, 4000)),
    ("records_100k", records(rng, 100000)),
  ]
}

///|
/// A vector: its name, the input's name, and the brotli command's quality
/// and window.
struct Spec {
  name : String
  input : String
  quality : Int
  window : Int
}

///|
fn specs() -> Array[Spec] {
  let out = []
  for named in inputs() {
    let (input, _) = named
    for quality in [0, 1, 5, 9, 11] {
      for window in [10, 16, 22] {
        // The long input at two qualities and one window only.
        if input == "records_100k" && !(window == 22 && quality is (5 | 11)) {
          continue
        }
        out.push({
          name: "\{input}_q\{quality}_w\{window}",
          input,
          quality,
          window,
        })
      }
    }
  }
  out
}

///|
async fn brotli(args : Array[String], input : Bytes) -> Bytes {
  let output = @shell.Cmd("brotli", ["-c", ..args], stdin=Binary(input)).output(
    max_output_bytes=1 << 26,
  )
  output.check()
  output.stdout_bytes()
}

///|
fn literal(data : Bytes, top_level~ : Bool = false) -> String {
  let b64 = @base64.encode(data)
  let out = StringBuilder()
  if !top_level {
    out.write_string("(\n")
  }
  for i = 0; i < b64.length().max(1); i = i + 76 {
    let line = b64.clamped_view(start=i, end=(i + 76).min(b64.length()))
    let indent = if top_level { "  " } else { "      " }
    out.write_string("\{indent}#|\{line}\n")
  }
  if !top_level {
    out.write_string("    )")
  }
  out.to_string()
}

///|
/// Renders the file. `stream(spec)` gives a vector's stream; every stream
/// must decode with `brotli -d -D` to its input.
async fn render(
  version : String,
  dict_path : String,
  stream : async (Spec) -> Bytes,
) -> String {
  let inputs = Map(inputs())
  let out = StringBuilder()
  out.write_string(
    (
      $|// Generated by brotli/scripts/gen_dict_vectors.mbtx, DON'T EDIT IT.
      $|// streams made with the brotli command \{version}.
      $|
      $|///|
      $|/// The LZ77 dictionary the streams use, base64.
      $|let dict_content : String =
      $|\{literal(dictionary(), top_level=true)}
      $|///|
      $|let dict_vectors : Array[DictVector] = [
      $|
    ),
  )
  for spec in specs() {
    let input = inputs.get(spec.input).unwrap()
    let compressed = stream(spec)
    let decoded = brotli(["-d", "-D", dict_path], compressed) catch {
      _ => fail("\{spec.name}: brotli -d refuses it")
    }
    if decoded != input {
      fail("\{spec.name}: does not decode to its input")
    }
    let sha256 = @crypto.bytes_to_hex_string(@crypto.sha256(input))
    out.write_string(
      (
        $|  {
        $|    name: "\{spec.name}",
        $|    compressed: \{literal(compressed)},
        $|    size: \{input.length()},
        $|    sha256: "\{sha256}",
        $|  },
        $|
      ),
    )
  }
  out.write_string("]\n")
  out.to_string()
}

///|
/// The streams of the generated file, by name.
fn stored(file : String) -> Map[String, Bytes] raise {
  let blocks = Map([])
  let mut name = ""
  let b64 = StringBuilder()
  for raw in file.split("\n") {
    let line = raw.trim()
    if line.strip_prefix("name: \"") is Some(rest) {
      name = rest.strip_suffix("\",").unwrap_or(rest).to_owned()
      b64.reset()
    } else if line.strip_prefix("#|") is Some(rest) {
      b64.write_view(rest)
    } else if line == ")," && name != "" {
      blocks[name] = @base64.decode(b64.to_string())
      name = ""
    }
  }
  blocks
}

///|
fn stored_version(file : String) -> String? {
  let lead = "// streams made with the brotli command "
  for line in file.split("\n") {
    if line.strip_prefix(lead) is Some(rest) {
      return rest.strip_suffix(".").map(v => v.to_owned())
    }
  }
  None
}

///|
async fn main {
  let stale = "\{target} is stale: run moon run brotli/scripts/gen_dict_vectors.mbtx"
  let work = "_build/gen_brotli_dict_vectors"
  if @fs.exists(work) {
    @fs.remove(work, recursive=true)
  }
  @fs.mkdir(work, recursive=true)
  let dict_path = "\{work}/dict"
  @fs.write_binary(dict_path, dictionary())
  if @env.args().contains("--check") {
    guard @fs.exists(target) else { fail(stale) }
    let file = @fs.read_text(target)
    guard stored_version(file) is Some(version) else { fail(stale) }
    let blocks = stored(file)
    let text = render(version, dict_path, spec => {
      guard blocks.get(spec.name) is Some(data) else { fail(stale) }
      data
    })
    if file != text {
      fail(stale)
    }
  } else {
    let version = @shell.Cmd("brotli", ["--version"]).output()
    version.check()
    let version = version.stdout().trim().to_owned()
    let inputs = Map(inputs())
    let text = render(version, dict_path, async fn(spec) {
      brotli(
        [
          "-q",
          spec.quality.to_string(),
          "-w",
          spec.window.to_string(),
          "-D",
          dict_path,
        ],
        inputs.get(spec.input).unwrap(),
      )
    })
    @fs.write_text(target, text)
    println("\{target}: \{text.length()} characters")
  }
  @fs.remove(work, recursive=true)
}

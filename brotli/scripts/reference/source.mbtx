----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/x@0.5.6/crypto",
}
----

// Downloads and verifies the pinned MIT reference, then prints its source
// directory. The archive stays under target; extracted sources are not vendored.
async fn main {
  let root = "brotli/scripts/reference"
  let cache = "\{root}/target"
  let name = "brotli-v1.2.1.tar.gz"
  let archive = "\{cache}/\{name}"
  @fs.mkdir(cache, recursive=true, allow_existing=true)
  let work = @fs.tmpdir(prefix="brotli-reference.")
  defer @fs.remove(work, recursive=true)
  let candidate = if @fs.exists(archive) {
    archive
  } else {
    let candidate = "\{work}/\{name}"
    @shell.Cmd("curl", ["--fail", "--location", "--silent", "--show-error", "--max-time", "60", "--output", candidate, "https://github.com/google/brotli/archive/refs/tags/v1.2.1.tar.gz"]).output().check()
    candidate
  }
  let bytes = @fs.read_binary(candidate)
  let hash = @hex.encode(Bytes::from_array(@crypto.sha256(bytes)))
  assert_eq(@fs.read_text("\{root}/SOURCE.sha256").trim().to_owned(), "\{hash}  \{name}")
  if candidate != archive {
    let staged = "\{cache}/\{work[work.rev_find("/").unwrap() + 1:]}.part"
    @fs.write_binary(staged, bytes)
    @fs.rename(staged, archive)
  }
  @shell.Cmd("tar", ["-xzf", archive, "-C", cache]).output().check()
  println("\{cache}/brotli-1.2.1")
}

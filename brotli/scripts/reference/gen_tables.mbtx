----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
}
----

fn values(source : String, name : String) -> String {
  let tail = source[source.find(name).unwrap():]
  let tail = tail[tail.find("{").unwrap() + 1:]
  tail[:tail.find("}").unwrap()].to_owned()
}

async fn main {
  @shell.Cmd("moon", ["run", "brotli/scripts/reference/source.mbtx"]).output().check()
  let root = "brotli/scripts/reference/target/brotli-1.2.1/c/enc"
  let source = @fs.read_file("\{root}/dictionary_hash_inc.h").text()
  let out = StringBuilder()
  out.write_string("// DO NOT EDIT: generated by brotli/scripts/reference/gen_tables.mbtx.\n// google/brotli v1.2.1 (SOURCE.sha256), MIT; see LICENSE-encoder.\n")
  for (original, name, ty) in [("kStaticDictionaryHashWords", "ref_dict_words", "UInt16"), ("kStaticDictionaryHashLengths", "ref_dict_lengths", "Byte")] {
    out.write_string("\n///|\nfn \{name}() -> FixedArray[\{ty}] {\n[\n\{values(source, original)}\n]\n}\n")
  }
  let logs = values(@fs.read_file("\{root}/fast_log.c").text(), "kBrotliLog2Table")
  out.write_string("\n///|\nfn ref_small_log(n : Int32) -> Double {\nmatch n {\n")
  let mut index = 0
  for value in logs.split(",") {
    let value = value.trim().to_owned()
    if value != "" {
      let value = value.strip_suffix("f").unwrap().to_owned()
      out.write_string("  \{if index == 255 { "_" } else { index.to_string() }} => (\{value} : Float).to_double()\n")
      index += 1
    }
  }
  out.write_string("}\n}\n")
  let formatted = @shell.Cmd("moonfmt", ["-"], stdin=Text(out.to_string())).output()
  formatted.check()
  let target = "brotli/src/reference_tables.mbt"
  if @env.args().contains("--check") {
    assert_eq(@fs.read_file(target).text(), formatted.stdout())
  } else { @fs.write_file(target, formatted.stdout()) }
}

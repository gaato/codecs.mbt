----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/x@0.5.6/crypto",
}
----

fn sample(kind : Int32, size : Int32) -> Bytes {
  if kind == 3 {
    let words = [b"The ", b"compression ", b"dictionary ", b"representation ", b"the ", b"a ", b"window ", b"\n", b"{\"key\": [1, 2]} ", b"\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e ", b"\xc3\xa9\xc3\xa0\xc3\xa8 "]
    let out = Buffer()
    let mut rng = 1951U
    while out.length() < size {
      rng = rng * 1664525U + 1013904223U
      out.write_bytes(words[(rng >> 8).reinterpret_as_int() % words.length()])
    }
    return out.to_bytes()[:size].to_owned()
  }
  let text = b"hello hello hello, reference Brotli static dictionary compression\n"
  let mut state = 1951U
  let data = FixedArray::make(size, b'\x00')
  for i in 0..<size {
    state = state * 1664525U + 1013904223U
    data[i] = if kind == 0 { text[i % text.length()] }
    else if kind == 1 { (state >> 24).to_byte() }
    else if kind == 4 { (((state >> 24) & 31U).reinterpret_as_int()+32*((i/1024)&7)).to_byte() }
    else if i % 10000 < 6000 { text[i % text.length()] }
    else if i >= 4096 && i % 10000 < 8000 { data[i - 4096] }
    else { (state >> 24).to_byte() }
  }
  Bytes::from_array(data)
}

fn digest(data : Bytes) -> String { @hex.encode(Bytes::from_array(@crypto.sha256(data))) }

async fn main {
  let work = @fs.tmpdir(prefix="brotli-quality-vectors.")
  defer @fs.rmdir(work, recursive=true)
  let cli = @shell.Cmd("moon", ["run", "brotli/scripts/reference/cli.mbtx"]).output()
  cli.check()
  let brotli = cli.stdout().trim().to_owned()
  let out = StringBuilder()
  out.write_string("// DO NOT EDIT: generated by brotli/scripts/reference/gen_hq_vectors.mbtx.\n// SHA-256 of google/brotli 1.2.1 CLI outputs with explicit window and size hint modes.\n\n///|\ntest \"HQ qualities: pinned CLI bytes in both size hint modes\" {\n")
  for (kind, size, window) in [
    (0,0,22),(0,1,22),(0,2,22),(0,3,22),(0,20,22),(0,64,22),(0,1000,22),
    (0,70000,10),(0,70000,16),(0,70000,17),(0,70000,18),(0,70000,24),
    (1,10000,22),(2,200000,22),(2,524287,22),(2,524288,22),(2,524289,22),
    (2,1200000,19),(2,1200000,22),(2,1200000,10),(2,1200000,16),
    (3,250000,22),(3,1200000,22),(3,1200000,16),(0,2100000,22),(4,8192,22),
  ] {
    let input = sample(kind, size)
    let file = "\{work}/input"
    @fs.write_file(file, input)
    out.write_string("  {\n    let input = ref_quality_sample(\{kind}, \{size})\n    assert_eq(@checksum.sha256(input), \"\{digest(input)}\")\n    let expected = [\n")
    for quality in 10..=11 {
      let args = ["-q", quality.to_string(), "-w", window.to_string(), "-c"]
      let named = @shell.Cmd(brotli, [..args, file]).output(max_output_bytes=4000000)
      named.check()
      let stdin = @shell.Cmd(brotli, args, stdin=Binary(input)).output(max_output_bytes=4000000)
      stdin.check()
      out.write_string("      (\"\{digest(named.stdout_bytes())}\", \"\{digest(stdin.stdout_bytes())}\"),\n")
    }
    out.write_string("    ]\n    for quality in 10..=11 {\n      let (named, stdin) = expected[quality - 10]\n      let encoded = compress(input, quality~, window_bits=\{window})\n      assert_eq(@checksum.sha256(encoded), named, msg=\"kind\{kind}/size\{size}/w\{window}/named/q\\{quality}\")\n      assert_eq(decompress(encoded), input)\n      let known = encode_drive(Encoder(quality~, window_bits=\{window}, size_hint=input.length().to_int64()), input, next_in=() => 7919, next_out=() => 4096)\n      assert_eq(known, encoded)\n      let unknown = encode_drive(Encoder(quality~, window_bits=\{window}), input, next_in=() => 7919, next_out=() => 4096)\n      assert_eq(@checksum.sha256(unknown), stdin, msg=\"kind\{kind}/size\{size}/w\{window}/stdin/q\\{quality}\")\n    }\n  }\n")
  }
  out.write_string("}\n")
  let formatted = @shell.Cmd("moonfmt", ["-"], stdin=Text(out.to_string())).output()
  formatted.check()
  let path = "brotli/src/reference_hq_vectors_wbtest.mbt"
  if @env.args().contains("--check") { assert_eq(@fs.read_file(path).text(), formatted.stdout()) }
  else { @fs.write_file(path, formatted.stdout()) }
}

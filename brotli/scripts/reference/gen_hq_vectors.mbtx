----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/x@0.5.6/crypto",
}
----

fn sample(kind : Int32, size : Int32) -> Bytes {
  if kind == 3 {
    let words = [b"The ", b"compression ", b"dictionary ", b"representation ", b"the ", b"a ", b"window ", b"\n", b"{\"key\": [1, 2]} ", b"\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e ", b"\xc3\xa9\xc3\xa0\xc3\xa8 "]
    let out = Buffer()
    let mut rng = 1951U
    while out.length() < size {
      rng = rng * 1664525U + 1013904223U
      out.write_bytes(words[(rng >> 8).reinterpret_as_int() % words.length()])
    }
    return out.to_bytes()[:size].to_owned()
  }
  let text = b"hello hello hello, reference Brotli static dictionary compression\n"
  let mut state = 1951U
  let data = FixedArray::make(size, b'\x00')
  for i in 0..<size {
    state = state * 1664525U + 1013904223U
    data[i] = if kind == 0 { text[i % text.length()] }
    else if kind == 1 { (state >> 24).to_byte() }
    else if kind == 4 { (((state >> 24) & 31U).reinterpret_as_int()+32*((i/1024)&7)).to_byte() }
    else if i % 10000 < 6000 { text[i % text.length()] }
    else if i >= 4096 && i % 10000 < 8000 { data[i - 4096] }
    else { (state >> 24).to_byte() }
  }
  Bytes::from_array(data)
}

fn digest(data : Bytes) -> String { @hex.encode(Bytes::from_array(@crypto.sha256(data))) }

async fn write_generated(path : String, source : String, check : Bool, file_type~ : String = "mbt") -> Unit {
  let formatted = @shell.Cmd("moonfmt", ["-file-type", file_type, "-"], stdin=Text(source)).output()
  formatted.check()
  if check { assert_eq(@fs.read_text(path), formatted.stdout()) }
  else { @fs.write_text(path, formatted.stdout()) }
}

async fn main {
  let work = @fs.tmpdir(prefix="brotli-quality-vectors.")
  defer @fs.remove(work, recursive=true)
  let cli = @shell.Cmd("moon", ["run", "brotli/scripts/reference/cli.mbtx"]).output()
  cli.check()
  let brotli = cli.stdout().trim().to_owned()
  let header = "// DO NOT EDIT: generated by brotli/scripts/reference/gen_hq_vectors.mbtx.\n// SHA-256 of google/brotli 1.2.1 CLI outputs with explicit window and size hint modes.\n"
  let common = StringBuilder()
  common.write_string(header)
  common.write_string("// Small vectors run everywhere because the cost model uses floating point.\n// The large native matrix lives in conformance/src/brotli_hq_native/.\n")
  let matrix = StringBuilder()
  matrix.write_string(header)
  matrix.write_string("// Large byte oracles run once in native conformance; the codec keeps small\n// pins and boundary tests for every target and its coverage ledger.\n\n///|\nusing @brotli {type Encoder, type EncodeAction, compress, decompress}\n\n")
  // Generate the pure fixture sampler and the public streaming driver from
  // their existing sources, so the separate package cannot drift from them.
  let generator = @fs.read_text("brotli/scripts/reference/gen_hq_vectors.mbtx")
  let sample_start = generator.find("fn sample(").unwrap()
  let sample_end = generator.find("\nfn digest(").unwrap()
  matrix.write_string("///|\n")
  matrix.write_string(generator[sample_start:sample_end].to_owned().replace(old="fn sample(", new="fn ref_quality_sample("))
  let helpers = @fs.read_text("brotli/src/encode_wbtest.mbt")
  let driver_start = helpers.find("fn encode_drive(").unwrap()
  let driver = helpers[driver_start:]
  let driver_end = driver.find("\n///|").unwrap()
  matrix.write_string("\n///|\n")
  matrix.write_string(driver[:driver_end].to_owned())
  for (kind, size, window) in [
    (0,0,22),(0,1,22),(0,2,22),(0,3,22),(0,20,22),(0,64,22),(0,1000,22),
    (0,70000,10),(0,70000,16),(0,70000,17),(0,70000,18),(0,70000,24),
    (1,10000,22),(2,200000,22),(2,524287,22),(2,524288,22),(2,524289,22),
    (2,1200000,19),(2,1200000,22),(2,1200000,10),(2,1200000,16),
    (3,250000,22),(3,1200000,22),(3,1200000,16),(0,2100000,22),(4,8192,22),
    (0,1000,10),(0,1000,24),(1,1024,10),(1,1024,24),
    (2,8192,10),(2,8192,24),(3,4096,10),(3,4096,24),
    (4,8192,10),(4,8192,24),
  ] {
    let out = if size <= 8192 { common } else { matrix }
    let input = sample(kind, size)
    // Small inputs can finish in the first call, keeping window-24 forests
    // proportional to the input. Native's streaming matrix tests full forests.
    let piece = if size <= 8192 { size.max(1) } else { 7919 }
    let file = "\{work}/input"
    @fs.write_binary(file, input)
    out.write_string("\n///|\n")
    if size > 8192 {
      out.write_string("#cfg(target=\"native\")\n")
    }
    out.write_string("test \"HQ CLI bytes: kind\{kind}/size\{size}/w\{window}\" {\n    let input = ref_quality_sample(\{kind}, \{size})\n    assert_eq(@checksum.sha256(input), \"\{digest(input)}\")\n    let expected = [\n")
    for quality in 10..=11 {
      let args = ["-q", quality.to_string(), "-w", window.to_string(), "-c"]
      let named = @shell.Cmd(brotli, [..args, file]).output(max_output_bytes=4000000)
      named.check()
      let stdin = @shell.Cmd(brotli, args, stdin=Binary(input)).output(max_output_bytes=4000000)
      stdin.check()
      out.write_string("      (\"\{digest(named.stdout_bytes())}\", \"\{digest(stdin.stdout_bytes())}\"),\n")
    }
    out.write_string("    ]\n    for quality in 10..=11 {\n      let (named, stdin) = expected[quality - 10]\n")
    if size <= 8192 {
      // Small cases retain hinted streaming versus compress on every target.
      out.write_string("      let hint = Some(input.length().to_int64())\n      let encoded = encode_drive(Encoder(quality~, window_bits=\{window}, size_hint?=hint), input, next_in=() => \{piece}, next_out=() => 4096)\n")
    } else {
      // Every large named-file pin checks the whole-input, known-size path;
      // block boundaries and read schedules can expose size-dependent bugs.
      out.write_string("      let encoded = compress(input, quality~, window_bits=\{window})\n")
    }
    out.write_string("      assert_eq(@checksum.sha256(encoded), named, msg=\"kind\{kind}/size\{size}/w\{window}/named/q\\{quality}\")\n      assert_eq(decompress(encoded), input)\n")
    if size <= 8192 {
      out.write_string("      assert_eq(compress(input, quality~, window_bits=\{window}), encoded)\n")
    }
    // Each stdin pin independently checks unhinted streaming, even if the
    // CLI's two output hashes happen to agree.
    out.write_string("      let unknown = encode_drive(Encoder(quality~, window_bits=\{window}), input, next_in=() => \{piece}, next_out=() => 4096)\n      assert_eq(@checksum.sha256(unknown), stdin, msg=\"kind\{kind}/size\{size}/w\{window}/stdin/q\\{quality}\")\n")
    out.write_string("    }\n}\n")
  }
  let check = @env.args().contains("--check")
  write_generated("brotli/src/reference_hq_vectors_wbtest.mbt", common.to_string(), check)
  let native_dir = "conformance/src/brotli_hq_native"
  if !check { @fs.mkdir(native_dir, recursive=true, allow_existing=true) }
  let native_pkg =
    #|// DO NOT EDIT: generated by brotli/scripts/reference/gen_hq_vectors.mbtx.
    #|// Keep the expensive reference-byte matrix in private native conformance:
    #|// ordinary native tests check it once, while small codec tests cover lines.
    #|import {
    #|  "gaato/brotli",
    #|  "gaato/codec_harness" @checksum,
    #|} for "test"
    #|
    #|supported_targets = "native"
    #|
  write_generated("\{native_dir}/moon.pkg", native_pkg, check, file_type="pkg")
  write_generated("\{native_dir}/vectors_test.mbt", matrix.to_string().replace(old="Encoder(", new="@brotli.Encoder("), check)
}

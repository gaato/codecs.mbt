----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/x@0.5.6/crypto",
}
----

fn sample(kind : Int32,size : Int32) -> Bytes {
  if kind==3 {
    let words=[b"The ",b"compression ",b"dictionary ",b"representation ",b"the ",b"a ",b"window ",b"\n",b"{\"key\": [1, 2]} ",b"\xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e ",b"\xc3\xa9\xc3\xa0\xc3\xa8 "]
    let out=Buffer();let mut rng=1951U
    while out.length()<size {rng=rng*1664525U+1013904223U;out.write_bytes(words[(rng >> 8).reinterpret_as_int()%words.length()])}
    return out.to_bytes()[:size].to_owned()
  }
  let text=b"hello hello hello, reference Brotli static dictionary compression\n"
  let mut state=1951U
  let data=FixedArray::make(size,b'\x00')
  for i in 0..<size {
    state=state*1664525U+1013904223U
    data[i]=if kind==0 {text[i%text.length()]} else if kind==1 {(state >> 24).to_byte()}
      else if kind==5 {if i>=90000 {data[i-90000]} else {(state >> 24).to_byte()}}
      else if kind==6 {if i>=4000 {data[i-4000]} else {(state >> 24).to_byte()}}
      else if i%10000<6000 {text[i%text.length()]}
      else if i>=4096 && i%10000<8000 {data[i-4096]} else {(state >> 24).to_byte()}
  }
  Bytes::from_array(data)
}

fn digest(data : Bytes) -> String {@hex.encode(Bytes::from_array(@crypto.sha256(data)))}

async fn main {
  let cli=@shell.Cmd("moon",["run","brotli/scripts/reference/cli.mbtx"]).output()
  cli.check()
  let brotli=cli.stdout().trim().to_owned()
  let work=@fs.tmpdir(prefix="brotli-low-vectors.")
  defer @fs.rmdir(work,recursive=true)
  let cases=[]
  for q in 0..=3 {
    for (kind,size,window) in [(0,0,22),(0,1,22),(0,20,10),(0,1000,24),(1,10000,22),(2,20000,16),(3,10000,22)] {
      cases.push((q,kind,size,window))
    }
  }
  for (q,kind,size,window) in [
    (0,0,32769,22),(0,2,98304,22),(0,2,98305,22),(0,2,524288,22),(0,2,524289,22),
    (1,2,32768,22),(1,2,32769,22),(1,2,131071,22),(1,2,131072,22),(1,2,131073,22),(1,2,524288,22),(1,2,524289,22),
    (2,2,16384,10),(2,2,16385,10),(2,2,524289,22),(2,3,1200000,22),
    (3,2,16385,16),(3,2,524289,22),
    (0,1,65536,10),(2,2,700001,10),(3,2,700001,10),(3,2,900001,16),
    (0,5,300000,22),(1,5,300000,22),(2,5,300000,22),(3,5,300000,22),
    (2,2,35001,10),(3,2,35001,10),
    (2,0,1100000,22),(3,0,1100000,22),
    (0,6,10000,22),(1,6,10000,22),
  ] {cases.push((q,kind,size,window))}
  let out=StringBuilder()
  let portable=StringBuilder()
  out.write_string("// DO NOT EDIT: generated by brotli/scripts/reference/gen_low_vectors.mbtx.\n// SHA-256 of pinned google/brotli 1.2.1, named-file and stdin schedules.\n\n///|\n#cfg(target=\"native\")\ntest \"low qualities match pinned CLI in both size hint modes\" {\n")
  portable.write_string("\n///|\n#cfg(not(target=\"native\"))\ntest \"low qualities small CLI pins\" {\n")
  for (q,kind,size,window) in cases {
    let input=sample(kind,size)
    let file="\{work}/input"
    @fs.write_binary(file,input)
    let args=["-q",q.to_string(),"-w",window.to_string(),"-c"]
    let named=@shell.Cmd(brotli,[..args,file]).output(max_output_bytes=4 << 20)
    let stdin=@shell.Cmd(brotli,args,stdin=Binary(input)).output(max_output_bytes=4 << 20)
    named.check();stdin.check()
    let check="{let input=ref_quality_sample(\{kind},\{size})\nassert_eq(@checksum.sha256(input),\"\{digest(input)}\")\nlet expected=\"\{digest(named.stdout_bytes())}\"\nlet encoded=compress(input,quality=\{q},window_bits=\{window})\nassert_eq(@checksum.sha256(encoded),expected,msg=\"q\{q}/kind\{kind}/n\{size}/w\{window}/named\")\nassert_eq(decompress(encoded),input)\nlet known=encode_drive(Encoder(quality=\{q},window_bits=\{window},size_hint=input.length().to_int64()),input,next_in=()=>7919,next_out=()=>4096)\nassert_eq(known,encoded)\nlet unknown=encode_drive(Encoder(quality=\{q},window_bits=\{window}),input,next_in=()=>7919,next_out=()=>4096)\nassert_eq(@checksum.sha256(unknown),\"\{digest(stdin.stdout_bytes())}\",msg=\"q\{q}/kind\{kind}/n\{size}/w\{window}/stdin\")\n}\n"
    out.write_string(check)
    if size<=20000 || size==35001 {portable.write_string(check)}
  }
  out.write_string("}\n")
  portable.write_string("}\n")
  out.write_string(portable.to_string())
  let formatted=@shell.Cmd("moonfmt",["-"],stdin=Text(out.to_string())).output()
  formatted.check()
  let path="brotli/src/reference_low_vectors_wbtest.mbt"
  if @env.args().contains("--check") {assert_eq(@fs.read_text(path),formatted.stdout())}
  else {@fs.write_text(path,formatted.stdout())}
  println("low vectors: \{2*cases.length()} pinned CLI digests")
}

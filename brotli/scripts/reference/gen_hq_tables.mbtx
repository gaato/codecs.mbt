----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/x@0.5.6/crypto",
}
----

fn body(source : String, name : String) -> String {
  let tail = source[source.find(name).unwrap():]
  let tail = tail[tail.find("{").unwrap() + 1:]
  tail[:tail.find("};").unwrap()].to_owned()
}

fn entries(source : String) -> Array[UInt32] {
  source.split(",").filter_map(s => {
    let s = s.trim()
    if s.is_empty() { None } else { Some(@string.parse_uint(s) catch { _ => abort("invalid dictionary entry") }) }
  }).collect()
}

fn table(out : StringBuilder, name : String, values : Array[UInt32], width : Int32) -> Unit {
  let kind = if width == 2 { "UInt16" } else { "UInt32" }
  out.write_string("///|\nfn \{name}() -> FixedArray[\{kind}] {\n  let chunks : FixedArray[Bytes] = [\n")
  let hex = "0123456789abcdef"
  for i,value in values { for byte in 0..<width {
    let at = i*width+byte
    if at%1024 == 0 { out.write_string("b\"") }
    let v = ((value >> (8*byte)) & 255U).reinterpret_as_int()
    out.write_string("\\x\{hex[(v>>4):(v>>4)+1]}\{hex[(v&15):(v&15)+1]}")
    if at+1 == values.length()*width {
      for _ in ((at%1024)+1)..<1024 { out.write_string("\\x00") }
    }
    if at%1024 == 1023 || at+1 == values.length()*width { out.write_string("\",\n") }
  } }
  out.write_string("]\n  FixedArray::makei(\{values.length()}, i => chunks[(i*\{width})>>10].unsafe_read_uint\{width*8}_le((i*\{width}) & 1023))\n}\n\n")
}

fn digest(values : Array[UInt32], width : Int32) -> String {
  let bytes = Bytes::makei(values.length()*width, i => ((values[i/width] >> (8*(i%width))) & 255U).to_byte())
  @hex.encode(Bytes::from_array(@crypto.sha256(bytes)))
}

async fn main {
  @shell.Cmd("moon", ["run", "brotli/scripts/reference/source.mbtx"]).output().check()
  let source = @fs.read_file("brotli/scripts/reference/target/brotli-1.2.1/c/enc/static_dict_lut_inc.h").text()
  let words = body(source, "kStaticDictionaryWords").replace_all(old="{", new="").replace_all(old="}", new="")
  let fields = entries(words)
  assert_eq(fields.length() % 3, 0)
  let out = StringBuilder()
  out.write_string("// DO NOT EDIT: generated by brotli/scripts/reference/gen_hq_tables.mbtx.\n// google/brotli v1.2.1 (SOURCE.sha256), MIT; see LICENSE-encoder.\n// Packed constants keep table construction out of the generated instruction stream.\n\n")
  let buckets = entries(body(source,"kStaticDictionaryBuckets"))
  table(out,"hq_dict_buckets",buckets,2)
  let packed_words : Array[UInt32] = []
  for i in 0..<(fields.length() / 3) {
    let packed = fields[3 * i] | (fields[3 * i + 1] << 8) | (fields[3 * i + 2] << 16)
    packed_words.push(packed)
  }
  table(out,"hq_dict_words",packed_words,4)
  let formatted = @shell.Cmd("moonfmt", ["-"], stdin=Text(out.to_string())).output()
  formatted.check()
  let target = "brotli/src/reference_hq_tables.mbt"
  if @env.args().contains("--check") {
    assert_eq(@fs.read_file(target).text(), formatted.stdout())
  } else {
    @fs.write_file(target, formatted.stdout())
  }
  let test_source = "// DO NOT EDIT: generated by brotli/scripts/reference/gen_hq_tables.mbtx.\n// SHA-256 of the pinned reference's little-endian lookup values.\n\n///|\ntest \"HQ dictionary tables match the pinned reference\" {\nlet buckets = hq_dict_buckets()\nlet words = hq_dict_words()\nassert_eq(@checksum.sha256(Bytes::makei(2*buckets.length(), i => ((buckets[i/2].to_int() >> (8*(i%2))) & 255).to_byte())), \"\{digest(buckets,2)}\")\nassert_eq(@checksum.sha256(Bytes::makei(4*words.length(), i => ((words[i/4] >> (8*(i%4))) & 255U).to_byte())), \"\{digest(packed_words,4)}\")\n}\n"
  let formatted = @shell.Cmd("moonfmt",["-"],stdin=Text(test_source)).output()
  formatted.check()
  let path = "brotli/src/reference_hq_tables_wbtest.mbt"
  if @env.args().contains("--check") { assert_eq(@fs.read_file(path).text(),formatted.stdout()) }
  else { @fs.write_file(path,formatted.stdout()) }
}

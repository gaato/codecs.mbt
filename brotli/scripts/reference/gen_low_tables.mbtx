----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/env",
}
----

fn values(source : String, name : String) -> String {
  let tail = source[source.find(name).unwrap():]
  let tail = tail[tail.find("{").unwrap() + 1:]
  tail[:tail.find("}").unwrap()].to_owned()
}

async fn main {
  @shell.Cmd("moon", ["run", "brotli/scripts/reference/source.mbtx"]).output().check()
  let root = "brotli/scripts/reference/target/brotli-1.2.1/c/enc"
  let entropy = @fs.read_text("\{root}/entropy_encode_static.h")
  let encode = @fs.read_text("\{root}/encode.c")
  let one = @fs.read_text("\{root}/compress_fragment.c")
  let two = @fs.read_text("\{root}/compress_fragment_two_pass.c")
  let out = StringBuilder()
  out.write_string("// DO NOT EDIT: generated by brotli/scripts/reference/gen_low_tables.mbtx.\n// google/brotli v1.2.1 (SOURCE.sha256), MIT; see LICENSE-encoder.\n")
  for (source, original, name, count) in [
    (entropy,"kCodeLengthDepth","low_length_depth",18),
    (entropy,"kCodeLengthBits","low_length_bits",18),
    (entropy,"kZeroRepsDepth","low_zero_depth",704),
    (entropy,"kZeroRepsBits","low_zero_bits",704),
    (entropy,"kNonZeroRepsDepth","low_nonzero_depth",704),
    (entropy,"kNonZeroRepsBits","low_nonzero_bits",704),
    (entropy,"kStaticCommandCodeDepth","low_static_command_depth",704),
    (entropy,"kStaticCommandCodeBits","low_static_command_bits",704),
    (entropy,"kStaticDistanceCodeDepth","low_static_distance_depth",64),
    (entropy,"kStaticDistanceCodeBits","low_static_distance_bits",64),
    (encode,"kDefaultCommandDepths","low_default_depth",128),
    (encode,"kDefaultCommandBits","low_default_bits",128),
    (encode,"kDefaultCommandCode[","low_default_code",57),
    (one,"kCmdHistoSeed[","low_command_seed",128),
    (two,"kNumExtraBits[","low_extra_bits",128),
  ] {
    let items=values(source,original).split(",").filter(s=>!s.trim().is_empty()).map(s=>s.trim().to_owned()).collect()
    assert_true(items.length()<=count)
    // C initializes omitted trailing elements to zero, including two unused
    // entries in the q0 default-depth array.
    while items.length()<count {items.push("0")}
    out.write_string("\n///|\nfn \{name}() -> FixedArray[Int32] {\n[\n\{items.join(",\n")}\n]\n}\n")
  }
  let formatted = @shell.Cmd("moonfmt", ["-"], stdin=Text(out.to_string())).output()
  formatted.check()
  let path = "brotli/src/reference_low_tables.mbt"
  if @env.args().contains("--check") { assert_eq(@fs.read_text(path),formatted.stdout()) }
  else { @fs.write_text(path,formatted.stdout()) }
}

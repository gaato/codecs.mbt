----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
}
----

// Runs the shared harness from a disposable private consumer. The harness
// remains outside the published module's dependency graph.
let checks : String =
  #|///|
  #|test "quality encoders keep the shared byte-stream contract" {
  #|  for quality in 5..=11 {
  #|    for hint in [None, Some(1048576L)] {
  #|      for window_bits in [10, 22] {
  #|        let make = () => @brotli.Encoder(quality~, window_bits~, size_hint?=hint)
  #|        let input = b"dictionary compression \xe6\x97\xa5\xe6\x9c\xac\xe8\xaa\x9e ".repeat(60)
  #|        let stream = @harness.check_roundtrip(make, () => @brotli.Decoder(), input,
  #|          encoder_memory_limit=Some(@brotli.encoder_memory_bound(quality~, window_bits~, size_hint?=hint).min(2147483647L).to_int()))
  #|        @harness.check_flush(make, () => @brotli.Decoder(), input, flush_at=[0,1,31,31,input.length()])
  #|        let encoder = () => @harness.ByteEncoder::new(make())
  #|        @harness.check_reset(encoder, input, b"a second stream")
  #|        let decoder = () => @harness.ByteDecoder::new(@brotli.Decoder(until=EndOfMember))
  #|        let expected = @harness.drive(decoder(), stream)
  #|        @harness.check_member(decoder, stream, stream, expected)
  #|      }
  #|    }
  #|  }
  #|}

async fn main {
  let work = @fs.tmpdir(prefix="brotli-conformance.")
  defer @fs.rmdir(work, recursive=true)
  for name in ["brotli", "codec", "codec_bytes", "codec_image", "harness"] {
    @fs.symlink(target=@fs.realpath(name), "\{work}/\{name}")
  }
  @fs.mkdir("\{work}/consumer/src", recursive=true)
  @fs.write_file("\{work}/moon.work", "members = [\"consumer\", \"brotli\", \"codec\", \"codec_bytes\", \"codec_image\", \"harness\"]\n")
  @fs.write_file("\{work}/consumer/moon.mod", "name = \"gaato/brotli_contract\"\nversion = \"0.0.0\"\nprivate = true\nsource = \"src\"\nimport { \"gaato/brotli@0.5.0\", \"gaato/codec_harness@0.0.0\" }\n")
  @fs.write_file("\{work}/consumer/src/moon.pkg", "import { \"gaato/brotli\", \"gaato/codec_harness\" @harness } for \"test\"\nsupported_targets = \"native + js + wasm + wasm-gc\"\n")
  @fs.write_file("\{work}/consumer/src/contract_test.mbt", checks)
  let target = @env.args().get(1).unwrap_or("native")
  let status = @shell.Cmd("moon", ["test", "--target", target, "consumer/src"], cwd=work).status()
  assert_eq(status, 0)
}

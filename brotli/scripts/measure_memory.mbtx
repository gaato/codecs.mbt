----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/fs",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/x@0.5.6/crypto",
}
----

// Run under the shared gate lock. Optional arguments are the text and binary
// corpus files; defaults are the files written by compare_codecs's ratio run.
// A disposable white-box consumer enables the private HQ allocation observer.
async fn main {
  let args = @env.args()[1:]
  assert_true(args.length() == 0 || args.length() == 2)
  let files = if args.is_empty() {
    ["_build/compare/ratio/bench_text", "_build/compare/ratio/bench_binary"]
  } else { args.to_owned() }
  let source = StringBuilder()
  source.write_string("///|\ntest \"measured HQ accounted memory\" {\nlet mut seed = 1951U\nlet alternating = Bytes::makei(1048576, i => { seed = seed * 1664525U + 1013904223U; (32U * ((i / 512) & 7).reinterpret_as_uint() + ((seed >> 24) & 31U)).to_byte() })\nfor (name, input) in [\n")
  for i, file in files {
    let bytes = @fs.read_file(file).binary()
    let name = if i == 0 { "bench_text" } else { "bench_binary" }
    let digest = @hex.encode(Bytes::from_array(@crypto.sha256(bytes)))
    println("INPUT \{name}: \{bytes.length()} bytes, SHA-256 \{digest}")
    source.write_string("(\"\{name}\", @hex.decode((\n")
    let hex = @hex.encode(bytes)
    let mut at = 0
    while at < hex.length() {
      let stop = (at + 1024).min(hex.length())
      source.write_string("\"\{hex[at:stop]}\"\{if stop < hex.length() { " +" } else { "" }}\n")
      at = stop
    }
    source.write_string("))),\n")
  }
  source.write_string("(\"alternating512\", alternating)] {\nfor quality in [10,11] { for window in [22,24] {\nlet p = hq_measure(input, quality, window)\nprintln(\"MEASURE\\t\\{name}\\t\\{input.length()}\\t\\{quality}\\t\\{window}\\t\\{p.bytes}\\t\\{encoder_memory_bound(quality~, window_bits=window)}\\t\\{p.parser}\\t\\{p.blocks}\\t\\{p.clusters}\")\n}}}\n}\n")
  let work = @fs.tmpdir(prefix="brotli-memory.")
  defer @fs.rmdir(work, recursive=true)
  @fs.mkdir("\{work}/brotli", recursive=true)
  @shell.Cmd("cp", ["-a", "brotli/src", "\{work}/brotli/"]).output().check()
  @fs.write_file("\{work}/brotli/moon.mod", @fs.read_file("brotli/moon.mod").text())
  for name in ["codec", "codec_bytes"] {
    @fs.symlink(target=@fs.realpath(name), "\{work}/\{name}")
  }
  @fs.write_file("\{work}/moon.work", "members = [\"brotli\", \"codec\", \"codec_bytes\"]\n")
  @fs.write_file("\{work}/brotli/src/measured_memory_wbtest.mbt", source.to_string())
  let result = @shell.Cmd("moon", ["-C", work, "test", "--target", "native", "brotli/src", "-f", "measured HQ accounted memory"]).output(max_output_bytes=8 << 20)
  println(result.stdout())
  eprintln(result.stderr())
  result.check()
  assert_eq(result.stdout().split("\n").filter(s => s.has_prefix("MEASURE\t")).count(), 12)
}

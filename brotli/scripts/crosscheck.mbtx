----
import {
  "moonbitlang/core/async",
  "moonbitlang/core/async/fs",
  "moonbitlang/core/async/shell",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/encoding/hex",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
  "moonbitlang/x@0.5.6/crypto",
}
----

// Decodes the encoder's streams with the reference decoder, google/brotli's.
//
// Runs src/internal/crosscheck, which prints one line per stream: a name, the
// length and SHA-256 of the input so far, and the base64 of the stream so far.
// Each stream must decode to exactly that input, with Node's zlib (which
// bundles google/brotli) and, when whole, also with the command (a build of
// its own of the same library, separately installed):
// - a whole stream with Node told the input is complete, and with the
//   `brotli -d` command, which fail on a stream that is cut short, corrupt
//   or followed by more bytes;
// - a stream cut after a flush with Node alone, since it must give out
//   everything without being told the end, and the command gives out
//   nothing for a stream without its end. Node is given
//   finishFlush BROTLI_OPERATION_FLUSH: it then runs the decoder over the
//   bytes and returns what it gave out, instead of raising "unexpected end of
//   file" as it does when told that the input is complete. It raises only on
//   corrupt input; a stream that holds back some output decodes to fewer
//   bytes, and the length and SHA-256 catch that.
//
// A line may carry a fifth field, the base64 of the LZ77 dictionary the
// stream needs: both decoders are given it (Node's `dictionary` option and
// `brotli -d -D`).
//
// Byte identity uses the CLI built by reference/cli.mbtx from the pinned,
// hash-checked 1.2.1 source. PATH brotli remains an independent decoder.
//
// Usage, from the repository root (needs the brotli command and node):
//   moon run brotli/scripts/crosscheck.mbtx [-- --target native|js|wasm|wasm-gc] [--compare]
//   --compare  also print the sizes from gzip -6 (the gzip command) and
//              google/brotli (Node's) at qualities 1, 4 and 11 with the same
//              window, for the ratio record; it also needs gzip.
// Exit status: 0 = every stream decodes, 1 = one does not, 2 = setup failure.

///|
/// Decodes each line of stdin (whether the stream was cut after a flush, its
/// base64 and its dictionary's) and prints the length and SHA-256 of what
/// came out, or `error` and why.
let node_decoder : String =
  #|const zlib = require("node:zlib");
  #|const crypto = require("node:crypto");
  #|const lines = require("node:fs").readFileSync(0, "latin1").split("\n");
  #|lines.pop();
  #|for (const line of lines) {
  #|  const [flushed, data, dictionary] = line.split("\t");
  #|  const options = flushed === "1"
  #|    ? { finishFlush: zlib.constants.BROTLI_OPERATION_FLUSH } : {};
  #|  if (dictionary) options.dictionary = Buffer.from(dictionary, "base64");
  #|  try {
  #|    const out = zlib.brotliDecompressSync(Buffer.from(data, "base64"), options);
  #|    const digest = crypto.createHash("sha256").update(out).digest("hex");
  #|    console.log(`${out.length} ${digest}`);
  #|  } catch (err) {
  #|    console.log(`error ${err.message}`);
  #|  }
  #|}

///|
/// Compresses stdin in one call, as an application compressing a buffer
/// would (`brotli -q` reads its input in pieces and may compress worse), at
/// qualities 1, 4 and 11 with the window in argv, and prints the sizes.
let node_encoder : String =
  #|const zlib = require("node:zlib");
  #|const data = require("node:fs").readFileSync(0);
  #|const P = zlib.constants;
  #|const size = quality => zlib.brotliCompressSync(data, { params: {
  #|  [P.BROTLI_PARAM_QUALITY]: quality,
  #|  [P.BROTLI_PARAM_LGWIN]: Number(process.argv[1]),
  #|  [P.BROTLI_PARAM_SIZE_HINT]: data.length,
  #|} }).length;
  #|console.log(`q1 ${size(1)}, q4 ${size(4)}, q11 ${size(11)}`);

///|
/// 1 GiB: more than the crosscheck tool prints and any stream decodes to.
let max_output : Int32 = 1 << 30

///|
fn[T] setup_failure(message : String) -> T {
  eprintln(message)
  @env.exit(2)
}

///|
struct Stream {
  name : String
  size : Int32
  digest : String
  data : Bytes
  /// The LZ77 dictionary the stream needs, or empty.
  dictionary : Bytes
}

///|
/// Where a stream's LZ77 dictionary is written for `brotli -d -D`.
let dict_file : String = "_build/crosscheck-brotli.dict"

///|
fn sha256_hex(data : Bytes) -> String {
  @hex.encode(Bytes::from_array(@crypto.sha256(data)))
}

///|
/// `n / d` with three decimals.
fn ratio(n : Int32, d : Int32) -> String {
  let thousandths = (n.to_int64() * 1000 + (d / 2).to_int64()) / d.to_int64()
  let frac = (thousandths % 1000).to_string()
  "\{thousandths / 1000}.\{"0".repeat(3 - frac.length())}\{frac}"
}

///|
async fn main {
  let mut target = "native"
  let mut compare = false
  let args = @env.args()[1:]
  let mut i = 0
  while i < args.length() {
    match args[i] {
      "--compare" => compare = true
      "--target" if i + 1 < args.length() => {
        target = args[i + 1]
        i += 1
      }
      arg if arg.strip_prefix("--target=") is Some(value) =>
        target = value.to_owned()
      arg => {
        setup_failure(
          "unknown argument \{arg}\nusage: moon run brotli/scripts/crosscheck.mbtx [-- --target native|js|wasm|wasm-gc] [--compare]",
        )
        return
      }
    }
    i += 1
  }
  if !@fs.exists("brotli/moon.mod") {
    setup_failure("run from the repository root")
    return
  }
  let cli = @shell.Cmd("moon", ["run", "brotli/scripts/reference/cli.mbtx"]).output()
  cli.check()
  let reference_cli = cli.stdout().trim().to_owned()
  for
    script in [
      "reference/gen_tables.mbtx", "reference/gen_vectors.mbtx", "reference/gen_hq_tables.mbtx",
      "reference/gen_hq_vectors.mbtx",
      "reference/gen_low_tables.mbtx", "reference/gen_low_vectors.mbtx",
    ] {
    @shell.Cmd("moon", ["run", "brotli/scripts/\{script}", "--check"])
    .output(max_output_bytes=max_output)
    .check()
  }
  @shell.Cmd("moon", ["run", "brotli/scripts/conformance.mbtx", target])
  .output(max_output_bytes=max_output)
  .check()
  for tool in ["brotli", "node"] {
    @shell.Cmd(tool, ["--version"]).output().check() catch {
      _ => {
        setup_failure("crosscheck.mbtx needs the \{tool} command")
        return
      }
    }
  }
  let env = if @env.get_env_var("MOON_CC") is None {
    { "MOON_CC": "cc" }
  } else {
    {}
  }
  let run = @shell.Cmd(
    "moon",
    ["run", "--release", "--target", target, "src/internal/crosscheck"],
    cwd="brotli",
    env~,
  ).output(max_output_bytes=max_output)
  if run.exit_code() != 0 {
    setup_failure(run.stderr())
    return
  }
  let streams = []
  for line in run.stdout().split("\n") {
    if line.is_empty() {
      continue
    }
    let fields = line.split("\t").collect()
    guard fields is [name, size, digest, data, ..] && fields.length() <= 5 else {
      setup_failure("unexpected line from the crosscheck tool: \{line}")
      return
    }
    streams.push({
      name: name.to_owned(),
      size: @string.parse_int(size),
      digest: digest.to_owned(),
      data: @base64.decode(data),
      dictionary: if fields.length() == 5 {
        @base64.decode(fields[4])
      } else {
        b""
      },
    })
  }
  // Every stream through one Node process: a whole one told it is whole, a
  // flushed one decoded as far as it goes.
  let input = StringBuilder()
  for s in streams {
    let flushed = if s.name.contains(" flush ") { "1" } else { "0" }
    input.write_string(
      "\{flushed}\t\{@base64.encode(s.data)}\t\{@base64.encode(s.dictionary)}\n",
    )
  }
  let node = @shell.Cmd(
    "node",
    ["-e", node_decoder],
    stdin=Text(input.to_string()),
  ).output(max_output_bytes=max_output)
  if node.exit_code() != 0 {
    setup_failure("node: \{node.stderr()}")
    return
  }
  let node_results = node.stdout().split("\n").map(l => l.to_owned()).collect()
  if node_results.length() != streams.length() + 1 {
    setup_failure(
      "node answered \{node_results.length() - 1} of \{streams.length()} streams",
    )
    return
  }
  let mut failures = 0
  let mut checked = 0
  let identity_work = @fs.tmpdir(prefix="brotli-quality-crosscheck.")
  defer @fs.remove(identity_work, recursive=true)
  for n, s in streams {
    let result = node_results[n]
    if result.strip_prefix("error ") is Some(err) {
      println("FAIL \{s.name}: node: \{err}")
      failures += 1
      continue
    } else if result != "\{s.size} \{s.digest}" {
      let length = result.split(" ").collect()[0]
      println("FAIL \{s.name}: node decodes it to \{length} different bytes")
      failures += 1
      continue
    }
    if s.name.contains(" flush ") {
      checked += 1
      continue
    }
    let dict_args = if s.dictionary.length() == 0 {
      []
    } else {
      @fs.write_binary(dict_file, s.dictionary)
      ["-D", dict_file]
    }
    let output = @shell.Cmd(
      "brotli",
      ["-d", "-c", ..dict_args],
      stdin=Binary(s.data),
    ).output(max_output_bytes=max_output)
    if output.exit_code() != 0 {
      println("FAIL \{s.name}: \{output.stderr().trim()}")
      failures += 1
      continue
    }
    let decoded = output.stdout_bytes()
    if decoded.length() != s.size || sha256_hex(decoded) != s.digest {
      println("FAIL \{s.name}: decodes to \{decoded.length()} different bytes")
      failures += 1
      continue
    }
    checked += 1
    if s.name.has_prefix("q") &&
      !s.name.contains("dict") &&
      !s.name.contains("flushed") {
      let words = s.name.split(" ").collect()
      let quality = words[0][1:].to_owned()
      let window = s.name.split(" w").collect()[1].split(" ").collect()[0].to_owned()
      let args = ["-q", quality, "-w", window, "-c"]
      let reference = if words[1] == "named" {
        let file = "\{identity_work}/input"
        @fs.write_binary(file, decoded)
        @shell.Cmd(reference_cli, [..args, file]).output(max_output_bytes=max_output)
      } else {
        @shell.Cmd(reference_cli, args, stdin=Binary(decoded)).output(
          max_output_bytes=max_output,
        )
      }
      reference.check()
      if reference.stdout_bytes() != s.data {
        println("FAIL \{s.name}: output differs from brotli 1.2.1")
        failures += 1
      }
    }
    println(
      "ok   \{s.name}: \{s.size} -> \{s.data.length()} bytes (\{ratio(s.data.length(), s.size.max(1))})",
    )
    if compare && !decoded.is_empty() {
      guard s.name.split(" w").collect() is [_, rest, ..] &&
        rest.split(" ").collect() is [bits, ..] else {
        setup_failure("no window in \{s.name}")
        return
      }
      let lgwin = @string.parse_int(bits).max(10).to_string()
      let gzip = @shell.Cmd("gzip", ["-6", "-c", "-n"], stdin=Binary(decoded)).output(
        max_output_bytes=max_output,
      )
      gzip.check()
      let brotli = @shell.Cmd(
        "node",
        ["-e", node_encoder, lgwin],
        stdin=Binary(decoded),
      ).output()
      brotli.check()
      println(
        "       gzip -6 \{gzip.stdout_bytes().length()}, brotli \{brotli.stdout().trim()}",
      )
    }
  }
  if checked == 0 {
    setup_failure("no streams checked")
    return
  }
  let failed = if failures > 0 { ", \{failures} FAILED" } else { "" }
  println(
    "crosscheck: \{checked} streams decode with the reference decoder\{failed}",
  )
  if failures > 0 {
    @env.exit(1)
  }
}

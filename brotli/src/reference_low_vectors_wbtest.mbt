  let input = ref_quality_sample(6, 10000)
  assert_eq(
    @checksum.sha256(input),
    "3c671ccca83909d2434781b7ea317711a900ee13639de2b17b71637bcac0da8b",
  )
  let expected = "2af0bda5d20f5dfa6000c55f3cf13e545c73800f3a81383dd7b082af9bed3f25"
  let encoded = compress(input, quality=1, window_bits=22)
  assert_eq(
    @checksum.sha256(encoded),
    expected,
    msg="q1/kind6/n10000/w22/named",
  )
  assert_eq(decompress(encoded), input)
  let known = encode_drive(
    Encoder(quality=1, window_bits=22, size_hint=input.length().to_int64()),
    input,
    next_in=() => 7919,
    next_out=() => 4096,

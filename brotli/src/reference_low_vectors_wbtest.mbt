      @checksum.sha256(input),
      "e8695b87e2343c6a722bece9375fa344a7fc66e7e331a4815e4ca1f144a97f51",
    )
    let expected = "8b5523acf797647b32d4c33e9d84b596902a168cbbc8cf103a88ab6b01e2e2f8"
    let encoded = compress(input, quality=3, window_bits=10)
    assert_eq(
      @checksum.sha256(encoded),
      expected,
      msg="q3/kind2/n35001/w10/named",
    )
    assert_eq(decompress(encoded), input)
    let known = encode_drive(
      Encoder(quality=3, window_bits=10, size_hint=input.length().to_int64()),
      input,
      next_in=() => 7919,
      next_out=() => 4096,
    )
    assert_eq(known, encoded)
    let unknown = encode_drive(
      Encoder(quality=3, window_bits=10),
      input,
      next_in=() => 7919,
      next_out=() => 4096,
    )
    assert_eq(
      @checksum.sha256(unknown),
      "8b5523acf797647b32d4c33e9d84b596902a168cbbc8cf103a88ab6b01e2e2f8",
      msg="q3/kind2/n35001/w10/stdin",
    )
  }

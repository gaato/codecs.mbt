      "e8695b87e2343c6a722bece9375fa344a7fc66e7e331a4815e4ca1f144a97f51",
    )
    let expected = "8b5523acf797647b32d4c33e9d84b596902a168cbbc8cf103a88ab6b01e2e2f8"
    let encoded = compress(input, quality=3, window_bits=10)
    assert_eq(
      @checksum.sha256(encoded),
      expected,
      msg="q3/kind2/n35001/w10/named",
    )
    assert_eq(decompress(encoded), input)
    let known = encode_drive(
      Encoder(quality=3, window_bits=10, size_hint=input.length().to_int64()),
      input,
      next_in=() => 7919,
      next_out=() => 4096,
    )
    assert_eq(known, encoded)
    let unknown = encode_drive(
      Encoder(quality=3, window_bits=10),
      input,
      next_in=() => 7919,
      next_out=() => 4096,
    )
    assert_eq(
      @checksum.sha256(unknown),
      "8b5523acf797647b32d4c33e9d84b596902a168cbbc8cf103a88ab6b01e2e2f8",
      msg="q3/kind2/n35001/w10/stdin",
    )
  }
  {
    let input = ref_quality_sample(6, 10000)
    assert_eq(
      @checksum.sha256(input),
      "3c671ccca83909d2434781b7ea317711a900ee13639de2b17b71637bcac0da8b",
    )
    let expected = "39965faa472903f207e0bf5eb897a59c9e5152b574bd844abe4d1923bf8168f9"
    let encoded = compress(input, quality=0, window_bits=22)
    assert_eq(
      @checksum.sha256(encoded),
      expected,
      msg="q0/kind6/n10000/w22/named",
    )
    assert_eq(decompress(encoded), input)
    let known = encode_drive(
      Encoder(quality=0, window_bits=22, size_hint=input.length().to_int64()),
      input,
      next_in=() => 7919,
      next_out=() => 4096,
    )
    assert_eq(known, encoded)
    let unknown = encode_drive(
      Encoder(quality=0, window_bits=22),
      input,
      next_in=() => 7919,
      next_out=() => 4096,
    )
    assert_eq(
      @checksum.sha256(unknown),
      "39965faa472903f207e0bf5eb897a59c9e5152b574bd844abe4d1923bf8168f9",
      msg="q0/kind6/n10000/w22/stdin",
    )
  }
  let input = ref_quality_sample(6, 10000)
  assert_eq(
    @checksum.sha256(input),
    "3c671ccca83909d2434781b7ea317711a900ee13639de2b17b71637bcac0da8b",
  )
  let expected = "2af0bda5d20f5dfa6000c55f3cf13e545c73800f3a81383dd7b082af9bed3f25"
  let encoded = compress(input, quality=1, window_bits=22)
  assert_eq(
    @checksum.sha256(encoded),
    expected,
    msg="q1/kind6/n10000/w22/named",
  )
  assert_eq(decompress(encoded), input)
  let known = encode_drive(
    Encoder(quality=1, window_bits=22, size_hint=input.length().to_int64()),
    input,
    next_in=() => 7919,
    next_out=() => 4096,
  )
  assert_eq(known, encoded)
  let unknown = encode_drive(
    Encoder(quality=1, window_bits=22),
    input,
    next_in=() => 7919,
    next_out=() => 4096,
  )
  assert_eq(
    @checksum.sha256(unknown),
    "2af0bda5d20f5dfa6000c55f3cf13e545c73800f3a81383dd7b082af9bed3f25",
    msg="q1/kind6/n10000/w22/stdin",
  )
}

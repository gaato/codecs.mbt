// DO NOT EDIT: generated by brotli/scripts/reference/gen_low_vectors.mbtx.
// SHA-256 of pinned google/brotli 1.2.1, named-file and stdin schedules.

///|
#cfg(target="native")
test "low qualities match pinned CLI in both size hint modes" {
  {
    let input = ref_quality_sample(0, 0)
    assert_eq(
      @checksum.sha256(input),
      "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    )
    let expected = "41b805ea7ac014e23556e98bb374702a08344268f92489a02f0880849394a1e4"
    let encoded = compress(input, quality=0, window_bits=22)
    assert_eq(@checksum.sha256(encoded), expected, msg="q0/kind0/n0/w22/named")
    assert_eq(decompress(encoded), input)
    let known = encode_drive(
      Encoder(quality=0, window_bits=22, size_hint=input.length().to_int64()),
      input,
      next_in=() => 7919,
      next_out=() => 4096,
    )
    assert_eq(known, encoded)
    let unknown = encode_drive(
      Encoder(quality=0, window_bits=22),
      input,
      next_in=() => 7919,
      next_out=() => 4096,
    )
    assert_eq(
      @checksum.sha256(unknown),
      "41b805ea7ac014e23556e98bb374702a08344268f92489a02f0880849394a1e4",
      msg="q0/kind0/n0/w22/stdin",
    )
  }

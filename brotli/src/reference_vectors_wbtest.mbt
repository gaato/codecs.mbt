// DO NOT EDIT: generated by brotli/scripts/reference/gen_vectors.mbtx.
// SHA-256 of google/brotli 1.2.1 CLI outputs with explicit window and size hint modes.

///|
test "reference qualities: pinned CLI bytes in both size hint modes" {
  {
    let input = ref_quality_sample(0, 0)
    assert_eq(
      @checksum.sha256(input),
      "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    )
    let expected = [
      (
        "41b805ea7ac014e23556e98bb374702a08344268f92489a02f0880849394a1e4", "41b805ea7ac014e23556e98bb374702a08344268f92489a02f0880849394a1e4",
      ),
      (
        "41b805ea7ac014e23556e98bb374702a08344268f92489a02f0880849394a1e4", "41b805ea7ac014e23556e98bb374702a08344268f92489a02f0880849394a1e4",
      ),
      (
        "41b805ea7ac014e23556e98bb374702a08344268f92489a02f0880849394a1e4", "41b805ea7ac014e23556e98bb374702a08344268f92489a02f0880849394a1e4",
      ),
      (
        "41b805ea7ac014e23556e98bb374702a08344268f92489a02f0880849394a1e4", "41b805ea7ac014e23556e98bb374702a08344268f92489a02f0880849394a1e4",
      ),
      (
        "41b805ea7ac014e23556e98bb374702a08344268f92489a02f0880849394a1e4", "41b805ea7ac014e23556e98bb374702a08344268f92489a02f0880849394a1e4",
      ),
    ]
    for quality in 5..<=9 {
      let (named, stdin) = expected[quality - 5]
      let encoded = compress(input, quality~, window_bits=22)
      assert_eq(
        @checksum.sha256(encoded),
        named,
        msg="kind0/size0/w22/named/q\{quality}",
      )
      assert_eq(decompress(encoded), input)
      let known = encode_drive(
        Encoder(quality~, window_bits=22, size_hint=input.length().to_int64()),
        input,
        next_in=() => 7919,
        next_out=() => 4096,
      )
      assert_eq(known, encoded)
      let unknown = encode_drive(
        Encoder(quality~, window_bits=22),
        input,
        next_in=() => 7919,
        next_out=() => 4096,
      )
      assert_eq(
        @checksum.sha256(unknown),
        stdin,
        msg="kind0/size0/w22/stdin/q\{quality}",
      )
    }
  }

// DO NOT EDIT: generated by brotli/scripts/reference/gen_hq_tables.mbtx.
// SHA-256 of the pinned reference's little-endian lookup values.

///|
test "HQ dictionary tables match the pinned reference" {
  let buckets = hq_dict_buckets()
  let words = hq_dict_words()
  assert_eq(
    @checksum.sha256(
      Bytes::makei(2 * buckets.length(), i => {
        ((buckets[i / 2].to_int() >> (8 * (i % 2))) & 255).to_byte()
      }),
    ),
    "7b6539ba4c302b1ebc592faec82fbf0c1f6530f7d143db3f411c1ee666958077",
  )
  assert_eq(
    @checksum.sha256(
      Bytes::makei(4 * words.length(), i => {
        ((words[i / 4] >> (8 * (i % 4))) & 255U).to_byte()
      }),
    ),
    "0b553e04dcf6c5371875a40b54ac4115dd450f2b0cef444a16c8531d4c49f891",
  )
}

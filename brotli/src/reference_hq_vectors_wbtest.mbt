    let hint = Some(input.length().to_int64())
    let encoded = encode_drive(
      Encoder(quality~, window_bits=24, size_hint?=hint),
      input,
      next_in=() => 8192,
      next_out=() => 4096,
    )
    assert_eq(
      @checksum.sha256(encoded),
      named,
      msg="kind2/size8192/w24/named/q\{quality}",
    )
    assert_eq(decompress(encoded), input)
    assert_eq(compress(input, quality~, window_bits=24), encoded)
    let unknown = encode_drive(
      Encoder(quality~, window_bits=24),
      input,
      next_in=() => 8192,
      next_out=() => 4096,
    )
    assert_eq(
      @checksum.sha256(unknown),
      stdin,
      msg="kind2/size8192/w24/stdin/q\{quality}",
    )
  }
}


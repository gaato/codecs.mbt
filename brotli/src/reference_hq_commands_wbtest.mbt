///|
fn hq_check_commands(
  input : Bytes,
  quality : Int32,
  window : Int32,
  expected : String,
) -> Unit raise {
  let encoder = Encoder(quality=9, window_bits=window)
  encoder.data = FixedArray::make(input.length() + 128, b'\x00')
  for i in 0..<input.length() {
    encoder.data[i] = input[i]
  }
  encoder.data_len = input.length()
  let tree = HqTree::new(window, input.length(), true)
  tree.stitch(encoder.data, 0, 0U, input.length())
  encoder.hq_parse(tree, quality, 0, input.length(), 0U)
  let commands = encoder.ref_commands.unwrap()
  if encoder.ref_insert > 0 {
    commands.push(RefCommand::new(encoder.ref_insert, 0, 4, 16))
  }
  let trace = StringBuilder()
  for c in commands {
    trace.write_string(
      "\{c.insert} \{c.copy} \{c.copy_code} \{c.raw_distance} \{c.symbol}\n",
    )
  }
  assert_eq(trace.to_string(), expected)
  assert_true(tree.memory_usage() >= 4 * (1 << 17))
}

// The vocabulary every kind of codec in the workspace reports in: error kinds,
// and the limits a stream can exceed. Types only, so that depending on it
// costs nothing.

name = "gaato/codec"

version = "0.1.0"

license = "Apache-2.0"

readme = "README.md"

repository = "https://github.com/gaato/codecs.mbt"

keywords = [ "codec", "compression", "streaming", "errors" ]

description = "Error kinds and limits shared by the streaming codecs of gaato/codecs.mbt."

source = "src"

preferred_target = "native"

// Prefix codes: for encoders, length-limited Huffman code lengths and the
// canonical codes they define; for decoders, the tables that decode them.
// DEFLATE and Brotli use both. `moon prove` checks the functions with
// contracts (the PROOFS.md of the modules that copy this package).

import {
  "gaato/codec_parts/proof_bits",
  "gaato/codec_parts/proof_codes",
}

proof_enabled = true

supported_targets = "js + native + wasm + wasm-gc"

///|
fn of_bits_11(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
  b9 : Int32,
  b10 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1 &&
  0 <= b9 &&
  b9 <= 1 &&
  0 <= b10 &&
  b10 <= 1,
  proof_ensure: @proof_codes.rev(
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9 +
    1024 * b10,
    11,
  ) ==
  1024 * b0 +
  512 * b1 +
  256 * b2 +
  128 * b3 +
  64 * b4 +
  32 * b5 +
  16 * b6 +
  8 * b7 +
  4 * b8 +
  2 * b9 +
  1 * b10,
} {
  bit_11_0(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10)
  bit_11_1(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10)
  bit_11_2(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10)
  bit_11_3(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10)
  bit_11_4(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10)
  bit_11_5(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10)
  bit_11_6(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10)
  bit_11_7(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10)
  bit_11_8(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10)
  bit_11_9(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10)
  bit_11_10(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10)
}

///|
fn involution_11(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 2048,
  proof_ensure: @proof_codes.rev(@proof_codes.rev(c, 11), 11) == c,
} {
  bits_11(c)
  proof_assert @proof_codes.rev(c, 11) ==
    1 * (c / 1024 % 2) +
    2 * (c / 512 % 2) +
    4 * (c / 256 % 2) +
    8 * (c / 128 % 2) +
    16 * (c / 64 % 2) +
    32 * (c / 32 % 2) +
    64 * (c / 16 % 2) +
    128 * (c / 8 % 2) +
    256 * (c / 4 % 2) +
    512 * (c / 2 % 2) +
    1024 * (c / 1 % 2)
  of_bits_11(
    c / 1024 % 2,
    c / 512 % 2,
    c / 256 % 2,
    c / 128 % 2,
    c / 64 % 2,
    c / 32 % 2,
    c / 16 % 2,
    c / 8 % 2,
    c / 4 % 2,
    c / 2 % 2,
    c / 1 % 2,
  )
}

///|
fn bits_12(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 4096,
  proof_ensure: c ==
  1 * (c / 1 % 2) +
  2 * (c / 2 % 2) +
  4 * (c / 4 % 2) +
  8 * (c / 8 % 2) +
  16 * (c / 16 % 2) +
  32 * (c / 32 % 2) +
  64 * (c / 64 % 2) +
  128 * (c / 128 % 2) +
  256 * (c / 256 % 2) +
  512 * (c / 512 % 2) +
  1024 * (c / 1024 % 2) +
  2048 * (c / 2048 % 2),
} {
  halve_0(c)
  halve_1(c)
  halve_2(c)
  halve_3(c)
  halve_4(c)
  halve_5(c)
  halve_6(c)
  halve_7(c)
  halve_8(c)
  halve_9(c)
  halve_10(c)
  halve_11(c)
  proof_assert c / 4096 == 0
}

///|
fn bit_12_0(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
  b9 : Int32,
  b10 : Int32,
  b11 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1 &&
  0 <= b9 &&
  b9 <= 1 &&
  0 <= b10 &&
  b10 <= 1 &&
  0 <= b11 &&
  b11 <= 1,
  proof_ensure: (
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9 +
    1024 * b10 +
    2048 * b11
  ) /
  1 %
  2 ==
  b0,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9 +
    1024 * b10 +
    2048 * b11 ==
    2 *
    (
      1 * b1 +
      2 * b2 +
      4 * b3 +
      8 * b4 +
      16 * b5 +
      32 * b6 +
      64 * b7 +
      128 * b8 +
      256 * b9 +
      512 * b10 +
      1024 * b11
    ) +
    1 * b0 +
    0
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8 +
      512 * b9 +
      1024 * b10 +
      2048 * b11
    ) /
    1 ==
    2 *
    (
      1 * b1 +
      2 * b2 +
      4 * b3 +
      8 * b4 +
      16 * b5 +
      32 * b6 +
      64 * b7 +
      128 * b8 +
      256 * b9 +
      512 * b10 +
      1024 * b11
    ) +
    b0
}

///|
fn bit_12_1(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
  b9 : Int32,
  b10 : Int32,

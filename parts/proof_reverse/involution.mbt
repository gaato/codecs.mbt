      4 * b4 +
      8 * b5 +
      16 * b6 +
      32 * b7 +
      64 * b8 +
      128 * b9 +
      256 * b10
    ) +
    2 * b1 +
    1 * b0
  proof_assert 1 * b0 < 2
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8 +
      512 * b9 +
      1024 * b10
    ) /
    2 ==
    2 *
    (
      1 * b2 +
      2 * b3 +
      4 * b4 +
      8 * b5 +
      16 * b6 +
      32 * b7 +
      64 * b8 +
      128 * b9 +

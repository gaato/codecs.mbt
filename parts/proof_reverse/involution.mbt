      4 * b5 +
      8 * b6 +
      16 * b7 +
      32 * b8 +
      64 * b9 +
      128 * b10
    ) +
    4 * b2 +
    (1 * b0 + 2 * b1)
  proof_assert 1 * b0 + 2 * b1 < 4
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8 +
      512 * b9 +
      1024 * b10
    ) /
    4 ==
    2 *
    (
      1 * b3 +
      2 * b4 +
      4 * b5 +
      8 * b6 +
      16 * b7 +
      32 * b8 +
      64 * b9 +
      128 * b10
    ) +

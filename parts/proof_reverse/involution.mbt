///|
fn of_bits_14(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
  b9 : Int32,
  b10 : Int32,
  b11 : Int32,
  b12 : Int32,
  b13 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1 &&
  0 <= b9 &&
  b9 <= 1 &&
  0 <= b10 &&
  b10 <= 1 &&
  0 <= b11 &&
  b11 <= 1 &&
  0 <= b12 &&
  b12 <= 1 &&
  0 <= b13 &&
  b13 <= 1,
  proof_ensure: @proof_codes.rev(
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9 +
    1024 * b10 +
    2048 * b11 +
    4096 * b12 +
    8192 * b13,
    14,
  ) ==
  8192 * b0 +
  4096 * b1 +
  2048 * b2 +
  1024 * b3 +
  512 * b4 +
  256 * b5 +
  128 * b6 +
  64 * b7 +
  32 * b8 +
  16 * b9 +
  8 * b10 +
  4 * b11 +
  2 * b12 +
  1 * b13,
} {
  bit_14_0(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13)
  bit_14_1(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13)
  bit_14_2(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13)
  bit_14_3(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13)
  bit_14_4(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13)
  bit_14_5(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13)
  bit_14_6(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13)
  bit_14_7(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13)
  bit_14_8(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13)
  bit_14_9(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13)
  bit_14_10(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13)
  bit_14_11(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13)
  bit_14_12(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13)
  bit_14_13(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13)
}

///|
fn involution_14(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 16384,
  proof_ensure: @proof_codes.rev(@proof_codes.rev(c, 14), 14) == c,
} {
  bits_14(c)
  proof_assert @proof_codes.rev(c, 14) ==
    1 * (c / 8192 % 2) +
    2 * (c / 4096 % 2) +
    4 * (c / 2048 % 2) +
    8 * (c / 1024 % 2) +
    16 * (c / 512 % 2) +
    32 * (c / 256 % 2) +
    64 * (c / 128 % 2) +
    128 * (c / 64 % 2) +
    256 * (c / 32 % 2) +
    512 * (c / 16 % 2) +
    1024 * (c / 8 % 2) +
    2048 * (c / 4 % 2) +
    4096 * (c / 2 % 2) +
    8192 * (c / 1 % 2)
  of_bits_14(
    c / 8192 % 2,
    c / 4096 % 2,
    c / 2048 % 2,
    c / 1024 % 2,
    c / 512 % 2,
    c / 256 % 2,
    c / 128 % 2,
    c / 64 % 2,
    c / 32 % 2,
    c / 16 % 2,
    c / 8 % 2,
    c / 4 % 2,
    c / 2 % 2,
    c / 1 % 2,
  )
}

///|
fn bits_15(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 32768,
  proof_ensure: c ==
  1 * (c / 1 % 2) +
  2 * (c / 2 % 2) +
  4 * (c / 4 % 2) +
  8 * (c / 8 % 2) +
  16 * (c / 16 % 2) +
  32 * (c / 32 % 2) +
  64 * (c / 64 % 2) +
  128 * (c / 128 % 2) +
  256 * (c / 256 % 2) +
  512 * (c / 512 % 2) +
  1024 * (c / 1024 % 2) +
  2048 * (c / 2048 % 2) +
  4096 * (c / 4096 % 2) +
  8192 * (c / 8192 % 2) +
  16384 * (c / 16384 % 2),
} {
  halve_0(c)
  halve_1(c)
  halve_2(c)
  halve_3(c)
  halve_4(c)
  halve_5(c)
  halve_6(c)
  halve_7(c)
  halve_8(c)
  halve_9(c)
  halve_10(c)
  halve_11(c)
  halve_12(c)
  halve_13(c)
  halve_14(c)
  proof_assert c / 32768 == 0
}


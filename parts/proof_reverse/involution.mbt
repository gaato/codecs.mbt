      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8 +
      512 * b9
    ) /
    256 ==
    2 * (1 * b9) + b8
}

///|
fn bit_10_9(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
  b9 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1 &&
  0 <= b9 &&
  b9 <= 1,
  proof_ensure: (
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9
  ) /
  512 %
  2 ==
  b9,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9 ==
    1024 * 0 +
    512 * b9 +
    (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8
    )
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 <
    512
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8 +
      512 * b9
    ) /
    512 ==
    2 * 0 + b9
}

///|
fn of_bits_10(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
  b9 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1 &&
  0 <= b9 &&
  b9 <= 1,
  proof_ensure: @proof_codes.rev(
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9,
    10,
  ) ==
  512 * b0 +
  256 * b1 +
  128 * b2 +
  64 * b3 +
  32 * b4 +
  16 * b5 +
  8 * b6 +
  4 * b7 +
  2 * b8 +
  1 * b9,
} {
  bit_10_0(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9)
  bit_10_1(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9)
  bit_10_2(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9)
  bit_10_3(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9)
  bit_10_4(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9)
  bit_10_5(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9)
  bit_10_6(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9)
  bit_10_7(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9)
  bit_10_8(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9)
  bit_10_9(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9)
}

///|
fn involution_10(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 1024,
  proof_ensure: @proof_codes.rev(@proof_codes.rev(c, 10), 10) == c,
} {
  bits_10(c)
  proof_assert @proof_codes.rev(c, 10) ==
    1 * (c / 512 % 2) +
    2 * (c / 256 % 2) +
    4 * (c / 128 % 2) +
    8 * (c / 64 % 2) +
    16 * (c / 32 % 2) +
    32 * (c / 16 % 2) +
    64 * (c / 8 % 2) +
    128 * (c / 4 % 2) +
    256 * (c / 2 % 2) +
    512 * (c / 1 % 2)
  of_bits_10(
    c / 512 % 2,
    c / 256 % 2,
    c / 128 % 2,
    c / 64 % 2,
    c / 32 % 2,
    c / 16 % 2,
    c / 8 % 2,
    c / 4 % 2,
    c / 2 % 2,
    c / 1 % 2,
  )
}

///|
fn bits_11(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 2048,
  proof_ensure: c ==
  1 * (c / 1 % 2) +
  2 * (c / 2 % 2) +
  4 * (c / 4 % 2) +
  8 * (c / 8 % 2) +
  16 * (c / 16 % 2) +
  32 * (c / 32 % 2) +
  64 * (c / 64 % 2) +
  128 * (c / 128 % 2) +
  256 * (c / 256 % 2) +
  512 * (c / 512 % 2) +
  1024 * (c / 1024 % 2),
} {
  halve_0(c)
  halve_1(c)
  halve_2(c)
  halve_3(c)
  halve_4(c)
  halve_5(c)
  halve_6(c)
  halve_7(c)
  halve_8(c)
  halve_9(c)
  halve_10(c)
  proof_assert c / 2048 == 0
}

///|
fn bit_11_0(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,

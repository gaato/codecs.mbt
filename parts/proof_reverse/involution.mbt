  16 * b10 +
  8 * b11 +
  4 * b12 +
  2 * b13 +
  1 * b14,
} {
  bit_15_0(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14)
  bit_15_1(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14)
  bit_15_2(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14)
  bit_15_3(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14)
  bit_15_4(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14)
  bit_15_5(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14)
  bit_15_6(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14)
  bit_15_7(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14)
  bit_15_8(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14)
  bit_15_9(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14)
  bit_15_10(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14)
  bit_15_11(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14)
  bit_15_12(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14)
  bit_15_13(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14)
  bit_15_14(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14)
}

///|
fn involution_15(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 32768,
  proof_ensure: @proof_codes.rev(@proof_codes.rev(c, 15), 15) == c,
} {
  bits_15(c)
  proof_assert @proof_codes.rev(c, 15) ==
    1 * (c / 16384 % 2) +
    2 * (c / 8192 % 2) +
    4 * (c / 4096 % 2) +
    8 * (c / 2048 % 2) +
    16 * (c / 1024 % 2) +
    32 * (c / 512 % 2) +
    64 * (c / 256 % 2) +
    128 * (c / 128 % 2) +
    256 * (c / 64 % 2) +
    512 * (c / 32 % 2) +
    1024 * (c / 16 % 2) +
    2048 * (c / 8 % 2) +
    4096 * (c / 4 % 2) +
    8192 * (c / 2 % 2) +
    16384 * (c / 1 % 2)
  of_bits_15(
    c / 16384 % 2,
    c / 8192 % 2,
    c / 4096 % 2,
    c / 2048 % 2,
    c / 1024 % 2,
    c / 512 % 2,
    c / 256 % 2,
    c / 128 % 2,
    c / 64 % 2,
    c / 32 % 2,
    c / 16 % 2,
    c / 8 % 2,
    c / 4 % 2,
    c / 2 % 2,
    c / 1 % 2,
  )
}

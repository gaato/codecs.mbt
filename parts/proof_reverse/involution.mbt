) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1 &&
  0 <= b9 &&
  b9 <= 1 &&
  0 <= b10 &&
  b10 <= 1 &&
  0 <= b11 &&
  b11 <= 1,
  proof_ensure: (
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9 +
    1024 * b10 +
    2048 * b11
  ) /
  2 %
  2 ==
  b1,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9 +
    1024 * b10 +
    2048 * b11 ==
    4 *
    (
      1 * b2 +
      2 * b3 +
      4 * b4 +
      8 * b5 +
      16 * b6 +
      32 * b7 +
      64 * b8 +
      128 * b9 +
      256 * b10 +
      512 * b11
    ) +
    2 * b1 +
    1 * b0
  proof_assert 1 * b0 < 2
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8 +
      512 * b9 +
      1024 * b10 +
      2048 * b11
    ) /
    2 ==
    2 *
    (
      1 * b2 +
      2 * b3 +
      4 * b4 +
      8 * b5 +
      16 * b6 +
      32 * b7 +
      64 * b8 +
      128 * b9 +
      256 * b10 +
      512 * b11
    ) +
    b1
}

///|
fn bit_12_2(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
  b9 : Int32,
  b10 : Int32,
  b11 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&

    8 * b3 +
    (1 * b0 + 2 * b1 + 4 * b2)
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 < 8
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8 +

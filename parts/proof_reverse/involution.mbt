  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
  b9 : Int32,
  b10 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1 &&
  0 <= b9 &&
  b9 <= 1 &&
  0 <= b10 &&
  b10 <= 1,
  proof_ensure: (
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9 +
    1024 * b10
  ) /
  1 %
  2 ==
  b0,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9 +
    1024 * b10 ==
    2 *
    (
      1 * b1 +
      2 * b2 +
      4 * b3 +
      8 * b4 +
      16 * b5 +
      32 * b6 +
      64 * b7 +
      128 * b8 +
      256 * b9 +
      512 * b10
    ) +
    1 * b0 +
    0
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8 +
      512 * b9 +
      1024 * b10
    ) /
    1 ==
    2 *
    (
      1 * b1 +
      2 * b2 +
      4 * b3 +
      8 * b4 +
      16 * b5 +
      32 * b6 +
      64 * b7 +
      128 * b8 +
      256 * b9 +
      512 * b10
    ) +
    b0
}

///|
fn bit_11_1(

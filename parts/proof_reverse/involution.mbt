  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1 &&
  0 <= b9 &&
  b9 <= 1,
  proof_ensure: (
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9
  ) /
  8 %
  2 ==
  b3,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9 ==
    16 * (1 * b4 + 2 * b5 + 4 * b6 + 8 * b7 + 16 * b8 + 32 * b9) +
    8 * b3 +
    (1 * b0 + 2 * b1 + 4 * b2)
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 < 8
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8 +
      512 * b9
    ) /
    8 ==
    2 * (1 * b4 + 2 * b5 + 4 * b6 + 8 * b7 + 16 * b8 + 32 * b9) + b3
}


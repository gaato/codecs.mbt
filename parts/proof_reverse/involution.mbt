  2 ==
  b5,
} {
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 ==
    64 * (1 * b6) + 32 * b5 + (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4)
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 < 32
  proof_assert (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6) /
    32 ==
    2 * (1 * b6) + b5
}

///|
fn bit_7_6(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1,
  proof_ensure: (
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6
  ) /
  64 %
  2 ==
  b6,
} {
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 ==
    128 * 0 + 64 * b6 + (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5)
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 < 64
  proof_assert (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6) /
    64 ==
    2 * 0 + b6
}

///|
fn of_bits_7(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1,
  proof_ensure: @proof_codes.rev(
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6,
    7,
  ) ==
  64 * b0 + 32 * b1 + 16 * b2 + 8 * b3 + 4 * b4 + 2 * b5 + 1 * b6,
} {
  bit_7_0(b0, b1, b2, b3, b4, b5, b6)
  bit_7_1(b0, b1, b2, b3, b4, b5, b6)
  bit_7_2(b0, b1, b2, b3, b4, b5, b6)
  bit_7_3(b0, b1, b2, b3, b4, b5, b6)
  bit_7_4(b0, b1, b2, b3, b4, b5, b6)
  bit_7_5(b0, b1, b2, b3, b4, b5, b6)
  bit_7_6(b0, b1, b2, b3, b4, b5, b6)
}

///|
fn involution_7(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 128,
  proof_ensure: @proof_codes.rev(@proof_codes.rev(c, 7), 7) == c,
} {
  bits_7(c)
  proof_assert @proof_codes.rev(c, 7) ==
    1 * (c / 64 % 2) +
    2 * (c / 32 % 2) +
    4 * (c / 16 % 2) +
    8 * (c / 8 % 2) +
    16 * (c / 4 % 2) +
    32 * (c / 2 % 2) +
    64 * (c / 1 % 2)
  of_bits_7(
    c / 64 % 2,
    c / 32 % 2,
    c / 16 % 2,
    c / 8 % 2,
    c / 4 % 2,
    c / 2 % 2,
    c / 1 % 2,
  )
}

///|
fn bits_8(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 256,
  proof_ensure: c ==
  1 * (c / 1 % 2) +
  2 * (c / 2 % 2) +
  4 * (c / 4 % 2) +
  8 * (c / 8 % 2) +
  16 * (c / 16 % 2) +
  32 * (c / 32 % 2) +
  64 * (c / 64 % 2) +
  128 * (c / 128 % 2),
} {
  halve_0(c)
  halve_1(c)
  halve_2(c)
  halve_3(c)
  halve_4(c)
  halve_5(c)
  halve_6(c)
  halve_7(c)
  proof_assert c / 256 == 0
}

///|
fn bit_8_0(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1,
  proof_ensure: (
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7
  ) /
  1 %
  2 ==
  b0,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 ==
    2 * (1 * b1 + 2 * b2 + 4 * b3 + 8 * b4 + 16 * b5 + 32 * b6 + 64 * b7) +
    1 * b0 +
    0
  proof_assert (
      1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7
    ) /
    1 ==
    2 * (1 * b1 + 2 * b2 + 4 * b3 + 8 * b4 + 16 * b5 + 32 * b6 + 64 * b7) + b0
}

///|
fn bit_8_1(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1,
  proof_ensure: (
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7
  ) /
  2 %
  2 ==
  b1,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 ==
    4 * (1 * b2 + 2 * b3 + 4 * b4 + 8 * b5 + 16 * b6 + 32 * b7) +
    2 * b1 +
    1 * b0
  proof_assert 1 * b0 < 2
  proof_assert (
      1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7
    ) /
    2 ==
    2 * (1 * b2 + 2 * b3 + 4 * b4 + 8 * b5 + 16 * b6 + 32 * b7) + b1
}

///|
fn bit_8_2(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1,
  proof_ensure: (
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7
  ) /
  4 %
  2 ==
  b2,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 ==
    8 * (1 * b3 + 2 * b4 + 4 * b5 + 8 * b6 + 16 * b7) +
    4 * b2 +
    (1 * b0 + 2 * b1)
  proof_assert 1 * b0 + 2 * b1 < 4
  proof_assert (
      1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7
    ) /
    4 ==
    2 * (1 * b3 + 2 * b4 + 4 * b5 + 8 * b6 + 16 * b7) + b2
}

///|
fn bit_8_3(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1,
  proof_ensure: (
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7
  ) /
  8 %
  2 ==
  b3,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 ==
    16 * (1 * b4 + 2 * b5 + 4 * b6 + 8 * b7) +
    8 * b3 +
    (1 * b0 + 2 * b1 + 4 * b2)
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 < 8
  proof_assert (
      1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7
    ) /
    8 ==
    2 * (1 * b4 + 2 * b5 + 4 * b6 + 8 * b7) + b3
}

///|
fn bit_8_4(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1,
  proof_ensure: (
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7
  ) /
  16 %
  2 ==
  b4,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 ==
    32 * (1 * b5 + 2 * b6 + 4 * b7) +
    16 * b4 +
    (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3)
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 < 16
  proof_assert (
      1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7
    ) /
    16 ==
    2 * (1 * b5 + 2 * b6 + 4 * b7) + b4
}

///|
fn bit_8_5(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1,
  proof_ensure: (
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7
  ) /
  32 %
  2 ==
  b5,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 ==
    64 * (1 * b6 + 2 * b7) +
    32 * b5 +
    (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4)
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 < 32
  proof_assert (
      1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7
    ) /
    32 ==
    2 * (1 * b6 + 2 * b7) + b5
}

///|
fn bit_8_6(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1,
  proof_ensure: (
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7
  ) /
  64 %
  2 ==
  b6,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 ==
    128 * (1 * b7) +
    64 * b6 +
    (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5)
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 < 64
  proof_assert (
      1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7
    ) /
    64 ==
    2 * (1 * b7) + b6
}

///|
fn bit_8_7(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1,
  proof_ensure: (
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7
  ) /
  128 %
  2 ==
  b7,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 ==
    256 * 0 +
    128 * b7 +
    (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6)
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 <
    128
  proof_assert (
      1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7
    ) /
    128 ==
    2 * 0 + b7
}

///|
fn of_bits_8(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1,
  proof_ensure: @proof_codes.rev(
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7,
    8,
  ) ==
  128 * b0 + 64 * b1 + 32 * b2 + 16 * b3 + 8 * b4 + 4 * b5 + 2 * b6 + 1 * b7,
} {
  bit_8_0(b0, b1, b2, b3, b4, b5, b6, b7)
  bit_8_1(b0, b1, b2, b3, b4, b5, b6, b7)
  bit_8_2(b0, b1, b2, b3, b4, b5, b6, b7)
  bit_8_3(b0, b1, b2, b3, b4, b5, b6, b7)
  bit_8_4(b0, b1, b2, b3, b4, b5, b6, b7)
  bit_8_5(b0, b1, b2, b3, b4, b5, b6, b7)
  bit_8_6(b0, b1, b2, b3, b4, b5, b6, b7)
  bit_8_7(b0, b1, b2, b3, b4, b5, b6, b7)
}

///|
fn involution_8(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 256,
  proof_ensure: @proof_codes.rev(@proof_codes.rev(c, 8), 8) == c,
} {
  bits_8(c)
  proof_assert @proof_codes.rev(c, 8) ==
    1 * (c / 128 % 2) +
    2 * (c / 64 % 2) +
    4 * (c / 32 % 2) +
    8 * (c / 16 % 2) +
    16 * (c / 8 % 2) +
    32 * (c / 4 % 2) +
    64 * (c / 2 % 2) +
    128 * (c / 1 % 2)
  of_bits_8(
    c / 128 % 2,
    c / 64 % 2,
    c / 32 % 2,
    c / 16 % 2,
    c / 8 % 2,
    c / 4 % 2,
    c / 2 % 2,
    c / 1 % 2,
  )
}

///|
fn bits_9(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 512,
  proof_ensure: c ==
  1 * (c / 1 % 2) +
  2 * (c / 2 % 2) +
  4 * (c / 4 % 2) +
  8 * (c / 8 % 2) +
  16 * (c / 16 % 2) +
  32 * (c / 32 % 2) +
  64 * (c / 64 % 2) +
  128 * (c / 128 % 2) +
  256 * (c / 256 % 2),
} {
  halve_0(c)
  halve_1(c)
  halve_2(c)
  halve_3(c)
  halve_4(c)
  halve_5(c)
  halve_6(c)
  halve_7(c)
  halve_8(c)
  proof_assert c / 512 == 0
}

///|
fn bit_9_0(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1,
  proof_ensure: (
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8
  ) /
  1 %
  2 ==
  b0,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 ==
    2 *
    (1 * b1 + 2 * b2 + 4 * b3 + 8 * b4 + 16 * b5 + 32 * b6 + 64 * b7 + 128 * b8) +
    1 * b0 +
    0
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8
    ) /
    1 ==
    2 *
    (1 * b1 + 2 * b2 + 4 * b3 + 8 * b4 + 16 * b5 + 32 * b6 + 64 * b7 + 128 * b8) +
    b0
}

///|
fn bit_9_1(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1,
  proof_ensure: (
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8
  ) /
  2 %
  2 ==
  b1,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 ==
    4 * (1 * b2 + 2 * b3 + 4 * b4 + 8 * b5 + 16 * b6 + 32 * b7 + 64 * b8) +
    2 * b1 +
    1 * b0
  proof_assert 1 * b0 < 2
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8
    ) /
    2 ==
    2 * (1 * b2 + 2 * b3 + 4 * b4 + 8 * b5 + 16 * b6 + 32 * b7 + 64 * b8) + b1
}


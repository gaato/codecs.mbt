///|
fn bit_9_8(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1,
  proof_ensure: (
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8
  ) /
  256 %
  2 ==
  b8,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 ==
    512 * 0 +
    256 * b8 +
    (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 + 128 * b7)
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 <
    256
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8
    ) /
    256 ==
    2 * 0 + b8
}

///|
fn of_bits_9(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1,
  proof_ensure: @proof_codes.rev(
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8,
    9,
  ) ==
  256 * b0 +
  128 * b1 +
  64 * b2 +
  32 * b3 +
  16 * b4 +
  8 * b5 +
  4 * b6 +
  2 * b7 +
  1 * b8,
} {
  bit_9_0(b0, b1, b2, b3, b4, b5, b6, b7, b8)
  bit_9_1(b0, b1, b2, b3, b4, b5, b6, b7, b8)
  bit_9_2(b0, b1, b2, b3, b4, b5, b6, b7, b8)
  bit_9_3(b0, b1, b2, b3, b4, b5, b6, b7, b8)
  bit_9_4(b0, b1, b2, b3, b4, b5, b6, b7, b8)
  bit_9_5(b0, b1, b2, b3, b4, b5, b6, b7, b8)
  bit_9_6(b0, b1, b2, b3, b4, b5, b6, b7, b8)
  bit_9_7(b0, b1, b2, b3, b4, b5, b6, b7, b8)
  bit_9_8(b0, b1, b2, b3, b4, b5, b6, b7, b8)
}

///|
fn involution_9(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 512,
  proof_ensure: @proof_codes.rev(@proof_codes.rev(c, 9), 9) == c,
} {
  bits_9(c)
  proof_assert @proof_codes.rev(c, 9) ==
    1 * (c / 256 % 2) +
    2 * (c / 128 % 2) +
    4 * (c / 64 % 2) +
    8 * (c / 32 % 2) +
    16 * (c / 16 % 2) +
    32 * (c / 8 % 2) +
    64 * (c / 4 % 2) +
    128 * (c / 2 % 2) +
    256 * (c / 1 % 2)
  of_bits_9(
    c / 256 % 2,
    c / 128 % 2,
    c / 64 % 2,
    c / 32 % 2,
    c / 16 % 2,
    c / 8 % 2,
    c / 4 % 2,
    c / 2 % 2,
    c / 1 % 2,
  )
}

///|
fn bits_10(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 1024,
  proof_ensure: c ==
  1 * (c / 1 % 2) +
  2 * (c / 2 % 2) +
  4 * (c / 4 % 2) +
  8 * (c / 8 % 2) +
  16 * (c / 16 % 2) +
  32 * (c / 32 % 2) +
  64 * (c / 64 % 2) +
  128 * (c / 128 % 2) +
  256 * (c / 256 % 2) +
  512 * (c / 512 % 2),
} {
  halve_0(c)
  halve_1(c)
  halve_2(c)
  halve_3(c)
  halve_4(c)
  halve_5(c)
  halve_6(c)
  halve_7(c)
  halve_8(c)
  halve_9(c)
  proof_assert c / 1024 == 0
}

///|
fn bit_10_0(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
  b9 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1 &&
  0 <= b9 &&
  b9 <= 1,
  proof_ensure: (
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9
  ) /
  1 %
  2 ==
  b0,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9 ==
    2 *
    (
      1 * b1 +
      2 * b2 +
      4 * b3 +
      8 * b4 +
      16 * b5 +
      32 * b6 +
      64 * b7 +
      128 * b8 +
      256 * b9
    ) +
    1 * b0 +
    0
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8 +
      512 * b9
    ) /
    1 ==
    2 *
    (
      1 * b1 +
      2 * b2 +
      4 * b3 +
      8 * b4 +
      16 * b5 +
      32 * b6 +
      64 * b7 +
      128 * b8 +
      256 * b9
    ) +
    b0
}

///|
fn bit_10_1(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
  b9 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1 &&
  0 <= b9 &&
  b9 <= 1,
  proof_ensure: (
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9
  ) /
  2 %
  2 ==
  b1,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9 ==
    4 *
    (1 * b2 + 2 * b3 + 4 * b4 + 8 * b5 + 16 * b6 + 32 * b7 + 64 * b8 + 128 * b9) +
    2 * b1 +
    1 * b0
  proof_assert 1 * b0 < 2
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8 +
      512 * b9
    ) /
    2 ==
    2 *
    (1 * b2 + 2 * b3 + 4 * b4 + 8 * b5 + 16 * b6 + 32 * b7 + 64 * b8 + 128 * b9) +
    b1
}

///|
fn bit_10_2(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
  b9 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1 &&
  0 <= b9 &&
  b9 <= 1,
  proof_ensure: (
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9
  ) /
  4 %
  2 ==
  b2,
} {
  proof_assert 1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9 ==
    8 * (1 * b3 + 2 * b4 + 4 * b5 + 8 * b6 + 16 * b7 + 32 * b8 + 64 * b9) +
    4 * b2 +
    (1 * b0 + 2 * b1)
  proof_assert 1 * b0 + 2 * b1 < 4
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8 +
      512 * b9
    ) /
    4 ==
    2 * (1 * b3 + 2 * b4 + 4 * b5 + 8 * b6 + 16 * b7 + 32 * b8 + 64 * b9) + b2
}


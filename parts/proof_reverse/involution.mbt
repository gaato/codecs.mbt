    256 * b8 +
    512 * b9 +
    1024 * b10 +
    2048 * b11 +
    4096 * b12 ==
    128 * (1 * b7 + 2 * b8 + 4 * b9 + 8 * b10 + 16 * b11 + 32 * b12) +
    64 * b6 +
    (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5)
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 < 64
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8 +
      512 * b9 +
      1024 * b10 +
      2048 * b11 +
      4096 * b12
    ) /
    64 ==
    2 * (1 * b7 + 2 * b8 + 4 * b9 + 8 * b10 + 16 * b11 + 32 * b12) + b6
}


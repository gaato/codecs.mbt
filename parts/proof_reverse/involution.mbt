    512 * b9 +
    1024 * b10 <
    2048
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8 +
      512 * b9 +
      1024 * b10 +
      2048 * b11
    ) /
    2048 ==
    2 * 0 + b11
}

///|
fn of_bits_12(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
  b9 : Int32,
  b10 : Int32,
  b11 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1 &&
  0 <= b9 &&
  b9 <= 1 &&
  0 <= b10 &&
  b10 <= 1 &&
  0 <= b11 &&
  b11 <= 1,
  proof_ensure: @proof_codes.rev(
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9 +
    1024 * b10 +
    2048 * b11,
    12,
  ) ==
  2048 * b0 +
  1024 * b1 +
  512 * b2 +
  256 * b3 +
  128 * b4 +
  64 * b5 +
  32 * b6 +
  16 * b7 +
  8 * b8 +
  4 * b9 +
  2 * b10 +
  1 * b11,
} {
  bit_12_0(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11)
  bit_12_1(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11)
  bit_12_2(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11)
  bit_12_3(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11)
  bit_12_4(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11)
  bit_12_5(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11)
  bit_12_6(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11)
  bit_12_7(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11)
  bit_12_8(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11)
  bit_12_9(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11)
  bit_12_10(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11)
  bit_12_11(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11)
}

///|
fn involution_12(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 4096,
  proof_ensure: @proof_codes.rev(@proof_codes.rev(c, 12), 12) == c,
} {
  bits_12(c)
  proof_assert @proof_codes.rev(c, 12) ==
    1 * (c / 2048 % 2) +
    2 * (c / 1024 % 2) +
    4 * (c / 512 % 2) +
    8 * (c / 256 % 2) +
    16 * (c / 128 % 2) +
    32 * (c / 64 % 2) +
    64 * (c / 32 % 2) +
    128 * (c / 16 % 2) +
    256 * (c / 8 % 2) +
    512 * (c / 4 % 2) +
    1024 * (c / 2 % 2) +
    2048 * (c / 1 % 2)
  of_bits_12(
    c / 2048 % 2,
    c / 1024 % 2,
    c / 512 % 2,
    c / 256 % 2,
    c / 128 % 2,
    c / 64 % 2,
    c / 32 % 2,
    c / 16 % 2,
    c / 8 % 2,
    c / 4 % 2,
    c / 2 % 2,
    c / 1 % 2,
  )
}

///|
fn bits_13(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 8192,
  proof_ensure: c ==
  1 * (c / 1 % 2) +
  2 * (c / 2 % 2) +
  4 * (c / 4 % 2) +
  8 * (c / 8 % 2) +
  16 * (c / 16 % 2) +
  32 * (c / 32 % 2) +
  64 * (c / 64 % 2) +
  128 * (c / 128 % 2) +
  256 * (c / 256 % 2) +
  512 * (c / 512 % 2) +
  1024 * (c / 1024 % 2) +
  2048 * (c / 2048 % 2) +
  4096 * (c / 4096 % 2),
} {
  halve_0(c)
  halve_1(c)
  halve_2(c)
  halve_3(c)
  halve_4(c)
  halve_5(c)
  halve_6(c)
  halve_7(c)
  halve_8(c)
  halve_9(c)
  halve_10(c)
  halve_11(c)
  halve_12(c)
  proof_assert c / 8192 == 0
}


  proof_ensure: (
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6
  ) /
  16 %
  2 ==
  b4,
} {
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 ==
    32 * (1 * b5 + 2 * b6) + 16 * b4 + (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3)
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 < 16
  proof_assert (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6) /
    16 ==
    2 * (1 * b5 + 2 * b6) + b4
}

///|
fn bit_7_5(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&

  4 * (c / 4 % 2) +
  8 * (c / 8 % 2) +
  16 * (c / 16 % 2) +
  32 * (c / 32 % 2),
} {
  halve_0(c)
  halve_1(c)
  halve_2(c)
  halve_3(c)
  halve_4(c)
  halve_5(c)
  proof_assert c / 64 == 0
}

///|
fn bit_6_0(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1,
  proof_ensure: (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5) / 1 % 2 ==
  b0,
} {
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 ==
    2 * (1 * b1 + 2 * b2 + 4 * b3 + 8 * b4 + 16 * b5) + 1 * b0 + 0
  proof_assert (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5) / 1 ==
    2 * (1 * b1 + 2 * b2 + 4 * b3 + 8 * b4 + 16 * b5) + b0
}

///|
fn bit_6_1(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1,
  proof_ensure: (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5) / 2 % 2 ==
  b1,
} {
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 ==
    4 * (1 * b2 + 2 * b3 + 4 * b4 + 8 * b5) + 2 * b1 + 1 * b0
  proof_assert 1 * b0 < 2
  proof_assert (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5) / 2 ==
    2 * (1 * b2 + 2 * b3 + 4 * b4 + 8 * b5) + b1
}

///|
fn bit_6_2(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1,
  proof_ensure: (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5) / 4 % 2 ==
  b2,
} {
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 ==
    8 * (1 * b3 + 2 * b4 + 4 * b5) + 4 * b2 + (1 * b0 + 2 * b1)
  proof_assert 1 * b0 + 2 * b1 < 4
  proof_assert (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5) / 4 ==
    2 * (1 * b3 + 2 * b4 + 4 * b5) + b2
}

///|
fn bit_6_3(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1,
  proof_ensure: (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5) / 8 % 2 ==
  b3,
} {
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 ==
    16 * (1 * b4 + 2 * b5) + 8 * b3 + (1 * b0 + 2 * b1 + 4 * b2)
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 < 8
  proof_assert (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5) / 8 ==
    2 * (1 * b4 + 2 * b5) + b3
}

///|
fn bit_6_4(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1,
  proof_ensure: (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5) / 16 % 2 ==
  b4,
} {
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 ==
    32 * (1 * b5) + 16 * b4 + (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3)
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 < 16
  proof_assert (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5) / 16 ==
    2 * (1 * b5) + b4
}

///|
fn bit_6_5(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1,
  proof_ensure: (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5) / 32 % 2 ==
  b5,
} {
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 ==
    64 * 0 + 32 * b5 + (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4)
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 < 32
  proof_assert (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5) / 32 ==
    2 * 0 + b5
}

///|
fn of_bits_6(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1,
  proof_ensure: @proof_codes.rev(
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5,
    6,
  ) ==
  32 * b0 + 16 * b1 + 8 * b2 + 4 * b3 + 2 * b4 + 1 * b5,
} {
  bit_6_0(b0, b1, b2, b3, b4, b5)
  bit_6_1(b0, b1, b2, b3, b4, b5)
  bit_6_2(b0, b1, b2, b3, b4, b5)
  bit_6_3(b0, b1, b2, b3, b4, b5)
  bit_6_4(b0, b1, b2, b3, b4, b5)
  bit_6_5(b0, b1, b2, b3, b4, b5)
}

///|
fn involution_6(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 64,
  proof_ensure: @proof_codes.rev(@proof_codes.rev(c, 6), 6) == c,
} {
  bits_6(c)
  proof_assert @proof_codes.rev(c, 6) ==
    1 * (c / 32 % 2) +
    2 * (c / 16 % 2) +
    4 * (c / 8 % 2) +
    8 * (c / 4 % 2) +
    16 * (c / 2 % 2) +
    32 * (c / 1 % 2)
  of_bits_6(c / 32 % 2, c / 16 % 2, c / 8 % 2, c / 4 % 2, c / 2 % 2, c / 1 % 2)
}

///|
fn bits_7(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 128,
  proof_ensure: c ==
  1 * (c / 1 % 2) +
  2 * (c / 2 % 2) +
  4 * (c / 4 % 2) +
  8 * (c / 8 % 2) +
  16 * (c / 16 % 2) +
  32 * (c / 32 % 2) +
  64 * (c / 64 % 2),
} {
  halve_0(c)
  halve_1(c)
  halve_2(c)
  halve_3(c)
  halve_4(c)
  halve_5(c)
  halve_6(c)
  proof_assert c / 128 == 0
}

///|
fn bit_7_0(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1,
  proof_ensure: (
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6
  ) /
  1 %
  2 ==
  b0,
} {
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 ==
    2 * (1 * b1 + 2 * b2 + 4 * b3 + 8 * b4 + 16 * b5 + 32 * b6) + 1 * b0 + 0
  proof_assert (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6) /
    1 ==
    2 * (1 * b1 + 2 * b2 + 4 * b3 + 8 * b4 + 16 * b5 + 32 * b6) + b0
}

///|
fn bit_7_1(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1,
  proof_ensure: (
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6
  ) /
  2 %
  2 ==
  b1,
} {
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 ==
    4 * (1 * b2 + 2 * b3 + 4 * b4 + 8 * b5 + 16 * b6) + 2 * b1 + 1 * b0
  proof_assert 1 * b0 < 2
  proof_assert (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6) /
    2 ==
    2 * (1 * b2 + 2 * b3 + 4 * b4 + 8 * b5 + 16 * b6) + b1
}

///|
fn bit_7_2(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1,
  proof_ensure: (
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6
  ) /
  4 %
  2 ==
  b2,
} {
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 ==
    8 * (1 * b3 + 2 * b4 + 4 * b5 + 8 * b6) + 4 * b2 + (1 * b0 + 2 * b1)
  proof_assert 1 * b0 + 2 * b1 < 4
  proof_assert (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6) /
    4 ==
    2 * (1 * b3 + 2 * b4 + 4 * b5 + 8 * b6) + b2
}

///|
fn bit_7_3(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1,
  proof_ensure: (
    1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6
  ) /
  8 %
  2 ==
  b3,
} {
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6 ==
    16 * (1 * b4 + 2 * b5 + 4 * b6) + 8 * b3 + (1 * b0 + 2 * b1 + 4 * b2)
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 < 8
  proof_assert (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 + 16 * b4 + 32 * b5 + 64 * b6) /
    8 ==
    2 * (1 * b4 + 2 * b5 + 4 * b6) + b3
}

///|
fn bit_7_4(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&

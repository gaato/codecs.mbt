///|
fn of_bits_13(
  b0 : Int32,
  b1 : Int32,
  b2 : Int32,
  b3 : Int32,
  b4 : Int32,
  b5 : Int32,
  b6 : Int32,
  b7 : Int32,
  b8 : Int32,
  b9 : Int32,
  b10 : Int32,
  b11 : Int32,
  b12 : Int32,
) -> Unit where {
  proof_require: 0 <= b0 &&
  b0 <= 1 &&
  0 <= b1 &&
  b1 <= 1 &&
  0 <= b2 &&
  b2 <= 1 &&
  0 <= b3 &&
  b3 <= 1 &&
  0 <= b4 &&
  b4 <= 1 &&
  0 <= b5 &&
  b5 <= 1 &&
  0 <= b6 &&
  b6 <= 1 &&
  0 <= b7 &&
  b7 <= 1 &&
  0 <= b8 &&
  b8 <= 1 &&
  0 <= b9 &&
  b9 <= 1 &&
  0 <= b10 &&
  b10 <= 1 &&
  0 <= b11 &&
  b11 <= 1 &&
  0 <= b12 &&
  b12 <= 1,
  proof_ensure: @proof_codes.rev(
    1 * b0 +
    2 * b1 +
    4 * b2 +
    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9 +
    1024 * b10 +
    2048 * b11 +
    4096 * b12,
    13,
  ) ==
  4096 * b0 +
  2048 * b1 +
  1024 * b2 +
  512 * b3 +
  256 * b4 +
  128 * b5 +
  64 * b6 +
  32 * b7 +
  16 * b8 +
  8 * b9 +
  4 * b10 +
  2 * b11 +
  1 * b12,
} {
  bit_13_0(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12)
  bit_13_1(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12)
  bit_13_2(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12)
  bit_13_3(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12)
  bit_13_4(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12)
  bit_13_5(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12)
  bit_13_6(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12)
  bit_13_7(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12)
  bit_13_8(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12)
  bit_13_9(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12)
  bit_13_10(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12)
  bit_13_11(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12)
  bit_13_12(b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12)
}

///|
fn involution_13(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 8192,
  proof_ensure: @proof_codes.rev(@proof_codes.rev(c, 13), 13) == c,
} {
  bits_13(c)
  proof_assert @proof_codes.rev(c, 13) ==
    1 * (c / 4096 % 2) +
    2 * (c / 2048 % 2) +
    4 * (c / 1024 % 2) +
    8 * (c / 512 % 2) +
    16 * (c / 256 % 2) +
    32 * (c / 128 % 2) +
    64 * (c / 64 % 2) +
    128 * (c / 32 % 2) +
    256 * (c / 16 % 2) +
    512 * (c / 8 % 2) +
    1024 * (c / 4 % 2) +
    2048 * (c / 2 % 2) +
    4096 * (c / 1 % 2)
  of_bits_13(
    c / 4096 % 2,
    c / 2048 % 2,
    c / 1024 % 2,
    c / 512 % 2,
    c / 256 % 2,
    c / 128 % 2,
    c / 64 % 2,
    c / 32 % 2,
    c / 16 % 2,
    c / 8 % 2,
    c / 4 % 2,
    c / 2 % 2,
    c / 1 % 2,
  )
}

///|
fn bits_14(
  c : Int32,
) -> Unit where {
  proof_require: 0 <= c && c < 16384,
  proof_ensure: c ==
  1 * (c / 1 % 2) +
  2 * (c / 2 % 2) +
  4 * (c / 4 % 2) +
  8 * (c / 8 % 2) +
  16 * (c / 16 % 2) +
  32 * (c / 32 % 2) +
  64 * (c / 64 % 2) +
  128 * (c / 128 % 2) +
  256 * (c / 256 % 2) +
  512 * (c / 512 % 2) +
  1024 * (c / 1024 % 2) +
  2048 * (c / 2048 % 2) +
  4096 * (c / 4096 % 2) +
  8192 * (c / 8192 % 2),
} {
  halve_0(c)
  halve_1(c)
  halve_2(c)
  halve_3(c)
  halve_4(c)
  halve_5(c)
  halve_6(c)
  halve_7(c)
  halve_8(c)
  halve_9(c)
  halve_10(c)
  halve_11(c)
  halve_12(c)
  halve_13(c)
  proof_assert c / 16384 == 0
}


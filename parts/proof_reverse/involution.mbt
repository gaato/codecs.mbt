    8 * b3 +
    16 * b4 +
    32 * b5 +
    64 * b6 +
    128 * b7 +
    256 * b8 +
    512 * b9 +
    1024 * b10 ==
    32 * (1 * b5 + 2 * b6 + 4 * b7 + 8 * b8 + 16 * b9 + 32 * b10) +
    16 * b4 +
    (1 * b0 + 2 * b1 + 4 * b2 + 8 * b3)
  proof_assert 1 * b0 + 2 * b1 + 4 * b2 + 8 * b3 < 16
  proof_assert (
      1 * b0 +
      2 * b1 +
      4 * b2 +
      8 * b3 +
      16 * b4 +
      32 * b5 +
      64 * b6 +
      128 * b7 +
      256 * b8 +
      512 * b9 +
      1024 * b10
    ) /
    16 ==
    2 * (1 * b5 + 2 * b6 + 4 * b7 + 8 * b8 + 16 * b9 + 32 * b10) + b4
}

///|
fn bit_11_5(
  b0 : Int32,
  b1 : Int32,
